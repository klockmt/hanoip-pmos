# Copy to .env and fill in. .env stays out of git (personal data and local paths).
# The scripts in scripts/ and the commands in the docs use these variables.

# Where the scripts reach the device: 172.16.42.1 over the USB cable (the pmOS NCM gadget), or its Tailscale
# address (100.x.y.z) when the cable is out. The firewall accepts SSH only over USB and the tailnet.
HANOIP_HOST=172.16.42.1
# Login name: must be the same user you give to `pmbootstrap init`
HANOIP_USER=user
HANOIP_SSH_KEY=$HOME/.ssh/hanoip_ed25519
# Host network interface of the device USB gadget (empty = auto-detect; it only exists while the device is up)
HANOIP_USB_IFACE=

# Device data, always outside the repo (it holds serial, MAC, IMEI and proprietary firmware)
HANOIP_BACKUP_DIR=$HOME/Backups/hanoip-mainline/partitions
HANOIP_COLLECTION_DIR=$HOME/Backups/hanoip-mainline/coleta-g60/hanoip-kernel

# Local tools and source trees
PMBOOTSTRAP=$HOME/.local/share/pmbs-venv/bin/pmbootstrap
PMB_WORK=$HOME/.local/var/pmbootstrap
PMAPORTS_DIR=$HOME/.local/src/pmaports
KERNEL_DOWNSTREAM_DIR=$HOME/src/android_kernel_motorola_sm6150
KERNEL_MAINLINE_DIR=$HOME/src/linux-sm7150
UBOOT_DIR=$HOME/src/u-boot-sdm845-based
HANOIP_SRC_DIR=$HOME/.local/src
HANOIP_TEST_DIR=$HOME/.local/src/initramfs-test
# Linux 7.3 tree of scripts/build-mainline-kernel (empty: $HANOIP_SRC_DIR/hanoip-mainline-7.3)
HANOIP_MAINLINE_DIR=
# U-Boot tree of scripts/build-mainline-uboot (empty: $HANOIP_SRC_DIR/hanoip-uboot)
HANOIP_UBOOT_ML_DIR=

# Passwords of the phone accounts: sudo for the login user, and root. scripts/hanoip-sudo reads the first.
HANOIP_SUDO_PASSWORD=
HANOIP_ROOT_PASSWORD=

# The 8 battery cycle buckets the PMIC lost (scripts/restore-cycle-counts).
HANOIP_CYCLE_BUCKETS=
