# Device dumps and proprietary firmware: they contain serial/IMEI/MAC or blobs that cannot be published.
# Backups live outside the repo, in $HANOIP_BACKUP_DIR and $HANOIP_COLLECTION_DIR (see .env.example).
*.img
*.enc.z
pmsg-ramoops*
dmesg-ours.txt
/coleta*/
/collection*/
/hanoip-kernel/
/firmware/
/identidade/
/identity/
/particoes/
/partitions/
/device-tree/

# Local configuration (user, paths); the template is .env.example
.env
.env.*
!.env.example

# Secrets: bot token and owner id (the phone keeps them in /etc/hanoip/telegram.env)
telegram.env
*.token

# Proprietary firmware by extension, wherever it ends up: it comes from the phone itself (scripts/push-firmware)
*.mbn
*.mdt
*.b[0-9][0-9]
*.jsn
bdwlan*

# Checksum lists of backups, and downloaded archives
SHA256SUMS
*.tar.gz

# Working notes that are not part of the repository
/research_notes/
/reports/
