		qupv3_0: qcom,qupv3_0_geni_se@0x8c0000 {
			compatible = "qcom,qupv3-geni-se";
			reg = <0x8c0000 0x2000>;
			qcom,bus-mas-id = <0x97>;
			qcom,bus-slv-id = <0x200>;
			qcom,iommu-s1-bypass;
			phandle = <0x16b>;

			iommu_qupv3_0_geni_se_cb: qcom,iommu_qupv3_0_geni_se_cb {
				compatible = "qcom,qupv3-geni-se-cb";
				iommus = <0x30 0x203 0x00>;
				phandle = <0x2bc>;
			};
		};

		qupv3_se0_i2c: i2c@0x880000 {
			compatible = "qcom,i2c-geni";
			reg = <0x880000 0x4000>;
			interrupts = <0x00 0x259 0x00>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "se-clk", "m-ahb", "s-ahb";
			clocks = <0x27 0x44 0x27 0x67 0x27 0x68>;
			dmas = <0x168 0x00 0x00 0x03 0x40 0x00 0x168 0x01 0x00 0x03 0x40 0x00>;
			dma-names = "tx", "rx";
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <0x169>;
			pinctrl-1 = <0x16a>;
			qcom,wrapper-core = <0x16b>;
			status = "disabled";
			phandle = <0x2bd>;
		};

		qupv3_se1_i2c: i2c@0x884000 {
			compatible = "qcom,i2c-geni";
			reg = <0x884000 0x4000>;
			interrupts = <0x00 0x25a 0x00>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "se-clk", "m-ahb", "s-ahb";
			clocks = <0x27 0x46 0x27 0x67 0x27 0x68>;
			dmas = <0x168 0x00 0x01 0x03 0x40 0x00 0x168 0x01 0x01 0x03 0x40 0x00>;
			dma-names = "tx", "rx";
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <0x16c>;
			pinctrl-1 = <0x16d>;
			qcom,wrapper-core = <0x16b>;
			status = "disabled";
			phandle = <0x2be>;
		};

		qupv3_se2_i2c: i2c@0x888000 {
			compatible = "qcom,i2c-geni";
			reg = <0x888000 0x4000>;
			interrupts = <0x00 0x25b 0x00>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "se-clk", "m-ahb", "s-ahb";
			clocks = <0x27 0x48 0x27 0x67 0x27 0x68>;
			dmas = <0x168 0x00 0x02 0x03 0x40 0x00 0x168 0x01 0x02 0x03 0x40 0x00>;
			dma-names = "tx", "rx";
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <0x16e>;
			pinctrl-1 = <0x16f>;
			qcom,wrapper-core = <0x16b>;
			status = "ok";
			phandle = <0x2bf>;

			aw882xx_smartpa@34 {
				compatible = "awinic,aw882xx_smartpa";
				reg = <0x34>;
				reset-gpio = <0x177 0x2b 0x00>;
				irq-gpio = <0x177 0x5b 0x2008>;
				monitor-flag = <0x01>;
				monitor-timer-val = <0xbb8>;
				fade-flag = <0x01>;
				afe-rx-portid = <0x1002>;
				afe-tx-portid = <0x1003>;
				low-vol-table-down = <0xc80 0x09 0x09 0xd48 0x09 0x06 0xe10 0x09 0x03>;
				low-vol-table-up = <0xe74 0x09 0x00 0xdac 0x09 0x03 0xce4 0x09 0x06>;
				low-temp-table-down = <0xfffffffb 0x04 0x10 0xffbeae7e 0x00 0x05 0x09 0xffd80505 0x05 0x06 0x06 0xffed714d>;
				low-temp-table-up = <0x07 0x09 0x00 0x00 0x02 0x06 0x06 0xffed714d 0xffffffe 0x05 0x09 0xffd80505>;
				status = "okay";
				phandle = <0x495>;
			};

			nq@28 {
				compatible = "qcom,nq-nci";
				reg = <0x28>;
				qcom,nq-irq = <0x177 0x25 0x00>;
				qcom,nq-ven = <0x177 0x0c 0x00>;
				qcom,nq-firm = <0x177 0x24 0x00>;
				qcom,nq-clkreq = <0x177 0x1f 0x00>;
				qcom,nq-esepwr = <0x177 0x5e 0x00>;
