		usb0: ssusb@a600000 {
			compatible = "qcom,dwc-usb3-msm";
			reg = <0xa600000 0x100000>;
			reg-names = "core_base";
			iommus = <0x30 0x540 0x00>;
			qcom,smmu-s1-bypass;
			#address-cells = <0x01>;
