/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "hanoip";
	compatible = "qcom,sdmmagpie";
	qcom,msm-id = <0x16d 0x00>;
	qcom,msm-name = "SDMMAGPIE";
	interrupt-parent = <0x01>;
	qcom,board-id = <0x4c 0xb200>;
	channel-id-map = "acg", "amxbr", "amxpr", "amxmx", "amxcl", "amxar", "amxla", "amxpe", "amxco", "tefbr", "tefmx", "tefar", "tefcl", "tefpe", "tefco", "perar", "entcl", "iusmx", "niibr", "niicl", "niimx", "niipe", "oibr", "timbr", "tigco", "retbr", "retar", "retla", "retcl", "tefla", "retla1st", "tefunl", "tigca", "tigca1st", "retmx", "attmx", "womcl", "avaco", "retpe", "openla", "opencl", "openmx", "altmx", "openpe", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "reteu", "retgb", "retfr", "retes", "retie", "retde", "vfgb", "vfde", "vffr", "o2gb", "o2de", "orafr", "bouyfr", "eegb", "tescogb", "yoigo", "oraes", "retapac", "retmea", "vfit", "vfes", "vfeu", "3gb", "tescoie", "altfr", "3ie", "altpt", "timit", "retma", "windit", "vfhu", "vfro", "telhu", "playpl", "oraeu", "dteu", "teleu", "pluspl", "dtpl", "tefes", "altice", "vipeu", "veoneu", "openeu", "reteu2", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "retca", "bwaca", "tkpca", "vzw", "att", "tmo", "sprint", "repw", "attpre", "cricket", "cc", "usc", "tracfone", "retus", "metropcs", "rcica", "wndca", "dmc", "bby", "amz", "acg", "lra", "comcast", "fi", "vzwpre", "boost", "spectrum", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "retin", "retcn", "telstra", "vfau", "amzin", "jioin", "airin", "retid", "cmcc", "ctcn", "cucn", "retmm", "gt4gtw", "retth", "retru", "trueth", "smarthk", "mobilpk", "retsea", "retjp", "softbank", "optus", "retkr", "retjio", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined", "undefined";

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		CPU0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			sched-energy-costs = <0x02 0x03>;
			next-level-cache = <0x04>;
			qcom,lmh-dcvs = <0x05>;
			#cooling-cells = <0x02>;
			phandle = <0x11>;

			L2_0: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x04>;

				L3_0: l3-cache {
					compatible = "arm,arch-cache";
					cache-level = <0x03>;
					phandle = <0x06>;
				};
			};

			L1_I_0: l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x8800>;
				phandle = <0x35>;
			};

			L1_D_0: l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x9000>;
				phandle = <0x3d>;
			};

			L2_TLB_0: l2-tlb {
				qcom,dump-size = <0x5000>;
				phandle = <0x49>;
			};
		};

		CPU1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			sched-energy-costs = <0x02 0x03>;
			next-level-cache = <0x07>;
			qcom,lmh-dcvs = <0x05>;
			#cooling-cells = <0x02>;
			phandle = <0x12>;

			L2_100: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x07>;
			};

			L1_I_100: l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x8800>;
				phandle = <0x36>;
			};

			L1_D_100: l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x9000>;
				phandle = <0x3e>;
			};

			L2_TLB_100: l2-tlb {
				qcom,dump-size = <0x5000>;
				phandle = <0x4a>;
			};
		};

		CPU2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x200>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			sched-energy-costs = <0x02 0x03>;
			next-level-cache = <0x08>;
			qcom,lmh-dcvs = <0x05>;
			#cooling-cells = <0x02>;
			phandle = <0x13>;

			L2_200: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x08>;
			};

			L1_I_200: l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x8800>;
				phandle = <0x37>;
			};

			L1_D_200: l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x9000>;
				phandle = <0x3f>;
			};

			L2_TLB_200: l2-tlb {
				qcom,dump-size = <0x5000>;
				phandle = <0x4b>;
			};
		};

		CPU3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x300>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			sched-energy-costs = <0x02 0x03>;
			next-level-cache = <0x09>;
			qcom,lmh-dcvs = <0x05>;
			#cooling-cells = <0x02>;
			phandle = <0x14>;

			L2_300: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x09>;
			};

			L1_I_300: l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x8800>;
				phandle = <0x38>;
			};

			L1_D_300: l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x9000>;
				phandle = <0x40>;
			};

			L2_TLB_300: l2-tlb {
				qcom,dump-size = <0x5000>;
				phandle = <0x4c>;
			};
		};

		CPU4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x400>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			sched-energy-costs = <0x02 0x03>;
			next-level-cache = <0x0a>;
			qcom,lmh-dcvs = <0x05>;
			#cooling-cells = <0x02>;
			phandle = <0x15>;

			L2_400: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x0a>;
			};

			L1_I_400: l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x8800>;
				phandle = <0x39>;
			};

			L1_D_400: l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x9000>;
				phandle = <0x41>;
			};

			L2_TLB_400: l2-tlb {
				qcom,dump-size = <0x5000>;
				phandle = <0x4d>;
			};
		};

		CPU5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x500>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			sched-energy-costs = <0x02 0x03>;
			next-level-cache = <0x0b>;
			qcom,lmh-dcvs = <0x05>;
			#cooling-cells = <0x02>;
			phandle = <0x16>;

			L2_500: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x0b>;
			};

			L1_I_500: l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x8800>;
				phandle = <0x3a>;
			};

			L1_D_500: l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x9000>;
				phandle = <0x42>;
			};

			L2_TLB_500: l2-tlb {
				qcom,dump-size = <0x5000>;
				phandle = <0x4e>;
			};
		};

		CPU6: cpu@600 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x600>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x6cc>;
			sched-energy-costs = <0x0c 0x0d>;
			next-level-cache = <0x0e>;
			qcom,lmh-dcvs = <0x0f>;
			#cooling-cells = <0x02>;
			phandle = <0x17>;

			L2_600: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				qcom,dump-size = <0x48000>;
				phandle = <0x0e>;
			};

			L1_I_600: l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x11000>;
				phandle = <0x3b>;
			};

			L1_D_600: l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x12000>;
				phandle = <0x43>;
			};

			L1_ITLB_600: l1-itlb {
				qcom,dump-size = <0x300>;
				phandle = <0x45>;
			};

			L1_DTLB_600: l1-dtlb {
				qcom,dump-size = <0x480>;
				phandle = <0x47>;
			};

			L2_TLB_600: l2-tlb {
				qcom,dump-size = <0x7800>;
				phandle = <0x4f>;
			};
		};

		CPU7: cpu@700 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x700>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x6cc>;
			sched-energy-costs = <0x0c 0x0d>;
			next-level-cache = <0x10>;
			qcom,lmh-dcvs = <0x0f>;
			#cooling-cells = <0x02>;
			phandle = <0x18>;

			L2_700: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				qcom,dump-size = <0x48000>;
				phandle = <0x10>;
			};

			L1_I_700: l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x11000>;
				phandle = <0x3c>;
			};

			L1_D_700: l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x12000>;
				phandle = <0x44>;
			};

			L1_ITLB_700: l1-itlb {
				qcom,dump-size = <0x300>;
				phandle = <0x46>;
			};

			L1_DTLB_700: l1-dtlb {
				qcom,dump-size = <0x480>;
				phandle = <0x48>;
			};

			L2_TLB_700: l2-tlb {
				qcom,dump-size = <0x7800>;
				phandle = <0x50>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x11>;
				};

				core1 {
					cpu = <0x12>;
				};

				core2 {
					cpu = <0x13>;
				};

				core3 {
					cpu = <0x14>;
				};

				core4 {
					cpu = <0x15>;
				};

				core5 {
					cpu = <0x16>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x17>;
				};

				core1 {
					cpu = <0x18>;
				};
			};
		};
	};

	soc: soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";
		phandle = <0x222>;

		jtag_mm0: jtagmm@7040000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x7040000 0x1000>;
			reg-names = "etm-base";
			clocks = <0x19 0x00>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <0x11>;
			status = "disabled";
			phandle = <0x223>;
		};

		jtag_mm1: jtagmm@7140000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x7140000 0x1000>;
			reg-names = "etm-base";
			clocks = <0x19 0x00>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <0x12>;
			status = "disabled";
			phandle = <0x224>;
		};

		jtag_mm2: jtagmm@7240000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x7240000 0x1000>;
			reg-names = "etm-base";
			clocks = <0x19 0x00>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <0x13>;
			status = "disabled";
			phandle = <0x225>;
		};

		jtag_mm3: jtagmm@7340000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x7340000 0x1000>;
			reg-names = "etm-base";
			clocks = <0x19 0x00>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <0x14>;
			status = "disabled";
			phandle = <0x226>;
		};

		jtag_mm4: jtagmm@7440000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x7440000 0x1000>;
			reg-names = "etm-base";
			clocks = <0x19 0x00>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <0x15>;
			status = "disabled";
			phandle = <0x227>;
		};

		jtag_mm5: jtagmm@7540000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x7540000 0x1000>;
			reg-names = "etm-base";
			clocks = <0x19 0x00>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <0x16>;
			status = "disabled";
			phandle = <0x228>;
		};

		jtag_mm6: jtagmm@7640000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x7640000 0x1000>;
			reg-names = "etm-base";
			clocks = <0x19 0x00>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <0x17>;
			status = "disabled";
			phandle = <0x229>;
		};

		jtag_mm7: jtagmm@7740000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x7740000 0x1000>;
			reg-names = "etm-base";
			clocks = <0x19 0x00>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <0x18>;
			status = "disabled";
			phandle = <0x22a>;
		};

		intc: interrupt-controller@17a00000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <0x03>;
			interrupt-controller;
			#redistributor-regions = <0x01>;
			redistributor-stride = <0x00 0x20000>;
			reg = <0x17a00000 0x10000 0x17a60000 0x100000>;
			interrupts = <0x01 0x09 0x04>;
			interrupt-parent = <0x1a>;
			phandle = <0x1a>;
		};

		pdc: interrupt-controller@b220000 {
			compatible = "qcom,pdc-sdmmagpie";
			reg = <0xb220000 0x400>;
			#interrupt-cells = <0x03>;
			interrupt-parent = <0x1a>;
			interrupt-controller;
			phandle = <0x01>;
		};

		qcom,memshare {
			compatible = "qcom,memshare";

			qcom,client_1 {
				compatible = "qcom,memshare-peripheral";
				qcom,peripheral-size = <0x00>;
				qcom,client-id = <0x00>;
				qcom,allocate-boot-time;
				label = "modem";
			};

			qcom,client_2 {
				compatible = "qcom,memshare-peripheral";
				qcom,peripheral-size = <0x00>;
				qcom,client-id = <0x02>;
				label = "modem";
			};

			mem_client_3_size: qcom,client_3 {
				compatible = "qcom,memshare-peripheral";
				qcom,peripheral-size = <0x500000>;
				qcom,client-id = <0x01>;
				qcom,allocate-on-request;
				label = "modem";
				phandle = <0x22b>;
			};
		};

		timer {
			compatible = "arm,armv8-timer";
			interrupts = <0x01 0x01 0xf08 0x01 0x02 0xf08 0x01 0x03 0xf08 0x01 0x00 0xf08>;
			clock-frequency = <0x124f800>;
		};

		timer@0x17c20000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;
			compatible = "arm,armv7-timer-mem";
			reg = <0x17c20000 0x1000>;
			clock-frequency = <0x124f800>;

			frame@0x17c21000 {
				frame-number = <0x00>;
				interrupts = <0x00 0x08 0x04 0x00 0x06 0x04>;
				reg = <0x17c21000 0x1000 0x17c22000 0x1000>;
			};

			frame@17c23000 {
				frame-number = <0x01>;
				interrupts = <0x00 0x09 0x04>;
				reg = <0x17c23000 0x1000>;
				status = "disabled";
			};

			frame@17c25000 {
				frame-number = <0x02>;
				interrupts = <0x00 0x0a 0x04>;
				reg = <0x17c25000 0x1000>;
				status = "disabled";
			};

			frame@17c27000 {
				frame-number = <0x03>;
				interrupts = <0x00 0x0b 0x04>;
				reg = <0x17c27000 0x1000>;
				status = "disabled";
			};

			frame@17c29000 {
				frame-number = <0x04>;
				interrupts = <0x00 0x0c 0x04>;
				reg = <0x17c29000 0x1000>;
				status = "disabled";
			};

			frame@17c2b000 {
				frame-number = <0x05>;
				interrupts = <0x00 0x0d 0x04>;
				reg = <0x17c2b000 0x1000>;
				status = "disabled";
			};

			frame@17c2d000 {
				frame-number = <0x06>;
				interrupts = <0x00 0x0e 0x04>;
				reg = <0x17c2d000 0x1000>;
				status = "disabled";
			};
		};

		clocks {

			sleep_clk: sleep-clk {
				compatible = "fixed-clock";
				clock-frequency = <0x7d00>;
				clock-output-names = "chip_sleep_clk";
				#clock-cells = <0x01>;
				phandle = <0x22c>;
			};
		};

		clock_rpmh: qcom,rpmh {
			compatible = "qcom,rpmh-clk-sdmmagpie";
			mboxes = <0x1b 0x00>;
			mbox-names = "apps";
			#clock-cells = <0x01>;
			phandle = <0x2f>;
		};

		clock_aop: qcom,aopclk {
			compatible = "qcom,aop-qmp-clk";
			#clock-cells = <0x01>;
			mboxes = <0x1c 0x00>;
			mbox-names = "qdss_clk";
			phandle = <0x19>;
		};

		clock_gcc: qcom,gcc@100000 {
			compatible = "qcom,gcc-sdmmagpie", "syscon";
			vdd_cx-supply = <0x1d>;
			vdd_cx_ao-supply = <0x1e>;
			reg = <0x100000 0x1f0000>;
			reg-names = "cc_base";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x27>;
		};

		clock_camcc: qcom,camcc {
			compatible = "qcom,camcc-sdmmagpie", "syscon";
			vdd_cx-supply = <0x1d>;
			vdd_mx-supply = <0x1f>;
			reg = <0xad00000 0x10000>;
			reg-names = "cc_base";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x29>;
		};

		clock_gpucc: qcom,gpucc {
			compatible = "qcom,gpucc-sdmmagpie", "syscon";
			reg = <0x5090000 0x9000>;
			reg-names = "cc_base";
			vdd_cx-supply = <0x1d>;
