		thermal_zones: thermal-zones {
			phandle = <0x237>;

			pm6150_temp_alarm: pm6150-tz {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x53>;
				wake-capable-sensor;
				phandle = <0x238>;

				trips {

					pm6150_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x239>;
					};

					pm6150_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x23a>;
