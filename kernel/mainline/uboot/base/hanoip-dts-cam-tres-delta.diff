+++ b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa1.dts
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ÁUDIO — ETAPA 1: codec WCD9370 + links de playback e captura.
+ *
+ * Base: etapa 0 (SoundWire ligado). Descoberta da etapa 0: o codec ENUMERA sem
+ * reset (sdw:2:...:4 e sdw:3:...:3), então o reset real (LPI GPIO24, que o
+ * pinctrl mainline não expõe) NÃO é necessário para o codec viver.
+ *
+ * ATENÇÃO — RESET FICTÍCIO: o driver exige reset-gpios (devm_gpiod_get não
+ * opcional). Aqui apontamos para o TLMM GPIO100, que o DT do hanoip não usa,
+ * só para satisfazer o driver. O pino real do codec segue como o bootloader
+ * deixou (fora de reset). Quando o pinctrl LPI for estendido (14->32), trocar
+ * por <&lpass_tlmm 24 GPIO_ACTIVE_LOW> e revalidar.
+ *
+ * Tensões: L10A (vdd-rxtx e vdd-px), L15A (vdd-buck), BOB (mic-bias), todas
+ * 1,8 V e micbias 2,8 V como no stock. Nada foi inventado.
+ *
+ * Links: "WCD Playback" em RX_CODEC_DMA_RX_0 (earpiece/fone) e "WCD Capture"
+ * em TX_CODEC_DMA_TX_3, padrão do sm8250-mtp (mesmo modelo q6afe) adaptado aos
+ * masters separados do sm7150.
+ */
+#include <dt-bindings/gpio/gpio.h>
+#include "sm7150-motorola-hanoip-audio-etapa0.dts"
+
+/ {
+	wcd9370: audio-codec-0 {
+		compatible = "qcom,wcd9370-codec";
+
+		/* reset fictício: ver comentário do topo */
+		reset-gpios = <&tlmm 100 GPIO_ACTIVE_LOW>;
+
+		vdd-buck-supply = <&vreg_l15a_1p8>;
+		vdd-rxtx-supply = <&vreg_l10a_1p8>;
+		vdd-px-supply = <&vreg_l10a_1p8>;
+		vdd-mic-bias-supply = <&vreg_bob>;
+
+		qcom,micbias1-microvolt = <2800000>;
+		qcom,micbias2-microvolt = <2800000>;
+		qcom,micbias3-microvolt = <2800000>;
+
+		qcom,rx-device = <&wcd937x_rx>;
+		qcom,tx-device = <&wcd937x_tx>;
+
+		#sound-dai-cells = <1>;
+	};
+};
+
+&{/sound} {
+	wcd_playback_dai_link: wcd-playback-dai-link {
+		link-name = "WCD Playback";
+
+		cpu {
+			sound-dai = <&q6afedai RX_CODEC_DMA_RX_0>;
+		};
+
+		platform {
+			sound-dai = <&q6routing>;
+		};
+
+		codec {
+			sound-dai = <&wcd9370 0>, <&swr_rx 0>, <&rxmacro 0>;
+		};
+	};
+
+	wcd_capture_dai_link: wcd-capture-dai-link {
+		link-name = "WCD Capture";
+
+		cpu {
+			sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
+		};
+
+		platform {
+			sound-dai = <&q6routing>;
+		};
+
+		codec {
+			sound-dai = <&wcd9370 1>, <&swr_tx 0>, <&txmacro 0>;
+		};
+	};
+};
diff --git a/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa10.dts b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa10.dts
new file mode 100644
index 00000000..9e462012
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa10.dts
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ÁUDIO — ETAPA 10: clock CORRETO do macro RX.
+ *
+ * O sm7150.dtsi declara o rxmacro com os clocks do TX:
+ *     clocks = <&q6afecc LPASS_CLK_ID_TX_CORE_MCLK ...>,
+ *              <&q6afecc LPASS_CLK_ID_TX_CORE_NPL_MCLK ...>, ...
+ * (idêntico ao txmacro — copiar/colar). O clock do macro RX é
+ * LPASS_CLK_ID_RX_CORE_MCLK (59) / LPASS_CLK_ID_RX_CORE_NPL_MCLK (60); o vendor
+ * usa "rx_core_clk"/"rx_npl_clk" nesse macro.
+ *
+ * Consequência esperada: sem o MCLK do RX, o master SoundWire RX sobe (as
+ * chamadas retornam sucesso) mas o clock de áudio não existe, e o stream morre
+ * logo depois de começar — exatamente o EIO de ~0,5 s medido.
+ *
+ * Base: etapa9 (audio-routing). Só muda o clock do rxmacro.
+ */
+#include "sm7150-motorola-hanoip-audio-etapa9.dts"
+
+&rxmacro {
+	clocks = <&q6afecc LPASS_CLK_ID_RX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&q6afecc LPASS_CLK_ID_RX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&q6afecc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&vamacro>;
+};
diff --git a/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa11.dts b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa11.dts
new file mode 100644
index 00000000..d55fb7be
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa11.dts
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ÁUDIO — ETAPA 11: voto de energia do DCODEC (o que o driver pula).
+ *
+ * Mecanismo (ver seção 15 do checkpoint): lpass_macro_pds_init() retorna NULL
+ * quando o nó não tem power-domains, então os votos "macro" e "dcodec" nunca
+ * vão ao ADSP. O firmware do ADSP tem exatamente LPASS_CORE_HW_MACRO_BLOCK e
+ * LPASS_CORE_HW_DCODEC_BLOCK, e o clk_summary mostra LPASS_HW_DCODEC com
+ * enable=0.
+ *
+ * Esta variante declara o clock "dcodec" nos dois macros (o driver já faz
+ * devm_clk_get_optional(dev, "dcodec")), e o kernel desta rodada foi patchado
+ * para habilitá-lo (clk_prepare_enable) no probe. Base: etapa10.
+ */
+#include "sm7150-motorola-hanoip-audio-etapa10.dts"
+
+&rxmacro {
+	clocks = <&q6afecc LPASS_CLK_ID_RX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&q6afecc LPASS_CLK_ID_RX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&q6afecc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&vamacro>;
+	clock-names = "mclk", "npl", "macro", "dcodec", "fsgen";
+};
+
+&txmacro {
+	clocks = <&q6afecc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&q6afecc LPASS_CLK_ID_TX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&q6afecc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&vamacro>;
+	clock-names = "mclk", "npl", "macro", "dcodec", "fsgen";
+};
diff --git a/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa12.dts b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa12.dts
new file mode 100644
index 00000000..ee02def4
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa12.dts
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ÁUDIO — ETAPA 12: card completo (alto-falante + earpiece + fone + mics).
+ *
+ * Reavaliação de 28/10 (docs/kernel/REAVALIACAO-AUDIO-20261028.md): o EIO das
+ * etapas 5..11 NÃO era o DSP nem o voto DCODEC. Medido em runtime na etapa 10:
+ *   - com 'RX_MACRO RX0 MUX'=AIF1_PB (+ INT0 MIX/DEM) o aplay roda (rc=0);
+ *     com o mux em ZERO dá EIO — o AIF do macro não liga no DAPM e a
+ *     interface CODEC_DMA não é habilitada;
+ *   - idem na captura com 'TX DEC0 MUX'=SWR_MIC;
+ *   - rotear o MESMO FE (MultiMedia1) nos dois sentidos corrompe a sessão do
+ *     q6routing (um port_id por sessão) -> ADM_CMD_DEVICE_OPEN_V5 EBADPARAM.
+ *
+ * Base: etapa5 (reset do WCD937x em <&lpass_tlmm 6>, link do alto-falante
+ * preservado). Mudanças:
+ *   1. clock do rxmacro com os ids de RX (bug do sm7150.dtsi, ver etapa10);
+ *   2. audio-routing = o do stock/upstream, ligando macro <-> codec
+ *      (IN1_HPHL<-HPHL_OUT ... TX SWR_ADC2<-ADC2_OUTPUT). Substitui as rotas
+ *      "WCD AIF Playback" da etapa9, que deixavam o codec sempre ligado;
+ *   3. FE MultiMedia2 só de captura (as sessões ASM/ADM ficam separadas);
+ *   4. MultiMedia1 só de playback.
+ */
+#include "sm7150-motorola-hanoip-audio-etapa5.dts"
+
+&rxmacro {
+	clocks = <&q6afecc LPASS_CLK_ID_RX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&q6afecc LPASS_CLK_ID_RX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&q6afecc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&vamacro>;
+};
+
+&q6asmdai {
+	dai@0 {
+		direction = <Q6ASM_DAI_RX>;
+	};
+
+	dai@1 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>;
+		direction = <Q6ASM_DAI_TX>;
+	};
+};
+
+&{/sound} {
+	/* stock qcom,audio-routing (sem os widgets de máquina "Analog Mic") */
+	audio-routing =
+		"AMIC1", "MIC BIAS1",
+		"AMIC2", "MIC BIAS2",
+		"AMIC3", "MIC BIAS3",
+		"IN1_HPHL", "HPHL_OUT",
+		"IN2_HPHR", "HPHR_OUT",
+		"IN3_AUX", "AUX_OUT",
+		"TX SWR_ADC0", "ADC1_OUTPUT",
+		"TX SWR_ADC2", "ADC2_OUTPUT";
+
+	mm2-dai-link {
+		link-name = "MultiMedia2";
+
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
+		};
+	};
+};
diff --git a/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa13.dts b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa13.dts
new file mode 100644
index 00000000..a78ccfcb
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa13.dts
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ÁUDIO — ETAPA 13: etapa12 + estabilidade do SoundWire RX + limiares de MBHC.
+ *
+ * 1. &swr_rx: qcom,clock-stop-not-supported (precisa do patch
+ *    "soundwire: qcom: allow DT to opt out of clock stop"). Medido na etapa12:
+ *    com runtime PM em auto, 6 de 8 ciclos "autosuspend -> play" falham
+ *    (link failed to connect, escravo RX UNATTACHED, DPN_PortCtrl -5): o
+ *    master RX perde o contexto quando o rx-macro desliga o MCLK, e o resume
+ *    rápido de clock-stop não reinicializa. Com a propriedade, o resume faz
+ *    reset + init + re-enumeração.
+ * 2. &wcd9370: limiares de MBHC do stock (qcom,msm-mbhc-hs-mic-max/min
+ *    -threshold-mv = 2700/116) no lugar dos defaults do driver (1700/50).
+ */
+#include "sm7150-motorola-hanoip-audio-etapa12.dts"
+
+&swr_rx {
+	qcom,clock-stop-not-supported;
+};
+
+&wcd9370 {
+	qcom,mbhc-headset-vthreshold-microvolt = <2700000>;
+	qcom,mbhc-headphone-vthreshold-microvolt = <116000>;
+};
diff --git a/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa14.dts b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa14.dts
new file mode 100644
index 00000000..3b344abc
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa14.dts
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ÁUDIO — ETAPA 14: etapa13 + IRQ de wake do SoundWire TX.
+ *
+ * O MBHC (detecção do fone) avisa por interrupção do escravo TX. Com o
+ * master TX em runtime suspend (clock stop), ela só chega pela IRQ de wake.
+ * Medido na etapa13: com o master TX suspenso, plugar o fone gera 0
+ * interrupções; com ele forçado acordado, "Headphone Jack"/"Mic Jack" = on.
+ * O stock declara no tx_swr_master:
+ *     interrupts = <0 0x128 0>, <0 0x1f4 0>;  (swr_master_irq, swr_wake_irq)
+ * O qcom-soundwire do mainline pega a segunda IRQ (índice 1) como wake.
+ */
+#include "sm7150-motorola-hanoip-audio-etapa13.dts"
+
+&swr_tx {
+	interrupts = <GIC_SPI 296 IRQ_TYPE_LEVEL_HIGH>,
+		     <GIC_SPI 500 IRQ_TYPE_LEVEL_HIGH>;
+	interrupt-names = "core", "wakeup";
+};
diff --git a/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa2.dts b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa2.dts
new file mode 100644
index 00000000..1c01f6ef
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa2.dts
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ÁUDIO — ETAPA 2: reset REAL do codec (LPI GPIO24) + pinctrl estendido.
+ *
+ * Contexto medido:
+ *   - etapa 0: o codec enumera (sdw:2/3) sem reset, mas fica UNATTACHED
+ *   - etapa 1: com MFD e reset fictício, o probe estoura -110 na
+ *     "Initialization not complete" — o attach do SoundWire só acontece depois
+ *     de um reset de verdade (as IRQs do master marcavam 0 disparos)
+ *   - para usar o LPI GPIO24 foi preciso estender o pinctrl sm7150-lpass-lpi
+ *     de 14 para 32 pinos (o stock declara qcom,num-gpios = <0x20>).
+ *
+ * Esta variante depende de um KERNEL NOVO (pinctrl com 32 pinos). A U-Boot
+ * sozinha não basta.
+ *
+ * Reset: LPI GPIO24, ativo em nível baixo (stock: func2 / output-high quando
+ * ativo, output-low no sleep). Estado de pino "gpio" (índice 0 no driver) —
+ * se o attach não acontecer, o próximo teste é mux explícito.
+ */
+#include <dt-bindings/gpio/gpio.h>
+#include "sm7150-motorola-hanoip-audio-etapa1.dts"
+
+&lpass_tlmm {
+	/* o hardware tem 32 pinos; o dtsi antigo declarava 14 */
+	gpio-ranges = <&lpass_tlmm 0 0 32>;
+
+	wcd_reset_active: wcd-reset-active-state {
+		pins = "gpio24";
+		function = "gpio";
+		drive-strength = <16>;
+	};
+};
+
+&wcd9370 {
+	reset-gpios = <&lpass_tlmm 24 GPIO_ACTIVE_LOW>;
+	pinctrl-0 = <&wcd_reset_active>;
+	pinctrl-names = "default";
+
+	qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000
+						  500000 500000 500000 500000>;
+};
diff --git a/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa3.dts b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa3.dts
new file mode 100644
index 00000000..1cb2e84c
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa3.dts
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ÁUDIO — ETAPA 3: corrige o tamanho do mapeamento do pinctrl LPI.
+ *
+ * Causa do Oops da etapa 2 (medida no dmesg):
+ *   lpi_gpio_read -> lpi_gpio_get_direction -> gpiochip_add_data
+ *   "Unable to handle kernel paging request at virtual address ..."
+ * O dtsi declara reg = <0 0x62b52000 0 0xe000> — 14 páginas, uma por pino dos
+ * 14 que o driver antigo conhecia. O pino 24 fica no offset 0x18000 e o driver
+ * faz ioremap exatamente do tamanho do reg, então a leitura cai fora do
+ * mapeamento.
+ *
+ * O stock declara qcom,num-gpios = <0x20> e qcom,lpi-offset-tbl com
+ * 0x0, 0x1000, ..., 0x1f000 — ou seja, 32 pinos e 0x20000 de janela.
+ * Aqui só estendemos a janela: o kernel novo (pinctrl com 32 pinos e nomes)
+ * já conhece os pinos.
+ */
+#include "sm7150-motorola-hanoip-audio-etapa2.dts"
+
+&lpass_tlmm {
+	reg = <0 0x62b52000 0 0x20000>;
+};
diff --git a/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa4.dts b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa4.dts
new file mode 100644
index 00000000..882103e5
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa4.dts
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ÁUDIO — ETAPA 4: reset do codec pelo MUX 2 do LPASS (o que o Android faz).
+ *
+ * Base do achado (fonte do vendor, pinctrl-slpi.c):
+ *   - o driver SLPI escreve o INDICE da funcao no campo mux do pino
+ *   - o enum do vendor e' GPIO=0, func1=1, func2=2, ...
+ *   - no stock do hanoip, o pino 24 (reset do WCD) e' muxado em "func2" (=2)
+ *     com output-high, e "func2" NAO e' o modo GPIO.
+ * Conclusao: no Android o reset do codec nao e' um GPIO comum; ele e' roteado
+ * por uma funcao alternativa do LPASS. Nas etapas 0..3 deixamos o pino em
+ * "gpio" (mux 0), entao o codec nunca saia de reset e ficava UNATTACHED.
+ *
+ * O kernel desta variante tem, no driver sm7150-lpass-lpi, uma funcao
+ * "wcd_rst" posicionada no INDICE 2 do pino 24 (mesmo truque que o mainline ja
+ * usa nos pinos 1 e 5 para casar o valor de mux do vendor).
+ *
+ * janela de registradores: 0x20000 (32 pinos), como na etapa 3.
+ */
+#include "sm7150-motorola-hanoip-audio-etapa1.dts"
+
+&lpass_tlmm {
+	reg = <0 0x62b52000 0 0x20000>;
+	gpio-ranges = <&lpass_tlmm 0 0 32>;
+
+	wcd_reset_active: wcd-reset-active-state {
+		pins = "gpio24";
+		function = "wcd_rst";
+		drive-strength = <16>;
+	};
+};
+
+&wcd9370 {
+	reset-gpios = <&lpass_tlmm 24 GPIO_ACTIVE_LOW>;
+	pinctrl-0 = <&wcd_reset_active>;
+	pinctrl-names = "default";
+
+	qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000
+						  500000 500000 500000 500000>;
+};
diff --git a/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa5.dts b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa5.dts
new file mode 100644
index 00000000..8e340493
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa5.dts
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ÁUDIO — ETAPA 5: reset do codec no LPI pino 6 (o pino certo).
+ *
+ * Por que mudou (investigação do vendor + outros ports):
+ *   - no stock do hanoip o pinctrl LPI tem 32 gpios num único nó, com offsets
+ *     lineares; o dtsi do mainline mapeia só 0x62b52000 + 0xe000 (14 pinos) e
+ *     anota que 0x62b40000 + 0x12000 (18 páginas) é o espaço do SSC.
+ *     Portanto: gpio0..17 do vendor = bloco SSC; gpio18..31 = bloco AP, e o
+ *     pino AP n corresponde ao vendor gpio (n + 18).
+ *   - o stock usa "msm_cdc_pinctrl@24" = vendor gpio24 = AP pino 6.
+ *   - o port do MESMO SoC (sm7150-xiaomi-sweet.dts) usa exatamente
+ *     reset-gpios = <&lpass_tlmm 6 GPIO_ACTIVE_LOW>.
+ * Conclusão: o pino já existe no driver mainline (0..13). Não precisa estender
+ * pinctrl, não precisa mux 2 (que causou RCU stall) e NÃO precisa kernel novo.
+ *
+ * Esta variante roda com o kernel do PRE-GOLD.
+ */
+#include "sm7150-motorola-hanoip-audio-etapa1.dts"
+
+&lpass_tlmm {
+	wcd_reset_active: wcd-reset-active-state {
+		pins = "gpio6";
+		function = "gpio";
+		drive-strength = <16>;
+	};
+};
+
+&wcd9370 {
+	reset-gpios = <&lpass_tlmm 6 GPIO_ACTIVE_LOW>;
+	pinctrl-0 = <&wcd_reset_active>;
+	pinctrl-names = "default";
+
+	qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000
+						  500000 500000 500000 500000>;
+};
diff --git a/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa6.dts b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa6.dts
new file mode 100644
index 00000000..1e711b1f
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa6.dts
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ÁUDIO — ETAPA 6: arrays de portas do SoundWire com 6 entradas (tamanho real).
+ *
+ * Evidência (dmesg do etapa5):
+ *   qcom-soundwire 62ed0000: din-ports (5) mismatch with controller (6)
+ *   qcom-soundwire 62ef0000: dout-ports (5) mismatch with controller (6)
+ * O dtsi upstream declara 5 portas; o hardware do hanoip reporta 6. O codec usa
+ * as portas 1..5 (qcom,rx-port-mapping = <1 2 3 4 5> / tx <2 3 4 5>), e com
+ * arrays de 5 entradas a porta 5 fica sem configuração — o que explica o
+ * stream morrer (EIO) mesmo com hw_params retornando 0 em todos os DAIs.
+ *
+ * Aqui só estendemos os arrays para 6 entradas e casamos din/dout com o
+ * hardware. Nada mais muda em relação à etapa5 (reset no LPI pino 6).
+ */
+#include "sm7150-motorola-hanoip-audio-etapa5.dts"
+
+&swr_tx {
+	qcom,din-ports = <6>;
+	qcom,dout-ports = <1>;
+	qcom,ports-sinterval-low =	/bits/ 8 <0x01 0x03 0x03 0x03 0x03 0x03>;
+	qcom,ports-offset1 =		/bits/ 8 <0x00 0x00 0x00 0x00 0x00 0x00>;
+	qcom,ports-offset2 =		/bits/ 8 <0x00 0x00 0x00 0x00 0x00 0x00>;
+	qcom,ports-hstart =		/bits/ 8 <0xff 0xff 0xff 0xff 0xff 0xff>;
+	qcom,ports-hstop =		/bits/ 8 <0xff 0xff 0xff 0xff 0xff 0xff>;
+	qcom,ports-word-length =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff 0xff>;
+	qcom,ports-block-pack-mode =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff 0xff>;
+	qcom,ports-block-group-count =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff 0xff>;
+	qcom,ports-lane-control =	/bits/ 8 <0x01 0x01 0x01 0x01 0x01 0x01>;
+};
+
+&swr_rx {
+	qcom,din-ports = <1>;
+	qcom,dout-ports = <6>;
+	qcom,ports-sinterval-low =	/bits/ 8 <0x03 0x3f 0x1f 0x03 0x03 0x03>;
+	qcom,ports-offset1 =		/bits/ 8 <0x00 0x00 0x0b 0x01 0x01 0x01>;
+	qcom,ports-offset2 =		/bits/ 8 <0x00 0x00 0x0b 0x00 0x00 0x00>;
+	qcom,ports-hstart =		/bits/ 8 <0xff 0x03 0xff 0xff 0xff 0xff>;
+	qcom,ports-hstop =		/bits/ 8 <0xff 0x06 0xff 0xff 0xff 0xff>;
+	qcom,ports-word-length =	/bits/ 8 <0x01 0x07 0x04 0xff 0xff 0xff>;
+	qcom,ports-block-pack-mode =	/bits/ 8 <0xff 0x00 0x01 0xff 0xff 0xff>;
+	qcom,ports-block-group-count =	/bits/ 8 <0xff 0xff 0xff 0xff 0x00 0x00>;
+	qcom,ports-lane-control =	/bits/ 8 <0x01 0x00 0x00 0x00 0x00 0x00>;
+};
diff --git a/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa7.dts b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa7.dts
