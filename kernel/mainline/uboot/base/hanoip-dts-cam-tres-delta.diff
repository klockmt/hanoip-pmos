@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ÁUDIO — ETAPA 7: card SEM o link do alto-falante.
+ *
+ * Diagnóstico (log ASoC com dynamic debug):
+ *   "ASoC: found 2 new BE paths" -> open BE Speaker Playback + open BE WCD Playback
+ *   "close FE MultiMedia1"       -> o frontend fecha e o write volta EIO
+ * O card conecta SEMPRE os dois backends (codec e alto-falante). O backend do
+ * alto-falante (amp smart AW882xx) falha e derruba o stream inteiro — por isso
+ * o teste com o mixer do alto-falante ligado funcionava e o do codec não.
+ *
+ * Aqui o link do alto-falante é REMOVIDO do card, deixando apenas o codec.
+ * Isso isola mic/earpiece/fone. O alto-falante continua funcionando no PRE-GOLD
+ * (onde o card não tem os links do codec).
+ */
+#include "sm7150-motorola-hanoip-audio-etapa5.dts"
+
+&{/sound} {
+	/delete-node/ speaker-dai-link;
+};
diff --git a/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa8.dts b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa8.dts
new file mode 100644
index 00000000..b5895d37
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa8.dts
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ÁUDIO — ETAPA 8: canais do SoundWire do HANOIP (não do sweet).
+ *
+ * Origem dos valores: stock DT do hanoip, propriedade qcom,rx_swr_ch_map:
+ *   9 10 13 11 12 14 15 16  (na ordem dos canais do escravo: hph_l, hph_r,
+ *   clsh, comp_l, comp_r, lo, dsd_r, dsd_l — mesma ordem que o exemplo do
+ *   binding qcom,wcd937x-sdw.yaml descreve).
+ * O mainline espera esses canais em qcom,rx-channel-mapping (8 bytes). Até aqui
+ * estávamos usando os valores do xiaomi-sweet (1 2 1 1 2 1 1 2), que são os
+ * canais do master *daquela* placa — não os do hanoip. Com o mapa errado o
+ * codec recebe dados em canais que não existem nele, o stream morre logo
+ * depois de começar (EIO) e o DSP não reporta nada (bate com o medido).
+ */
+#include "sm7150-motorola-hanoip-audio-etapa7.dts"
+
+&swr_rx {
+	wcd937x_rx: codec@0,4 {
+		qcom,rx-port-mapping = <1 2 3 4 5>;
+		qcom,rx-channel-mapping = /bits/ 8 <9 10 13 11 12 14 15 16>;
+	};
+};
diff --git a/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa9.dts b/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-audio-etapa9.dts
new file mode 100644
