+++ ours/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-pmos-audio.dts	2026-10-25 22:55:50
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "sm7150-motorola-hanoip-pmos.dts"
+
+/*
+ * Audio bring-up, phase 1: start the ADSP (LPASS) with the hanoip
+ * firmware read from modem_a. The APR services (q6core, q6afe with the
+ * LPASS clocks, q6asm, q6adm/routing) come from sm7150.dtsi; no sound card
+ * or amplifier is enabled yet.
+ */
+&remoteproc_adsp {
+	firmware-name = "qcom/sm7150/motorola/hanoip/adsp.mdt";
+	status = "okay";
+};
diff -ruN fork/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-pmos-audio2.dts ours/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-pmos-audio2.dts
--- fork/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-pmos-audio2.dts	1969-12-31 21:00:00
+++ ours/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-pmos-audio2.dts	2026-10-26 09:45:14
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include <dt-bindings/sound/qcom,q6asm.h>
+#include "sm7150-motorola-hanoip-pmos-audio.dts"
+
+/*
+ * Audio bring-up, phase 2: a sound card with MultiMedia1 routed to the
+ * speaker I2S (SECONDARY_MI2S_RX on vendor LPI gpio8-11).
+ * No codec yet: the aw882xx amplifier stays off, so this only proves the
+ * path through the ADSP. Vendor format: 48 kHz, S16_LE, mono, playback on
+ * data line 0 and amplifier feedback on line 1.
+ */
+/ {
+	/*
+	 * Placeholder codec for phase 2: qcom_snd_parse_of() only makes a
+	 * link a DPCM backend when it has both platform and codec. Touches no
+	 * hardware; replaced by the aw882xx amplifier in phase 3.
+	 */
+	speaker_dummy_codec: audio-codec-dummy {
+		compatible = "linux,spdif-dit";
+		#sound-dai-cells = <0>;
+	};
+
+	sound {
+		compatible = "qcom,sm8250-sndcard";
+		model = "Motorola Moto G60";
+		pinctrl-0 = <&hanoip_sec_mi2s_active>;
+		pinctrl-names = "default";
+
+		mm1-dai-link {
+			link-name = "MultiMedia1";
+
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+			};
+		};
+
+		speaker-dai-link {
+			link-name = "Speaker Playback";
+
+			cpu {
+				sound-dai = <&q6afedai SECONDARY_MI2S_RX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&speaker_dummy_codec>;
+			};
+		};
+	};
+};
+
+&q6asmdai {
+	dai@0 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
+	};
+};
+
+&q6afedai {
+	dai@18 {
+		reg = <SECONDARY_MI2S_RX>;
+		qcom,sd-lines = <0>;
+	};
+};
+
+/*
+ * The speaker I2S pins are vendor LPI gpio8-11, in the SSC part of the LPI
+ * TLMM below &lpass_tlmm (which starts at vendor gpio18). Only their four
+ * register blocks are mapped.
+ */
+&soc {
+	lpass_tlmm_ssc: pinctrl@62b48000 {
+		compatible = "qcom,sm7150-lpass-lpi-ssc-pinctrl";
+		reg = <0 0x62b48000 0 0x4000>;
+
+		clocks = <&q6afecc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+		clock-names = "core";
+
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-ranges = <&lpass_tlmm_ssc 0 0 4>;
+
+		hanoip_sec_mi2s_active: sec-mi2s-active-state {
+			sclk-pins {
+				pins = "ssc_gpio8";
+				function = "sec_mi2s_sclk";
+				drive-strength = <16>;
+				bias-bus-hold;
+			};
+
+			ws-pins {
+				pins = "ssc_gpio9";
+				function = "sec_mi2s_ws";
+				drive-strength = <16>;
+				bias-bus-hold;
+			};
+
+			data0-pins {
+				pins = "ssc_gpio10";
+				function = "sec_mi2s_data0";
+				drive-strength = <16>;
+				bias-bus-hold;
+			};
+
+			data1-pins {
+				pins = "ssc_gpio11";
+				function = "sec_mi2s_data1";
+				drive-strength = <16>;
+				bias-disable;
+				input-enable;
+			};
+		};
+	};
+};
diff -ruN fork/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-pmos-audio3.dts ours/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-pmos-audio3.dts
--- fork/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-pmos-audio3.dts	1969-12-31 21:00:00
+++ ours/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-pmos-audio3.dts	2026-10-25 23:11:03
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "sm7150-motorola-hanoip-pmos-audio2.dts"
+
+/*
+ * Audio bring-up, phase 3: the Awinic AW882xx speaker amplifier on I2C2
+ * (SE 0x888000, address 0x34), reset on TLMM GPIO43 as in the vendor tree,
+ * replacing the phase 2 placeholder codec on the speaker link. The driver
+ * keeps the amplifier muted and powered down until playback and starts
+ * attenuated (snd-soc-aw882xx attenuation_db, default 18 dB).
+ */
+&i2c2 {
+	speaker_amp: audio-codec@34 {
+		compatible = "awinic,aw882xx";
+		reg = <0x34>;
+		reset-gpios = <&tlmm 43 GPIO_ACTIVE_LOW>;
+		#sound-dai-cells = <0>;
+	};
+};
+
+&{/sound/speaker-dai-link/codec} {
+	sound-dai = <&speaker_amp>;
+};
diff -ruN fork/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-pmos-camid.dts ours/dts/upstream/src/arm64/qcom/sm7150-motorola-hanoip-pmos-camid.dts
