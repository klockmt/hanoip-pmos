+/*
+ * Get the block device used by fastboot.
+ * Tries "mmc" first (eMMC devices), then falls back to "scsi"
+ * (needed for UFS storage on Qualcomm SM7150+).
+ */
+static struct blk_desc *fastboot_get_blk_dev(int devnum)
+{
+	struct blk_desc *desc;
+
+	desc = blk_get_dev("mmc", devnum);
+	if (desc)
+		return desc;
+
+#ifdef CONFIG_SCSI
+	/* Ensure SCSI/UFS devices are scanned before looking them up */
+	if (!blk_get_dev("scsi", devnum)) {
+		scsi_scan(false);
+		desc = blk_get_dev("scsi", devnum);
+		return desc;
+	}
+	desc = blk_get_dev("scsi", devnum);
+#endif
+	return desc;
+}
