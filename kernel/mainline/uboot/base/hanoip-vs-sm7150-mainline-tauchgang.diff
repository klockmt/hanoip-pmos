@@ -22,6 +22,7 @@
 #include <env.h>
 #include <fdt_support.h>
 #include <init.h>
+#include <wdt.h>
 #include <linux/arm-smccc.h>
 #include <linux/bug.h>
 #include <linux/psci.h>
@@ -32,6 +33,8 @@
 #include <usb.h>
 #include <sort.h>
 #include <time.h>
+#include <generic-phy.h>
+#include <reset.h>
 
 #include "qcom-priv.h"
 
@@ -748,4 +751,115 @@
 		debug("carveout time: %lums\n", get_timer(carveout_start));
 	}
 	dcache_enable();
+}
+
+
+/*
+ * Stop all watchdogs before handing over to the kernel.
+ *
+ * The QCOM WDT is started and serviced by U-Boot (CONFIG_WATCHDOG_AUTOSTART).
+ * Once U-Boot jumps to the kernel it no longer services the WDT, and a
+ * mainline kernel without a userspace watchdog daemon will get reset after
+ * the WDT timeout.  Stop it here so the kernel is not reset out from under
+ * it during early boot.
+ */
+static void ufs_shutdown_for_kernel(void)
+{
+	struct udevice *dev;
+	int ret;
+
+	/*
+	 * Power down the UFS PHY and put the host controller in reset so
+	 * the mainline kernel can re-initialize them cleanly. U-Boot leaves
+	 * the PHY powered and calibrated (it reads the boot partitions),
+	 * which the kernel QMP UFS PHY driver is unable to recover from.
+	 */
+	for (uclass_find_first_device(UCLASS_UFS, &dev);
+	     dev;
+	     uclass_find_next_device(&dev)) {
+		struct reset_ctl reset;
+		struct phy phy;
+
+		if (!device_active(dev))
+			continue;
+
+		ret = generic_phy_get_by_name(dev, "ufsphy", &phy);
+		if (!ret) {
+			generic_phy_power_off(&phy);
+			generic_phy_exit(&phy);
+		}
+
+		ret = reset_get_by_name(dev, "rst", &reset);
+		if (!ret) {
+			/*
+			 * Reset the UFS block then immediately deassert so the
+			 * mainline kernel's ICE clock probe (gcc_ufs_phy_ice_core_clk)
+			 * does not see the whole UFS clock block stuck in reset
+			 * (BRANCH_HALT never clears -> "stuck at off" -EBUSY).
+			 * The kernel re-asserts/deasserts the BCR itself during
+			 * ufs_qcom_power_up_sequence().
+			 */
+			reset_assert(&reset);
+			reset_deassert(&reset);
+		}
+	}
+
+	printf("QCOM: UFS powered down before kernel handoff\n");
+}
+
+static void usb_shutdown_for_kernel(void)
+{
+	struct udevice *dev;
+	int ret;
+
+	/*
+	 * Power down the USB PHY(s) and put the DWC3 controller in reset so
+	 * the mainline kernel can re-initialize them cleanly. U-Boot leaves
+	 * the QUSB2 PHY powered and calibrated (it ran the fastboot gadget),
+	 * which the kernel dwc3-qcom/qusb2 drivers are unable to recover
+	 * from.
+	 */
+	for (uclass_find_first_device(UCLASS_USB_GADGET_GENERIC, &dev);
+	     dev;
+	     uclass_find_next_device(&dev)) {
+		struct reset_ctl reset;
+		struct phy phy;
+
+		if (!device_active(dev))
+			continue;
+
+		/*
+		 * Power off + exit the high-speed (and super-speed, if
+		 * present) PHY. Powering off the QUSB2 PHY also asserts its
+		 * own reset (GCC_QUSB2PHY_PRIM_BCR).
+		 */
+		ret = generic_phy_get_by_name(dev, "usb2-phy", &phy);
+		if (ret)
+			ret = generic_phy_get_by_name(dev, "usb3-phy", &phy);
+		if (!ret) {
+			generic_phy_power_off(&phy);
+			generic_phy_exit(&phy);
+		}
+
+		/*
+		 * The dwc3 glue (qcom,dwc3) is the parent device and owns
+		 * the GCC_USB30_PRIM_BCR reset. Assert it so the kernel
+		 * dwc3-qcom glue sees a clean, reset controller.
+		 */
+		if (dev->parent) {
+			ret = reset_get_by_index(dev->parent, 0, &reset);
+			if (!ret)
+				reset_assert(&reset);
+		}
+	}
+
+	printf("QCOM: USB powered down before kernel handoff\n");
+}
+
+void board_preboot_os(void)
+{
+	wdt_stop_all();
+	ufs_shutdown_for_kernel();
+	usb_shutdown_for_kernel();
+	printf("QCOM: stopped watchdogs before kernel handoff\n");
 }
