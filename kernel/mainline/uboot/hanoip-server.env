# U-Boot environment of the persistent mainline boot (docs/MAINLINE.md): U-Boot sits at the start of boot_a and the
# kernel image (header v2: kernel, stage-1 initramfs, scripts/mainline-ram-image) 16 MiB into the same partition.
# U-Boot finds boot_a by name, reads 32 MiB from there and boots it with its own embedded DTB, as fastboot boot does.
# If that fails it resets: the ABL counts a failed boot of slot a and, once the retries run out, boots slot b (the
# 4.14 server). Volume Down at boot opens the menu (fastboot for a RAM boot from the PC). This U-Boot cannot flash.
# bootdelay=-2 boots without looking for a key: a key already pending at autoboot (the phone has one) stopped
# bootdelay=0 at the prompt for good.
bootdelay=-2
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
boot_with_embedded_fdt=1
fastboot=fastboot -l $fastboot_addr_r usb 0
preboot=
ml_load_boot=part start scsi $ml_dev $ml_part ml_start && setexpr ml_blk $ml_start + 0x1000 && scsi dev $ml_dev && scsi read $fastboot_addr_r $ml_blk 0x2000 && abootimg addr $fastboot_addr_r && bootm $fastboot_addr_r
ml_boot=scsi scan; for d in 0 1 2 3 4 5 6 7; do if part number scsi $d boot_a ml_part; then setenv ml_dev $d; run ml_load_boot; fi; done
bootcmd=run ml_boot; echo hanoip: mainline boot failed, resetting; sleep 5; reset
serial_gadget=setenv stdin serial,button-kbd,usbacm; setenv stdout serial,vidconsole,usbacm; setenv stderr serial,vidconsole,usbacm; setenv bootretry -1
menucmd=bootmenu -1
bootmenu_0=Boot the mainline server=run ml_boot
bootmenu_1=Enable fastboot (RAM boot only)=run fastboot
bootmenu_2=Enable serial console gadget=run serial_gadget
bootmenu_3=Board info=bdinfo; pause
bootmenu_4=Reset device=reset
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
