# U-Boot environment of the persistent mainline boot (docs/MAINLINE.md, docs/DURANIUM.md steps 5 and 6). U-Boot sits at
# the start of boot_a (and, at the Duranium switch, of boot_b), with the kernel image (header v2: kernel, stage-1
# initramfs, scripts/mainline-ram-image) 16 MiB into the same partition.
# ml_slot is the slot the ABL started U-Boot from (0003-export-the-abl-slot-to-the-environment.patch; _a when the ABL
# gave none). From slot a U-Boot first tries Duranium: it presents userdata as a disk through blkmap and boots the
# EFI loader on its first partition (the ESP) with its own DTB. Before the switch userdata holds the 4.14's image,
# which has no ESP, so this fails and U-Boot goes on as before. From slot b, the rescue after the switch, it never tries
# userdata, or the rescue would boot Duranium. Then it finds boot$ml_slot by name, reads 32 MiB from 16 MiB in and
# boots it with its own embedded DTB, as fastboot boot does. If that fails it resets: the ABL counts a failed boot of
# the slot and, once the retries run out, boots the other one. Volume Down at boot opens the menu (fastboot for a RAM
# boot from the PC). This U-Boot cannot flash and runs nothing that writes a disk.
# bootdelay=-2 boots without looking for a key: a key already pending at autoboot (the phone has one) stopped
# bootdelay=0 at the prompt for good. Nothing feeds the watchdog until the kernel does (server.config), so the menu,
# which waits for a person, stops it first.
bootdelay=-2
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
boot_with_embedded_fdt=1
fastboot=fastboot -l $fastboot_addr_r usb 0
preboot=
ml_slot=_a
ml_load_boot=part start scsi $ml_dev $ml_part ml_start && setexpr ml_blk $ml_start + 0x1000 && scsi dev $ml_dev && scsi read $fastboot_addr_r $ml_blk 0x2000 && abootimg addr $fastboot_addr_r && bootm $fastboot_addr_r
ml_legacy=for d in 0 1 2 3 4 5 6 7; do if part number scsi $d boot${ml_slot} ml_part; then setenv ml_dev $d; run ml_load_boot; fi; done
# blkmap takes the LUN's 4096-byte blocks and names the LUN itself (no scsi dev needed). part start prints hex with no
# 0x, which the linear source block needs (it is read in base 0). Only a first partition of the ESP's type is opened, so
# the 4.14's filesystems are never read. bootefi with no DTB passes U-Boot's own.
ml_efi_load=blkmap destroy ml_root; part start scsi $ml_ud_dev $ml_ud_part ml_ud_start && part size scsi $ml_ud_dev $ml_ud_part ml_ud_size && blkmap create ml_root && blkmap map ml_root 0 $ml_ud_size linear scsi $ml_ud_dev 0x$ml_ud_start && blkmap get ml_root dev ml_bm && part type blkmap ${ml_bm}:1 ml_esp && test "${ml_esp}" = c12a7328-f81f-11d2-ba4b-00a0c93ec93b && load blkmap ${ml_bm}:1 $kernel_addr_r EFI/BOOT/BOOTAA64.EFI && bootefi $kernel_addr_r
ml_efi=for d in 0 1 2 3 4 5 6 7; do if part number scsi $d userdata ml_ud_part; then setenv ml_ud_dev $d; run ml_efi_load; fi; done
ml_boot=scsi scan; if test "${ml_slot}" = _a; then run ml_efi; fi; run ml_legacy
bootcmd=run ml_boot; echo hanoip: mainline boot failed, resetting; sleep 5; reset
serial_gadget=setenv stdin serial,button-kbd,usbacm; setenv stdout serial,vidconsole,usbacm; setenv stderr serial,vidconsole,usbacm; setenv bootretry -1
menucmd=bootmenu -1
bootmenu_0=Boot the mainline server=run ml_boot
bootmenu_1=Boot Duranium from userdata (EFI)=scsi scan; run ml_efi; echo hanoip: no EFI loader in userdata; pause
bootmenu_2=Enable fastboot (RAM boot only)=run fastboot
bootmenu_3=Enable serial console gadget=run serial_gadget
bootmenu_4=Board info=bdinfo; pause
bootmenu_5=Reset device=reset
button_cmd_0_name=Volume Down
button_cmd_0=wdt dev watchdog@17c10000; wdt stop; run menucmd
