# Options of the persistent-boot U-Boot on top of the base's base.config (scripts/build-mainline-uboot merges this
# file and fails if any line is missing from the final .config). Its RAM-boot U-Boot has no UFS at all; this one reads
# UFS to find the kernel in boot_a, and still cannot flash (FASTBOOT_FLASH stays off).
CONFIG_ENV_SOURCE_FILE="hanoip-server"
# The default environment actually comes from this text file (its base.config points it at hanoip-diagnostic.env).
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/hanoip-server.env"
CONFIG_SCSI=y
CONFIG_UFS=y
CONFIG_QCOM_UFS=y
CONFIG_CMD_SCSI=y
# CONFIG_FASTBOOT_FLASH is not set
