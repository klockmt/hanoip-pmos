From e3008d79c5fb995bfee09cf3cc7910806a56d33e Mon Sep 17 00:00:00 2001
From: hanoip <hanoip@localhost>
Date: Mon, 26 Oct 2026 13:27:21 +0000
Subject: [PATCH 163/194] Input: pm8xxx-vibrator: optional maximum drive
 voltage

The PMI632-style LDO vibrator drives up to 3.544 V at full force-feedback
magnitude. Motors rated lower (Motorola hanoip: 3.0 V, as in the vendor
tree, without overdrive) need a cap. Read qcom,vib-max-microvolt and
scale the force-feedback range up to it.
---
 drivers/input/misc/pm8xxx-vibrator.c | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/drivers/input/misc/pm8xxx-vibrator.c b/drivers/input/misc/pm8xxx-vibrator.c
index 381b06473..5b5d83fe1 100644
--- a/drivers/input/misc/pm8xxx-vibrator.c
+++ b/drivers/input/misc/pm8xxx-vibrator.c
@@ -8,6 +8,7 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/property.h>
 #include <linux/regmap.h>
 #include <linux/slab.h>
 
@@ -76,6 +77,7 @@ static struct pm8xxx_regs pmi632_regs = {
  * @speed: speed of vibration set from userland
  * @active: state of vibrator
  * @level: level of vibration to set in the chip
+ * @max_mV: highest drive level, from qcom,vib-max-microvolt or the chip limit
  * @reg_vib_drv: regs->drv_addr register value
  */
 struct pm8xxx_vib {
@@ -88,6 +90,7 @@ struct pm8xxx_vib {
 	unsigned int drv2_addr;
 	int speed;
 	int level;
+	unsigned int max_mV;
 	bool active;
 	u8  reg_vib_drv;
 };
@@ -153,7 +156,9 @@ static void pm8xxx_work_handler(struct work_struct *work)
 	if (vib->speed) {
 		vib->active = true;
 		vib->level = VIB_MIN_LEVEL_mV(vib);
-		vib->level += mult_frac(VIB_MAX_LEVELS(vib), vib->speed, MAX_FF_SPEED);
+		vib->level += mult_frac(vib->max_mV - VIB_MIN_LEVEL_mV(vib) +
+					VIB_PER_STEP_mV(vib), vib->speed, MAX_FF_SPEED);
+		vib->level = min_t(int, vib->level, vib->max_mV);
 	} else {
 		vib->active = false;
 		vib->level = VIB_MIN_LEVEL_mV(vib);
@@ -244,6 +249,12 @@ static int pm8xxx_vib_probe(struct platform_device *pdev)
 	vib->regs = regs;
 	vib->reg_vib_drv = val;
 
+	/* Motors rated below the chip limit set their maximum drive voltage. */
+	vib->max_mV = VIB_MAX_LEVEL_mV(vib);
+	if (!device_property_read_u32(&pdev->dev, "qcom,vib-max-microvolt", &val))
+		vib->max_mV = clamp_t(unsigned int, val / 1000, VIB_MIN_LEVEL_mV(vib),
+				      VIB_MAX_LEVEL_mV(vib));
+
 	input_dev->name = "pm8xxx_vib_ffmemless";
 	input_dev->id.version = 1;
 	input_dev->close = pm8xxx_vib_close;
-- 
