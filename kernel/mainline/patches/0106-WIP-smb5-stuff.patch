From 06a05d10fdb5bf0d185af0092cf58b0bff640953 Mon Sep 17 00:00:00 2001
From: Aelin Reidel <aelin@mainlining.org>
Date: Thu, 29 Jan 2026 03:56:52 +0100
Subject: [PATCH 106/194] WIP smb5 stuff

---
 arch/arm64/boot/dts/qcom/pm6150.dtsi          | 30 +++++++++++++++++++
 .../boot/dts/qcom/sm7150-xiaomi-common.dtsi   | 14 +++++++++
 arch/arm64/configs/sm7150.config              |  1 +
 3 files changed, 45 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/pm6150.dtsi b/arch/arm64/boot/dts/qcom/pm6150.dtsi
index 73a70610d..efd81c7dc 100644
--- a/arch/arm64/boot/dts/qcom/pm6150.dtsi
+++ b/arch/arm64/boot/dts/qcom/pm6150.dtsi
@@ -63,6 +63,24 @@ pm6150_resin: resin {
 			};
 		};
 
+		pm6150_charger: charger@1000 {
+			compatible = "qcom,pm6150-charger", "qcom,pm8150b-charger";
+			reg = <0x1000>;
+			interrupts = <0x0 0x13 0x4 IRQ_TYPE_EDGE_BOTH>,
+				     <0x0 0x12 0x2 IRQ_TYPE_EDGE_BOTH>,
+				     <0x0 0x16 0x1 IRQ_TYPE_EDGE_RISING>,
+				     <0x0 0x13 0x7 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "usb-plugin",
+					  "bat-ov",
+					  "wdog-bark",
+					  "usbin-icl-change";
+			io-channels = <&pm6150_adc ADC5_USB_IN_I>,
+				      <&pm6150_adc ADC5_USB_IN_V_16>;
+			io-channel-names = "usbin_i",
+					   "usbin_v";
+			status = "disabled";
+		};
+
 		pm6150_vbus: usb-vbus-regulator@1100 {
 			compatible = "qcom,pm6150-vbus-reg",
 				     "qcom,pm8150b-vbus-reg";
@@ -131,6 +149,18 @@ channel@6 {
 				label = "die_temp";
 			};
 
+			channel@7 {
+				reg = <ADC5_USB_IN_I>;
+				qcom,pre-scaling = <1 1>;
+				label = "usb_in_i_uv";
+			};
+
+			channel@8 {
+				reg = <ADC5_USB_IN_V_16>;
+				qcom,pre-scaling = <1 16>;
+				label = "usb_in_v_div_16";
+			};
+
 			bat_therm@4a {
 				reg = <ADC5_BAT_THERM_100K_PU>;
 				label = "bat_therm";
diff --git a/arch/arm64/boot/dts/qcom/sm7150-xiaomi-common.dtsi b/arch/arm64/boot/dts/qcom/sm7150-xiaomi-common.dtsi
index 81e9a2f34..bdf83786f 100644
--- a/arch/arm64/boot/dts/qcom/sm7150-xiaomi-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7150-xiaomi-common.dtsi
@@ -35,6 +35,15 @@ aliases {
 	battery: battery {
 		compatible = "simple-battery";
 
+		device-chemistry = "lithium-ion-polymer";
+
+		/*
+		 * Keep the maximum charging current conservative for now,
+		 * until we have thermal handling in the charging driver.
+		 * Downstream seems to have a upper limit of 3A.
+		 */
+		constant-charge-current-max-microamp = <1500000>;
+
 		voltage-min-design-microvolt = <3400000>;
 		voltage-max-design-microvolt = <4400000>;
 	};
@@ -561,6 +570,11 @@ &mdss_dsi0_phy {
 	status = "okay";
 };
 
+&pm6150_charger {
+	monitored-battery = <&battery>;
+	status = "okay";
+};
+
 &pm6150_qgauge {
 	monitored-battery = <&battery>;
 	status = "okay";
diff --git a/arch/arm64/configs/sm7150.config b/arch/arm64/configs/sm7150.config
index 801cb4916..36dd58506 100644
--- a/arch/arm64/configs/sm7150.config
+++ b/arch/arm64/configs/sm7150.config
@@ -12,6 +12,7 @@ CONFIG_INPUT_AW8695_HAPTICS=m
 CONFIG_BATTERY_QCOM_QG=m
 CONFIG_TYPEC_MUX_FSA4480=y
 CONFIG_RTC_DRV_PM8XXX=y
+CONFIG_CHARGER_QCOM_SMB2=m
 
 # Google Pixel 4a (Sunfish)
 CONFIG_DRM_PANEL_SAMSUNG_AMS581VF01=y
-- 
2.43.0

