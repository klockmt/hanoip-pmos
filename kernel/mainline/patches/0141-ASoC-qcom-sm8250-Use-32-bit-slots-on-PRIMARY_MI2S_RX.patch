From e961bf1464361634bab043342885a10790590476 Mon Sep 17 00:00:00 2001
From: Aleks <aleks.spv@gmail.com>
Date: Fri, 23 Oct 2026 09:52:39 +0600
Subject: [PATCH 141/194] ASoC: qcom: sm8250: Use 32-bit slots on
 PRIMARY_MI2S_RX for Xiaomi sweet

The AW88263S amplifiers on the Xiaomi Redmi Note 10 Pro only start with
a 64fs bit clock. For the xiaomi,sweet-sndcard compatible, force S32_LE
on the primary MI2S backend and double its bit clock. Other boards keep
16-bit slots and the 1.536 MHz bit clock.

Signed-off-by: Aleks <aleks.spv@gmail.com>
---
 sound/soc/qcom/sm8250.c | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
index 76dc3a3f4..bb52c4f8a 100644
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -3,6 +3,7 @@
 
 #include <dt-bindings/sound/qcom,q6afe.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <sound/soc.h>
 #include <sound/soc-dapm.h>
@@ -26,6 +27,7 @@ struct sm8250_snd_data {
 	bool usb_offload_jack_setup;
 	struct snd_soc_jack dp_jack;
 	bool jack_setup;
+	bool pri_mi2s_32bit;
 };
 
 static int sm8250_snd_init(struct snd_soc_pcm_runtime *rtd)
@@ -58,6 +60,8 @@ static void sm8250_snd_exit(struct snd_soc_pcm_runtime *rtd)
 static int sm8250_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 				     struct snd_pcm_hw_params *params)
 {
+	struct sm8250_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct snd_interval *rate = hw_param_interval(params,
 					SNDRV_PCM_HW_PARAM_RATE);
 	struct snd_interval *channels = hw_param_interval(params,
@@ -66,7 +70,12 @@ static int sm8250_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 
 	rate->min = rate->max = 48000;
 	channels->min = channels->max = 2;
-	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
+	if (cpu_dai->id == PRIMARY_MI2S_RX && data->pri_mi2s_32bit) {
+		snd_mask_none(fmt);
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S32_LE);
+	} else {
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
+	}
 
 	return 0;
 }
@@ -78,13 +87,15 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+	struct sm8250_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
 
 	switch (cpu_dai->id) {
 	case PRIMARY_MI2S_RX:
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
 		snd_soc_dai_set_sysclk(cpu_dai,
 			Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT,
-			MI2S_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
+			data->pri_mi2s_32bit ? MI2S_BCLK_RATE * 2 : MI2S_BCLK_RATE,
+			SNDRV_PCM_STREAM_PLAYBACK);
 		snd_soc_dai_set_fmt(cpu_dai, fmt);
 		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
 		break;
@@ -200,6 +211,9 @@ static int sm8250_platform_probe(struct platform_device *pdev)
 		return ret;
 
 	card->driver_name = of_device_get_match_data(dev);
+	/* AW88263S amplifiers only start with 32-bit slots (64fs bit clock) */
+	data->pri_mi2s_32bit = of_device_is_compatible(dev->of_node,
+						       "xiaomi,sweet-sndcard");
 	sm8250_add_be_ops(card);
 	return devm_snd_soc_register_card(dev, card);
 }
@@ -212,6 +226,7 @@ static const struct of_device_id snd_sm8250_dt_match[] = {
 	{ .compatible = "qcom,qrb5165-rb5-sndcard", .data = "sm8250" },
 	{ .compatible = "qcom,sdm660-sndcard", .data = "sdm660" },
 	{ .compatible = "qcom,sm8250-sndcard", .data = "sm8250" },
+	{ .compatible = "xiaomi,sweet-sndcard", .data = "sm8250" },
 	{}
 };
 
