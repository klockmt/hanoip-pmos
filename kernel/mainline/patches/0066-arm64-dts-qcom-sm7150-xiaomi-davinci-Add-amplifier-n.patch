From 8af7b98220519577ebb1afd3d7ee503d29c940bd Mon Sep 17 00:00:00 2001
From: Jens Reidel <adrian@travitia.xyz>
Date: Tue, 26 Sep 2023 09:58:57 +0200
Subject: [PATCH 066/194] arm64: dts: qcom: sm7150-xiaomi-davinci: Add
 amplifier node

Signed-off-by: Jens Reidel <adrian@travitia.xyz>
---
 .../boot/dts/qcom/sm7150-xiaomi-davinci.dts   | 73 ++++++++++++++++++-
 1 file changed, 72 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm7150-xiaomi-davinci.dts b/arch/arm64/boot/dts/qcom/sm7150-xiaomi-davinci.dts
index 1f3cded24..68622436b 100644
--- a/arch/arm64/boot/dts/qcom/sm7150-xiaomi-davinci.dts
+++ b/arch/arm64/boot/dts/qcom/sm7150-xiaomi-davinci.dts
@@ -87,6 +87,35 @@ rmtfs_mem: rmtfs@f2e01000 {
 			qcom,vmid = <QCOM_SCM_VMID_MSS_MSA>;
 		};
 	};
+
+	sound {
+		compatible = "qcom,sm8250-sndcard";
+		pinctrl-0 = <&pri_mi2s_active &pri_mi2s_ws_active>;
+		pinctrl-names = "default";
+		model = "Xiaomi Mi 9T";
+
+		mm1-dai-link {
+			link-name = "MultiMedia1";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+			};
+		};
+
+		speaker_playback_dai {
+			link-name = "Primary Spkr Playback";
+			cpu {
+				sound-dai = <&q6afedai PRIMARY_MI2S_RX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&tfa9874>;
+			};
+		};
+	};
 };
 
 &battery {
@@ -108,7 +137,19 @@ &i2c4 {
 	clock-frequency = <100000>;
 	status = "okay";
 
-	/* nxp,tfa9874 (speaker amplifier) @ 34 */
+	tfa9874: codec@34 {
+		compatible = "nxp,tfa9874";
+		reg = <0x34>;
+
+		reset-gpio = <&tlmm 12 GPIO_ACTIVE_HIGH>;
+		irq-gpio = <&tlmm 56 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&amp_reset_default &amp_int_default>;
+
+		sound-name-prefix = "Speaker";
+		#sound-dai-cells = <0>;
+	};
 };
 
 &i2c7 {
@@ -237,6 +278,19 @@ led@3 {
 	};
 };
 
+&q6afedai {
+	qi2s@16 {
+		reg = <PRIMARY_MI2S_RX>;
+		qcom,sd-lines = <0>;
+	};
+};
+
+&q6asmdai {
+	dai@0 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
+	};
+};
+
 &remoteproc_adsp {
 	firmware-name = "qcom/sm7150/xiaomi/davinci/adsp.mbn";
 };
@@ -364,6 +418,23 @@ &tlmm {
 			  "NC",
 			  "RFFE1_DATA",
 			  "RFFE1_CLK";
+
+	amp_reset_default: amp-reset-default-state {
+		pins = "gpio12";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		bias-pull-down;
+		output-low;
+	};
+
+	amp_int_default: amp-int-default-state {
+		pins = "gpio56";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+		input-enable;
+	};
 };
 
 &venus {
-- 
