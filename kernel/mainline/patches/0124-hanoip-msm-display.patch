 	struct msm_drm_private *priv = dev->dev_private;
 	struct msm_kms *kms = priv->kms;
 	struct device *iommu_dev;
+	u64 iova_size = 0x100000000ULL - 0x1000;
 
 	/*
 	 * IOMMUs can be a part of MDSS device tree binding, or the
@@ -203,8 +204,11 @@ struct drm_gpuvm *msm_kms_init_vm(struct drm_device *dev, struct device *mdss_de
 	if (IS_ERR(mmu))
 		return ERR_CAST(mmu);
 
+	/* Keep allocations below the reserved firmware scanout mapping. */
+	if (mmu->firmware_start)
+		iova_size = mmu->firmware_start - 0x1000;
 	vm = msm_gem_vm_create(dev, mmu, "mdp_kms",
-			       0x1000, 0x100000000 - 0x1000, true);
+			       0x1000, iova_size, true);
 	if (IS_ERR(vm)) {
 		dev_err(mdp_dev, "vm create, error %pe\n", vm);
 		mmu->funcs->destroy(mmu);
diff --git a/drivers/gpu/drm/msm/msm_mdss.c b/drivers/gpu/drm/msm/msm_mdss.c
index 9087c4b29..c721064d5 100644
--- a/drivers/gpu/drm/msm/msm_mdss.c
+++ b/drivers/gpu/drm/msm/msm_mdss.c
@@ -319,6 +319,7 @@ static int msm_mdss_reset(struct device *dev)
 				     "failed to acquire mdss reset\n");
 	}
 
+	dev_info(dev, "HANOIP MDSS: asserting reset\n");
 	reset_control_assert(reset);
 	/*
 	 * Tests indicate that reset has to be held for some period of time,
@@ -326,6 +327,7 @@ static int msm_mdss_reset(struct device *dev)
 	 */
 	msleep(20);
 	reset_control_deassert(reset);
+	dev_info(dev, "HANOIP MDSS: reset released\n");
 
 	reset_control_put(reset);
 
@@ -473,6 +475,7 @@ static int mdss_probe(struct platform_device *pdev)
 	struct device *dev = &pdev->dev;
 	int ret;
 
+	dev_info(dev, "HANOIP MDSS: probe entered\n");
 	mdss = msm_mdss_init(pdev, is_mdp5);
 	if (IS_ERR(mdss))
 		return PTR_ERR(mdss);
@@ -485,6 +488,7 @@ static int mdss_probe(struct platform_device *pdev)
 	 * Populate the children devices, find the MDP5/DPU node, and then add
 	 * the interfaces to our components list.
 	 */
+	dev_info(dev, "HANOIP MDSS: populating children\n");
 	ret = of_platform_populate(dev->of_node, NULL, NULL, dev);
 	if (ret) {
 		DRM_DEV_ERROR(dev, "failed to populate children devices\n");
diff --git a/drivers/gpu/drm/msm/msm_mmu.h b/drivers/gpu/drm/msm/msm_mmu.h
index 8915662fb..d36e9c12b 100644
--- a/drivers/gpu/drm/msm/msm_mmu.h
+++ b/drivers/gpu/drm/msm/msm_mmu.h
@@ -56,6 +56,8 @@ struct msm_mmu {
 	int (*handler)(void *arg, unsigned long iova, int flags, void *data);
 	void *arg;
 	enum msm_mmu_type type;
+	/* Optional firmware scanout mapping, excluded from display allocations. */
+	u64 firmware_start;
 
 	/**
 	 * @prealloc: pre-allocated pages for pgtable
@@ -72,6 +74,7 @@ static inline void msm_mmu_init(struct msm_mmu *mmu, struct device *dev,
 	mmu->dev = dev;
 	mmu->funcs = funcs;
 	mmu->type = type;
+	mmu->firmware_start = 0;
 }
 
 struct msm_mmu *msm_iommu_new(struct device *dev, unsigned long quirks);
