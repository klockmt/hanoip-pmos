diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index b292dfd26..3c3266f39 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -147,6 +147,11 @@ struct msm_dsi_host {
 	spinlock_t intr_lock; /* Protect interrupt ctrl register */
 
 	u32 err_work_state;
+	/* Cached hanoip diagnostics; reading sysfs never transmits DSI commands. */
+	bool diag_enabled;
+	u32 diag_count;
+	u32 diag_first[6], diag_last[6], diag_or[6];
+	u32 diag_pre_ctrl, diag_pre_status, diag_post_ctrl, diag_post_status;
 	struct work_struct err_work;
 	struct workqueue_struct *workqueue;
 
@@ -1668,8 +1673,26 @@ static void dsi_clk_status(struct msm_dsi_host *msm_host)
 
 static void dsi_error(struct msm_dsi_host *msm_host)
 {
+	static const u32 regs[] = {
+		REG_DSI_ACK_ERR_STATUS, REG_DSI_FIFO_STATUS,
+		REG_DSI_TIMEOUT_STATUS, REG_DSI_DLN0_PHY_ERR,
+		REG_DSI_STATUS0, REG_DSI_CLK_STATUS,
+	};
+	unsigned int i;
+
 	/* disable dsi error interrupt */
 	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_ERROR, 0);
+	if (msm_host->diag_enabled) {
+		for (i = 0; i < ARRAY_SIZE(regs); i++) {
+			u32 value = dsi_read(msm_host, regs[i]);
+
+			if (!msm_host->diag_count)
+				msm_host->diag_first[i] = value;
+			msm_host->diag_last[i] = value;
+			msm_host->diag_or[i] |= value;
+		}
+		msm_host->diag_count++;
+	}
 
 	dsi_clk_status(msm_host);
 	dsi_fifo_status(msm_host);
@@ -2002,6 +2025,34 @@ static int dsi_host_get_id(struct msm_dsi_host *msm_host)
 	return -EINVAL;
 }
 
+static ssize_t error_snapshot_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct msm_dsi *dsi = dev_get_drvdata(dev);
+	struct msm_dsi_host *host;
+
+	if (!dsi || !dsi->host)
+		return -ENODEV;
+	host = to_msm_dsi_host(dsi->host);
+	return sysfs_emit(buf,
+		"irqs=%u order=ack,fifo,timeout,phy,status0,clk first=%#x,%#x,%#x,%#x,%#x,%#x last=%#x,%#x,%#x,%#x,%#x,%#x or=%#x,%#x,%#x,%#x,%#x,%#x pre_ctrl=%#x pre_status=%#x post_ctrl=%#x post_status=%#x\n",
+		READ_ONCE(host->diag_count),
+		READ_ONCE(host->diag_first[0]), READ_ONCE(host->diag_first[1]),
+		READ_ONCE(host->diag_first[2]), READ_ONCE(host->diag_first[3]),
+		READ_ONCE(host->diag_first[4]), READ_ONCE(host->diag_first[5]),
+		READ_ONCE(host->diag_last[0]), READ_ONCE(host->diag_last[1]),
+		READ_ONCE(host->diag_last[2]), READ_ONCE(host->diag_last[3]),
+		READ_ONCE(host->diag_last[4]), READ_ONCE(host->diag_last[5]),
+		READ_ONCE(host->diag_or[0]), READ_ONCE(host->diag_or[1]),
+		READ_ONCE(host->diag_or[2]), READ_ONCE(host->diag_or[3]),
+		READ_ONCE(host->diag_or[4]), READ_ONCE(host->diag_or[5]),
+		READ_ONCE(host->diag_pre_ctrl), READ_ONCE(host->diag_pre_status),
+		READ_ONCE(host->diag_post_ctrl), READ_ONCE(host->diag_post_status));
+}
+static DEVICE_ATTR_RO(error_snapshot);
+static struct attribute *dsi_diag_attrs[] = { &dev_attr_error_snapshot.attr, NULL };
+static const struct attribute_group dsi_diag_group = { .attrs = dsi_diag_attrs };
+
 int msm_dsi_host_init(struct msm_dsi *msm_dsi)
 {
 	struct msm_dsi_host *msm_host = NULL;
@@ -2092,6 +2143,12 @@ int msm_dsi_host_init(struct msm_dsi *msm_dsi)
 	INIT_WORK(&msm_host->err_work, dsi_err_worker);
 
 	msm_dsi->id = msm_host->id;
+	msm_host->diag_enabled = of_machine_is_compatible("motorola,hanoip");
+	if (msm_host->diag_enabled) {
+		ret = devm_device_add_group(&pdev->dev, &dsi_diag_group);
+		if (ret)
+			return ret;
+	}
 
 	DBG("Dsi Host %d initialized", msm_host->id);
 	return 0;
@@ -2528,9 +2585,21 @@ int msm_dsi_host_power_on(struct mipi_dsi_host *host,
 		goto fail_disable_clk;
 	}
 
+	if (msm_host->diag_enabled) {
+		msm_host->diag_pre_ctrl = dsi_read(msm_host, REG_DSI_CTRL);
+		msm_host->diag_pre_status = dsi_read(msm_host, REG_DSI_STATUS0);
+	}
+	/* Do not resurrect ABL's active video engine inside dsi_sw_reset(). */
+	if (msm_host->diag_enabled && msm_host->dsc &&
+	    (msm_host->mode_flags & MIPI_DSI_MODE_VIDEO))
+		dsi_op_mode_config(msm_host, false, false);
 	dsi_timing_setup(msm_host, is_bonded_dsi);
 	dsi_sw_reset(msm_host);
 	dsi_ctrl_enable(msm_host, phy_shared_timings, phy);
+	if (msm_host->diag_enabled) {
+		msm_host->diag_post_ctrl = dsi_read(msm_host, REG_DSI_CTRL);
+		msm_host->diag_post_status = dsi_read(msm_host, REG_DSI_STATUS0);
+	}
 
 	msm_host->power_on = true;
 	mutex_unlock(&msm_host->dev_mutex);
diff --git a/drivers/gpu/drm/msm/dsi/dsi_manager.c b/drivers/gpu/drm/msm/dsi/dsi_manager.c
index 959daa88b..4c1675b80 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -198,6 +198,7 @@ static void dsi_mgr_phy_disable(int id)
 struct dsi_bridge {
 	struct drm_bridge base;
 	int id;
+	bool video_deferred;
 };
 
 #define to_dsi_bridge(x) container_of(x, struct dsi_bridge, base)
@@ -297,6 +298,16 @@ static void dsi_mgr_bridge_pre_enable(struct drm_bridge *bridge,
 		return;
 	}
 
+	/* Keep command transport ready, but don't feed DSC video during reset/PPS. */
+	if (!is_bonded_dsi && of_machine_is_compatible("motorola,hanoip") &&
+	    msm_dsi->next_bridge &&
+	    of_device_is_compatible(msm_dsi->next_bridge->of_node,
+				    "tianma,ili7807s-hanoip") &&
+	    (msm_dsi_host_get_mode_flags(host) & MIPI_DSI_MODE_VIDEO)) {
+		to_dsi_bridge(bridge)->video_deferred = true;
+		return;
+	}
+
 	ret = msm_dsi_host_enable(host);
 	if (ret) {
 		pr_err("%s: enable host %d failed, %d\n", __func__, id, ret);
@@ -319,6 +330,23 @@ static void dsi_mgr_bridge_pre_enable(struct drm_bridge *bridge,
 	dsi_mgr_bridge_power_off(bridge);
 }
 
+static void dsi_mgr_bridge_enable(struct drm_bridge *bridge,
+				  struct drm_atomic_commit *commit)
+{
+	struct dsi_bridge *dsi_bridge = to_dsi_bridge(bridge);
+	struct msm_dsi *dsi = dsi_mgr_get_dsi(dsi_bridge->id);
+	int ret;
+
+	if (!dsi_bridge->video_deferred)
+		return;
+	dsi_bridge->video_deferred = false;
+	ret = msm_dsi_host_enable(dsi->host);
+	if (ret) {
+		dev_err(&dsi->pdev->dev, "HANOIP: late video enable failed: %d\n", ret);
+		dsi_mgr_bridge_power_off(bridge);
+	}
+}
+
 void msm_dsi_manager_tpg_enable(void)
 {
 	struct msm_dsi *m_dsi = dsi_mgr_get_dsi(DSI_0);
@@ -342,6 +370,7 @@ static void dsi_mgr_bridge_post_disable(struct drm_bridge *bridge,
 	bool is_bonded_dsi = IS_BONDED_DSI();
 	int ret;
 
+	to_dsi_bridge(bridge)->video_deferred = false;
 	DBG("id=%d", id);
 
 	/*
@@ -452,6 +481,7 @@ static const struct drm_bridge_funcs dsi_mgr_bridge_funcs = {
 	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
 	.attach = dsi_mgr_bridge_attach,
 	.atomic_pre_enable = dsi_mgr_bridge_pre_enable,
+	.atomic_enable = dsi_mgr_bridge_enable,
 	.atomic_post_disable = dsi_mgr_bridge_post_disable,
 	.mode_set = dsi_mgr_bridge_mode_set,
 	.mode_valid = dsi_mgr_bridge_mode_valid,
