@@ -987,12 +987,7 @@ static int dispcc_sm7150_probe(struct platform_device *pdev)
 	if (IS_ERR(regmap))
 		return PTR_ERR(regmap);
 
-	clk_fabia_pll_configure(&dispcc_pll0, regmap, &dispcc_pll0_config);
