Subject: [PATCH 111/194] sound: soc: codecs: wcd937x: Resolve some warnings

---
 sound/soc/codecs/wcd937x.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/sound/soc/codecs/wcd937x.c b/sound/soc/codecs/wcd937x.c
index 0dd05604f..cc7344b2f 100644
--- a/sound/soc/codecs/wcd937x.c
+++ b/sound/soc/codecs/wcd937x.c
@@ -240,9 +240,9 @@ static const struct regmap_irq_chip wcd937x_regmap_irq_chip = {
 
 static void wcd937x_reset(struct wcd937x_priv *wcd937x)
 {
-	gpiod_set_value(wcd937x->reset_gpio, 1);
+	gpiod_set_value_cansleep(wcd937x->reset_gpio, 1);
