From a3a41c7cfced843d7298a60e3dd2cfc424d32971 Mon Sep 17 00:00:00 2001
From: hanoip <hanoip@localhost>
Date: Wed, 28 Oct 2026 19:19:06 +0000
Subject: [PATCH 188/194] ASoC: codecs: wcd937x-sdw: bound the static channel
 map to the channel table

---
 sound/soc/codecs/wcd937x-sdw.c | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/sound/soc/codecs/wcd937x-sdw.c b/sound/soc/codecs/wcd937x-sdw.c
index 1ad75c226..cec9e9dbd 100644
--- a/sound/soc/codecs/wcd937x-sdw.c
+++ b/sound/soc/codecs/wcd937x-sdw.c
@@ -1024,7 +1024,13 @@ static int wcd9370_probe(struct sdw_slave *pdev,
 		pdev->prop.src_dpn_prop = wcd937x_dpn_prop;
 		wcd->ch_info = &wcd937x_sdw_tx_ch_info[0];
 
-		for (i = 0; i < master_ch_mask_size; i++)
+		/*
+		 * qcom,tx-channel-mapping may list more entries than there are
+		 * TX channels; writing past the array corrupts the RX table
+		 * that follows it (HPH_L ends up on the wrong master channel).
+		 */
+		for (i = 0; i < min_t(int, master_ch_mask_size,
+				      ARRAY_SIZE(wcd937x_sdw_tx_ch_info)); i++)
 			wcd->ch_info[i].master_ch_mask = WCD937X_SWRM_CH_MASK(master_ch_mask[i]);
 
 		pdev->prop.wake_capable = true;
@@ -1041,7 +1047,8 @@ static int wcd9370_probe(struct sdw_slave *pdev,
 		pdev->prop.sink_dpn_prop = wcd937x_dpn_prop;
 		wcd->ch_info = &wcd937x_sdw_rx_ch_info[0];
 
-		for (i = 0; i < master_ch_mask_size; i++)
+		for (i = 0; i < min_t(int, master_ch_mask_size,
+				      ARRAY_SIZE(wcd937x_sdw_rx_ch_info)); i++)
 			wcd->ch_info[i].master_ch_mask = WCD937X_SWRM_CH_MASK(master_ch_mask[i]);
 	}
 
-- 
