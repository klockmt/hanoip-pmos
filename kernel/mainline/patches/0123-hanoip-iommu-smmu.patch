 drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c |  1 +
 drivers/iommu/arm/arm-smmu/arm-smmu.c      | 35 ++++++++++++++++++++++
 drivers/iommu/arm/arm-smmu/arm-smmu.h      |  1 +
 3 files changed, 37 insertions(+)

