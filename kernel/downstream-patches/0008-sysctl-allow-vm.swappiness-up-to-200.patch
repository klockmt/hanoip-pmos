sysctl: allow vm.swappiness up to 200

postmarketos-zram-swap sets vm.swappiness=180 for zram swap, and this
kernel rejected anything above 100 ("Invalid argument"), so its script
(set -e) stopped after swapon. The reclaim code already handles it:
file_prio is 200 - swappiness, so values up to 200 keep both priorities
non-negative. The tree had the 200 limit only behind CONFIG_OPLUS_MM_HACKS,
which also changes how direct reclaim scans; this raises the limit alone.

--- a/kernel/sysctl.c
+++ b/kernel/sysctl.c
@@ -135,8 +135,8 @@
 static int one_hundred = 100;
 #ifdef CONFIG_OPLUS_MM_HACKS
 extern int direct_vm_swappiness;
-static int two_hundred = 200;
 #endif /* CONFIG_OPLUS_MM_HACKS */
+static int two_hundred = 200;
 static int one_thousand = 1000;
 #ifdef CONFIG_SCHED_WALT
 static int two_million = 2000000;
@@ -1664,11 +1664,7 @@
 		.mode		= 0644,
 		.proc_handler	= proc_dointvec_minmax,
 		.extra1		= &zero,
-#ifdef CONFIG_OPLUS_MM_HACKS
-		.extra2         = &two_hundred,
-#else
-		.extra2		= &one_hundred,
-#endif /* CONFIG_OPLUS_MM_HACKS */
+		.extra2		= &two_hundred,
 	},
 #ifdef CONFIG_OPLUS_MM_HACKS
 	{
