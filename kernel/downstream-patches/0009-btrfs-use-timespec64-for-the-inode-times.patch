btrfs: use timespec64 for the inode times

This tree keeps the inode times in struct timespec64 and current_time()
returns one, but fs/btrfs still declared struct timespec in two places,
so turning CONFIG_BTRFS_FS on stopped at fs/btrfs/inode.c with
"initializing 'struct timespec' with an expression of incompatible type
'struct timespec64'". The same change the btrfs code got upstream when
the inode times moved to timespec64.

--- a/fs/btrfs/file.c
+++ b/fs/btrfs/file.c
@@ -2737,7 +2737,7 @@
 		 * for detecting, at fsync time, if the inode isn't yet in the
 		 * log tree or it's there but not up to date.
 		 */
-		struct timespec now = current_time(inode);
+		struct timespec64 now = current_time(inode);
 
 		inode_inc_iversion(inode);
 		inode->i_mtime = now;
--- a/fs/btrfs/inode.c
+++ b/fs/btrfs/inode.c
@@ -6624,7 +6624,7 @@
 	 * values (the ones it had when the fsync was done).
 	 */
 	if (!test_bit(BTRFS_FS_LOG_RECOVERING, &root->fs_info->flags)) {
-		struct timespec now = current_time(&parent_inode->vfs_inode);
+		struct timespec64 now = current_time(&parent_inode->vfs_inode);
 
 		parent_inode->vfs_inode.i_mtime = now;
 		parent_inode->vfs_inode.i_ctime = now;
