From c923ee08990ce67f53fd3cb801b81e683383f17d Mon Sep 17 00:00:00 2001
From: Aleks <aleks.spv@gmail.com>
Date: Wed, 21 Oct 2026 11:02:40 +0600
Subject: [PATCH 148/194] arm64: dts: qcom: sm7150-xiaomi-sweet: Add WCD9370
 and microphone capture

The analog microphones are connected to a WCD9370 codec on the LPASS
SoundWire buses. Enable the LPASS macros and SoundWire masters, add the
codec and a TX_CODEC_DMA_TX_3 capture link fed by ADC1 on MultiMedia2.

The TX port mapping comes from the downstream qcom,swr-port-mapping:
WCD TX ports 1-4 sit on master ports 2-5.

Signed-off-by: Aleks <aleks.spv@gmail.com>
---
 .../boot/dts/qcom/sm7150-xiaomi-sweet.dts     | 96 ++++++++++++++++++-
 1 file changed, 95 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm7150-xiaomi-sweet.dts b/arch/arm64/boot/dts/qcom/sm7150-xiaomi-sweet.dts
index ac6a37df5..f99f055a1 100644
--- a/arch/arm64/boot/dts/qcom/sm7150-xiaomi-sweet.dts
+++ b/arch/arm64/boot/dts/qcom/sm7150-xiaomi-sweet.dts
@@ -84,7 +84,11 @@ sound {
 		audio-routing = "Speaker Spk", "Speaker DAC Output",
 				"Microphone Spk", "Microphone DAC Output",
 				"Speaker AIF_RX", "PRI_MI2S_RX",
-				"Microphone AIF_RX", "PRI_MI2S_RX";
+				"Microphone AIF_RX", "PRI_MI2S_RX",
+				"AMIC1", "MIC BIAS1",
+				"AMIC2", "MIC BIAS2",
+				"AMIC3", "MIC BIAS3",
+				"TX SWR_ADC0", "ADC1_OUTPUT";
 
 		mm1-dai-link {
 			link-name = "MultiMedia1";
@@ -93,6 +97,13 @@ cpu {
 			};
 		};
 
+		mm2-dai-link {
+			link-name = "MultiMedia2";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
+			};
+		};
+
 		speaker_playback_dai {
 			link-name = "Primary Spkr Playback";
 			cpu {
@@ -107,6 +118,21 @@ codec {
 				sound-dai = <&speaker_amp>, <&mic_amp>;
 			};
 		};
+
+		mic_capture_dai {
+			link-name = "WCD937x Capture";
+			cpu {
+				sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&wcd9370 1>, <&swr_tx 0>, <&txmacro 0>;
+			};
+		};
 	};
 
 	vreg_ibb: regulator-ibb {
@@ -133,6 +159,30 @@ vreg_ts_vddio: regulator-ts-vddio {
 		regulator-boot-on;
 		startup-delay-us = <4000>;
 	};
+
+	wcd9370: audio-codec {
+		compatible = "qcom,wcd9370-codec";
+		pinctrl-0 = <&wcd9375_reset_active>;
+		pinctrl-names = "default";
+
+		reset-gpios = <&lpass_tlmm 6 GPIO_ACTIVE_LOW>;
+
+		vdd-buck-supply = <&vreg_l15a_1p8>;
+		vdd-rxtx-supply = <&vreg_l10a_1p8>;
+		vdd-px-supply = <&vreg_l10a_1p8>;
+		vdd-mic-bias-supply = <&vreg_bob>;
+
+		qcom,micbias1-microvolt = <2750000>;
+		qcom,micbias2-microvolt = <2750000>;
+		qcom,micbias3-microvolt = <2750000>;
+		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000
+							  500000 500000 500000 500000>;
+
+		qcom,rx-device = <&wcd937x_rx>;
+		qcom,tx-device = <&wcd937x_tx>;
+
+		#sound-dai-cells = <1>;
+	};
 };
 
 &dispcc {
@@ -238,12 +288,20 @@ qi2s@16 {
 		reg = <PRIMARY_MI2S_RX>;
 		qcom,sd-lines = <0>;
 	};
+
+	dai@120 {
+		reg = <TX_CODEC_DMA_TX_3>;
+	};
 };
 
 &q6asmdai {
 	dai@0 {
 		reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
 	};
+
+	dai@1 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>;
+	};
 };
 
 &remoteproc_adsp {
@@ -258,10 +316,38 @@ &remoteproc_mpss {
 	firmware-name = "qcom/sm7150/xiaomi/sweet/modem.mbn";
 };
 
+&rxmacro {
+	status = "okay";
+};
+
 &sdhc_2 {
 	status = "okay";
 };
 
+&swr_rx {
+	status = "okay";
+
+	wcd937x_rx: codec@0,4 {
+		compatible = "sdw20217010a00";
+		reg = <0 4>;
+		qcom,rx-port-mapping = <1 2 3 4 5>;
+		qcom,rx-channel-mapping = /bits/ 8 <1 2 1 1 2 1 1 2>;
+		#sound-dai-cells = <1>;
+	};
+};
+
+&swr_tx {
+	status = "okay";
+
+	wcd937x_tx: codec@0,3 {
+		compatible = "sdw20217010a00";
+		reg = <0 3>;
+		qcom,tx-port-mapping = <2 3 4 5>;
+		qcom,tx-channel-mapping = /bits/ 8 <1 1 2 1 2 3 3 4 1 2 3 4>;
+		#sound-dai-cells = <1>;
+	};
+};
+
 &tlmm {
 	amp_t_int_default: amp-t-int-default-state {
 		pins = "gpio93";
@@ -280,10 +366,18 @@ amp_b_int_default: amp-b-int-default-state {
 	};
 };
 
+&txmacro {
+	status = "okay";
+};
+
 &uart8 {
 	status = "disabled";
 };
 
+&vamacro {
+	status = "okay";
+};
+
 &venus {
 	firmware-name = "qcom/sm7150/xiaomi/sweet/venus.mbn";
 };
-- 
2.43.0

