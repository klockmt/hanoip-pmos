diff --git a/arch/arm64/boot/dts/qcom/sm7150-motorola-hanoip-wifi-diagnostic.dts b/arch/arm64/boot/dts/qcom/sm7150-motorola-hanoip-wifi-diagnostic.dts
new file mode 100644
index 000000000..2728173f4
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm7150-motorola-hanoip-wifi-diagnostic.dts
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include <dt-bindings/firmware/qcom,scm.h>
+#include "sm7150-motorola-hanoip-ufs-local-diagnostic.dts"
+
+/*
+ * Wi-Fi bring-up: start the modem (it hosts the WCN3990 WLAN firmware) and
+ * give rmtfs a fixed buffer. Android allocates rmtfs dynamically; this range
+ * is plain RAM there (outside removed_region and every firmware carve-out).
+ * rmtfs runs file-backed and read-only (-o /run/efs -r): EFS never touches UFS.
+ */
+&reserved_memory {
+	rmtfs_mem: memory@9a000000 {
+		compatible = "qcom,rmtfs-mem";
+		reg = <0x0 0x9a000000 0x0 0x202000>;
+		no-map;
+
+		qcom,client-id = <1>;
+		qcom,vmid = <QCOM_SCM_VMID_MSS_MSA>;
+		qcom,use-guard-pages;
+	};
+};
+
+&remoteproc_mpss {
+	firmware-name = "qcom/sm7150/motorola/hanoip/modem.mdt";
+	status = "okay";
+};
+
+/*
+ * As on Android (ipa_fws loaded by the AP), the AP loads the IPA GSI
+ * firmware from the modem partition before the modem starts. Without IPA
+ * the modem aborted ~1.5 s after boot (EX:kernel tmr_slave1), with or
+ * without ath10k loaded.
+ */
+&ipa {
+	qcom,gsi-loader = "self";
+	memory-region = <&ipa_fw_mem>;
+	firmware-name = "qcom/sm7150/motorola/hanoip/ipa_fws.mdt";
+	status = "okay";
+};
+
+/*
+ * The WCN3990 copy-engine interrupts are pulses: Android configures them as
+ * edge. Declared level-high, no CE interrupt ever reached the CPU (HTC ready
+ * only arrived by polling and the HTT connect timed out).
+ */
+&wifi {
+	interrupts = <GIC_SPI 414 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 415 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 416 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 417 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 418 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 419 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 420 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 421 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 422 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 423 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 424 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 425 IRQ_TYPE_EDGE_RISING>;
+};
diff --git a/arch/arm64/boot/dts/qcom/sm7150-motorola-hanoip.dts b/arch/arm64/boot/dts/qcom/sm7150-motorola-hanoip.dts
new file mode 100755
index 000000000..e037f443f
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm7150-motorola-hanoip.dts
@@ -0,0 +1,905 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Motorola Moto G60 (hanoip) - SM7150 (sdmmagpie)
+ *
+ * Copyright (c) 2026, hanoip-uboot port
+ *
+ * Based on the sm7150-google-sunfish.dts by:
+ * Copyright (c) 2023-2024, Connor Mitchell <c.dog29@hotmail.com>
+ * Copyright (c) 2025, Danila Tikhonov <danila@jiaxyga.com>
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/firmware/qcom,scm.h>
+#include <dt-bindings/clock/qcom,sm7150-gcc.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/usb/pd.h>
+
+#include "sm7150.dtsi"
+#include "pm6150.dtsi"
+#include "pm6150l.dtsi"
+
+/* RAM física do hanoip: base 0x80000000, fim 0x17dd00000 (~3.96GB).
+ * O sm7150.dtsi deixa size=0 esperando o ABL preencher via external FDT,
+ * mas fixamos aqui com o valor real do device (iomem do kernel).
+ * NOTA: NÃO usar 4GB cheio (0x100000000) - o fim real é 0x17dd00000,
+ * os últimos ~35MB são reservados para firmware.
+ */
+&{/memory@80000000} {
+	device_type = "memory";
+	reg = <0x0 0x80000000 0x0 0xfdd00000>;
+};
+
+/* Hanoip uses SDMMAGPIE firmware modes, not the ATOLL domain modes. */
+&cluster_sleep_cx_ret {
+	arm,psci-suspend-param = <0x41002244>;
+};
+
+&cluster_aoss_sleep {
+	arm,psci-suspend-param = <0x4100c244>;
+};
+
+/ {
+	model = "Motorola Moto G60";
+	compatible = "motorola,hanoip", "qcom,sm7150";
+	chassis-type = "handset";
+
+	aliases {
+		bluetooth0 = &bluetooth;
+		hsuart0 = &uart3;
+		serial0 = &uart8;
+		wifi0 = &wifi;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		stdout-path = "serial0:115200n8";
+		bootargs = "earlycon=msm_geni_serial,0xa88000 console=ttyMSM0,115200n8 console=ttyGS0 console=tty1 console=ramoops loglevel=8 ignore_loglevel panic_on_oops=1 panic=5 pstore.backend=ramoops";
+
+		framebuffer@9c000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0x9c000000 0x0 (1080 * 2460 * 4)>;
+			width = <1080>;
+			height = <2460>;
+			stride = <(1080 * 4)>;
+			format = "a8r8g8b8";
+
+			clocks = <&gcc GCC_DISP_HF_AXI_CLK>;
+		};
+	};
+
+	gpio_keys: gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&vol_up_n>;
+		pinctrl-names = "default";
+
+		key-volume-up {
+			label = "Volume Up";
+			gpios = <&pm6150l_gpios 2 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	reserved-memory {
+		/* The SoC entry reserves the same DFPS range under a stale name. */
+		/delete-node/ dfps-data@9e300000;
+
+		/* cont_splash e dfps: framebuffer do ABL - SEM no-map (o sm7150.dtsi ja tem os demais) */
+		cont_splash_mem: cont-splash@9c000000 {
+			reg = <0x0 0x9c000000 0x0 0x01700000>;
+			label = "cont_splash_region";
+		};
+
+		dfps-data@9d700000 {
+			reg = <0x0 0x9d700000 0x0 0x00100000>;
+			label = "dfps_data_region";
+		};
+
+		ramoops_mem: ramoops@9d800000 {
+			compatible = "ramoops";
+			reg = <0x0 0x9d800000 0x0 0x400000>;
+
+			record-size = <0x80000>;
+			pmsg-size = <0x200000>;
+			console-size = <0x100000>;
+		};
+	};
+
+	vph_pwr: regulator-vph-pwr {
+		compatible = "regulator-fixed";
+
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	vreg_ibb: regulator-ibb {
+		compatible = "regulator-fixed";
+
+		regulator-name = "ibb";
+		/* IBB / AVEE: -5.5V (downstream hanoi-panel.dtsi)
+		 * PLACEHOLDER - o LCDB real (pm6150l_lcdb) nao esta pronto.
+		 * NAO usar este valor para hardware real ate o LCDB ser portado.
+		 */
+		regulator-min-microvolt = <5500000>;
+		regulator-max-microvolt = <5500000>;
+	};
+
+	vreg_lab: regulator-lab {
+		compatible = "regulator-fixed";
+
+		regulator-name = "lab";
+		/* LAB / AVDD: +5.5V (downstream hanoi-panel.dtsi)
+		 * PLACEHOLDER - o LCDB real (pm6150l_lcdb) nao esta pronto.
+		 * NAO usar este valor para hardware real ate o LCDB ser portado.
+		 */
+		regulator-min-microvolt = <5500000>;
+		regulator-max-microvolt = <5500000>;
+	};
+
+	// S3A is really mx.lvl but it's there for supply map completeness sake.
+	vreg_s3a_0p8: regulator-smpa3 {
+		compatible = "regulator-fixed";
+
+		regulator-name = "vreg_s3a_0p8";
+		regulator-min-microvolt = <800000>;
+		regulator-max-microvolt = <800000>;
+
+		regulator-always-on;
+		vin-supply = <&vph_pwr>;
+	};
+};
