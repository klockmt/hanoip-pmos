diff --git a/arch/arm64/boot/dts/qcom/sm7150-motorola-hanoip-battery-diagnostic.dts b/arch/arm64/boot/dts/qcom/sm7150-motorola-hanoip-battery-diagnostic.dts
new file mode 100644
index 000000000..a57b519b8
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm7150-motorola-hanoip-battery-diagnostic.dts
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "sm7150-motorola-hanoip-gpu-diagnostic.dts"
+
+/* RAM diagnostic: battery telemetry and passive SMB5 monitoring only. */
+/ {
+	chosen {
+		bootargs = "earlycon=msm_geni_serial,0xa88000 console=ttyMSM0,115200n8 console=ttyGS0 console=ramoops loglevel=8 ignore_loglevel panic_on_oops=1 panic=5 pause_on_oops=5 pstore.backend=ramoops clk_ignore_unused consoleblank=0 vt.global_cursor_default=0";
+	};
+
+	hanoip_battery: battery {
+		compatible = "simple-battery";
+		device-chemistry = "lithium-ion";
+		/* Observed Android BMS design values for the ATL 6000 mAh pack. */
+		voltage-min-design-microvolt = <3200000>;
+		voltage-max-design-microvolt = <4450000>;
+		charge-full-design-microamp-hours = <6174000>;
+		constant-charge-current-max-microamp = <3600000>;
+	};
+};
+
+&pm6150_charger {
+	/* This diagnostic compatible skips all charger/Type-C setup writes. */
+	compatible = "motorola,hanoip-smb5-monitor";
+	monitored-battery = <&hanoip_battery>;
+	status = "okay";
+};
+
+&pm6150_qgauge {
+	monitored-battery = <&hanoip_battery>;
+	power-supplies = <&pm6150_charger>;
+	status = "okay";
+};
+
+&pm6150_qg_sdam {
+	read-only;
+};
diff --git a/arch/arm64/boot/dts/qcom/sm7150-motorola-hanoip-cpu8-diagnostic.dts b/arch/arm64/boot/dts/qcom/sm7150-motorola-hanoip-cpu8-diagnostic.dts
new file mode 100644
index 000000000..3c05b777b
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm7150-motorola-hanoip-cpu8-diagnostic.dts
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "sm7150-motorola-hanoip-wifi-diagnostic.dts"
+
+/*
+ * Boot all eight CPUs. With maxcpus=6 the Cortex-A76 cores could not be
+ * onlined later: the system capabilities were finalized on the A55 cluster
+ * alone and CPU6 was refused ("Detected conflict for capability 80
+ * (Spectre-v2)"). idle=poll is dropped as well; arm64 does not know it.
+ */
+/ {
+	chosen {
+		bootargs = "earlycon=msm_geni_serial,0xa88000 console=ttyMSM0,115200n8 console=ttyGS0 console=ramoops console=tty1 loglevel=8 ignore_loglevel panic_on_oops=1 panic=5 pause_on_oops=5 pstore.backend=ramoops clk_ignore_unused consoleblank=0 vt.global_cursor_default=0";
+	};
+};
