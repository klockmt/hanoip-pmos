From 993ec3160edcbb633073fd35adb0e26320d501e2 Mon Sep 17 00:00:00 2001
From: hanoip <hanoip@localhost>
Date: Thu, 29 Oct 2026 18:20:56 +0000
Subject: [PATCH 191/194] media: qcom: camss: sm7150: give every CSIPHY the
 stock clock set

The vendor DT feeds each SM7150 CSIPHY from cphy_rx_clk_src at 400 MHz,
csiphy0_clk, its own csiphyN_clk and the 300 MHz timer. Mainline only
listed csiphyN and its timer for PHY1/PHY2, and the PHY0 table let the
csiphy0 rate request drag cphy_rx down to 300 MHz. Without the full set
PHY1 and PHY3 never delivered a frame (OV02B1B, S5K4H7 on hanoip).
Use the same clock list for the four PHYs and vote cphy_rx at 400 MHz.
---
 .../media/platform/qcom/camss/camss-csiphy.c  |  8 +++++
 drivers/media/platform/qcom/camss/camss.c     | 33 +++++++++++--------
 2 files changed, 28 insertions(+), 13 deletions(-)

diff --git a/drivers/media/platform/qcom/camss/camss-csiphy.c b/drivers/media/platform/qcom/camss/camss-csiphy.c
index 7e4edd48f..21f29a578 100644
--- a/drivers/media/platform/qcom/camss/camss-csiphy.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy.c
@@ -153,6 +153,14 @@ static int csiphy_set_clock_rates(struct csiphy_device *csiphy)
 	for (i = 0; i < csiphy->nclocks; i++) {
 		struct camss_clock *clock = &csiphy->clock[i];
 
+		/* SM7150: stock votes cphy_rx at 400 MHz for every CSIPHY. */
+		if (csiphy->camss->res->version == CAMSS_7150 &&
+		    !strcmp(clock->name, "cphy_rx_src")) {
+			ret = clk_set_rate(clock->clk, 400000000);
+			if (ret < 0)
+				return ret;
+		}
+
 		if (csiphy->rate_set[i]) {
 			u64 min_rate = link_freq / 4;
 			long round_rate;
