From 117d1fece8acb6ea93ce864c739199b96cef7001 Mon Sep 17 00:00:00 2001
From: Aleks <aleks.spv@gmail.com>
Date: Wed, 21 Oct 2026 11:30:19 +0600
Subject: [PATCH 149/194] ASoC: codecs: wcd937x: Survive card rebind after ADSP
 restart

When the ADSP crashes and restarts, the sound card is torn down and
bound again while the LPASS SoundWire bus may still be down.

Return -EPROBE_DEFER when the codec cannot be runtime resumed yet, so
the bind is retried once the DSP services are back. Treat an MBHC init
failure as non-fatal: it only provides headset detection, and failing
the probe after the PDM watchdog irqs were requested leaks them, so
every later bind fails with -EBUSY.

Signed-off-by: Aleks <aleks.spv@gmail.com>
---
 sound/soc/codecs/wcd937x.c | 27 ++++++++++++++++++++++-----
 1 file changed, 22 insertions(+), 5 deletions(-)

diff --git a/sound/soc/codecs/wcd937x.c b/sound/soc/codecs/wcd937x.c
index cc7344b2f..98be15399 100644
--- a/sound/soc/codecs/wcd937x.c
+++ b/sound/soc/codecs/wcd937x.c
@@ -2037,7 +2037,11 @@ static void wcd937x_mbhc_deinit(struct snd_soc_component *component)
 {
 	struct wcd937x_priv *wcd937x = snd_soc_component_get_drvdata(component);
 
+	if (!wcd937x->wcd_mbhc)
+		return;
+
 	wcd_mbhc_deinit(wcd937x->wcd_mbhc);
+	wcd937x->wcd_mbhc = NULL;
 }
 
 /* END MBHC */
@@ -2504,8 +2508,11 @@ static int wcd937x_soc_codec_probe(struct snd_soc_component *component)
 
 	snd_soc_component_init_regmap(component, wcd937x->regmap);
 	ret = pm_runtime_resume_and_get(dev);
-	if (ret < 0)
-		return ret;
+	if (ret < 0) {
+		/* The SoundWire bus is still down while the ADSP restarts */
+		dev_err(dev, "runtime resume failed (%d), deferring\n", ret);
+		return -EPROBE_DEFER;
+	}
 
 	chipid = (snd_soc_component_read(component,
 					 WCD937X_DIGITAL_EFUSE_REG_0) & 0x1e) >> 1;
@@ -2578,10 +2585,17 @@ static int wcd937x_soc_codec_probe(struct snd_soc_component *component)
 	}
 
 	ret = wcd937x_mbhc_init(component);
-	if (ret)
-		dev_err(component->dev, "mbhc initialization failed\n");
+	if (ret) {
+		/*
+		 * MBHC is only headset detection. Failing here leaks the PDM
+		 * watchdog irqs requested above and every later rebind of the
+		 * card after an ADSP restart fails with -EBUSY.
+		 */
+		dev_err(component->dev, "mbhc initialization failed (%d), no jack detection\n", ret);
+		wcd937x->wcd_mbhc = NULL;
+	}
 
-	return ret;
+	return 0;
 }
 
 static void wcd937x_soc_codec_remove(struct snd_soc_component *component)
@@ -2602,6 +2616,9 @@ static int wcd937x_codec_set_jack(struct snd_soc_component *comp,
 	struct wcd937x_priv *wcd = dev_get_drvdata(comp->dev);
 	int ret = 0;
 
+	if (!wcd->wcd_mbhc)
+		return -ENOTSUPP;
+
 	if (jack)
 		ret = wcd_mbhc_start(wcd->wcd_mbhc, &wcd->mbhc_cfg, jack);
 	else
