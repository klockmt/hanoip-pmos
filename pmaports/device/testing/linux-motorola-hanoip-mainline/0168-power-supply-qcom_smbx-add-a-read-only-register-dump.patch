From f9cbf4e35f5bfce44224efebe924fd6c32e0f420 Mon Sep 17 00:00:00 2001
From: hanoip <h@l>
Date: Tue, 27 Oct 2026 12:07:13 -0300
Subject: [PATCH 168/194] power: supply: qcom_smbx: add a read-only register
 dump for the hanoip monitor

The hanoip port runs this driver with monitor_only=1, so the charger setup
sequence is skipped on purpose and the hardware keeps whatever the bootloader
left. Before enabling charging we need to see why it never starts: read the
registers that decide it (CHARGING_ENABLE_CMD, CHGR_CFG2, FLOAT_VOLTAGE_CFG,
USBIN_CMD_IL, JEITA_EN_CFG, APSD, watchdog, ICL and power path).

Expose them through /sys/kernel/debug/<chip name> with mode 0444. The file
only reads; no write path is added.
---
 drivers/power/supply/qcom_smbx.c | 78 ++++++++++++++++++++++++++++++++
 1 file changed, 78 insertions(+)

diff --git a/drivers/power/supply/qcom_smbx.c b/drivers/power/supply/qcom_smbx.c
index aec531949..accd02594 100644
--- a/drivers/power/supply/qcom_smbx.c
+++ b/drivers/power/supply/qcom_smbx.c
@@ -9,6 +9,7 @@
  */
 
 #include <linux/bits.h>
+#include <linux/debugfs.h>
 #include <linux/devm-helpers.h>
 #include <linux/iio/consumer.h>
 #include <linux/interrupt.h>
@@ -1064,6 +1065,79 @@ static void smb_monitor_work(struct work_struct *work)
 	schedule_delayed_work(&chip->status_change_work, msecs_to_jiffies(10000));
 }
 
+#ifdef CONFIG_DEBUG_FS
+/*
+ * Diagnostic, READ-ONLY view of the charger block.
+ *
+ * The hanoip port deliberately runs this driver in monitor_only mode: the
+ * whole charger/Type-C setup sequence is skipped, so the state left by the
+ * bootloader is what we see. To find out what is missing before enabling
+ * charging (docs/PLANO-BATERIA-ENERGIA.md, phase B0) we need to read the
+ * registers that decide it. Nothing here writes.
+ */
+static const struct {
+	u16 reg;
+	const char *name;
+} smb_dump_regs[] = {
+	{ 0x06, "BATTERY_CHARGER_STATUS_1" },
+	{ 0x07, "BATTERY_CHARGER_STATUS_2" },
+	{ 0x0a, "BATTERY_CHARGER_STATUS_4" },
+	{ 0x0d, "BATTERY_CHARGER_STATUS_7" },
+	{ 0x42, "CHARGING_ENABLE_CMD" },
+	{ 0x51, "CHGR_CFG2" },
+	{ 0x60, "PRE_CHARGE_CURRENT_CFG" },
+	{ 0x61, "FAST_CHARGE_CURRENT_CFG" },
+	{ 0x70, "FLOAT_VOLTAGE_CFG" },
+	{ 0x7d, "FG_UPDATE_CFG_2_SEL" },
+	{ 0x90, "JEITA_EN_CFG" },
+	{ 0x307, "APSD_STATUS" },
+	{ 0x308, "APSD_RESULT_STATUS" },
+	{ 0x310, "INT_RT_STS" },
+	{ 0x340, "USBIN_CMD_IL" },
+	{ 0x358, "TYPE_C_CFG" },
+	{ 0x370, "USBIN_CURRENT_LIMIT_CFG" },
+	{ 0x380, "USBIN_AICL_OPTIONS_CFG" },
+	{ 0x643, "BARK_BITE_WDOG_PET" },
+	{ 0x651, "WD_CFG" },
+	{ 0x653, "SNARL_BARK_BITE_WD_CFG" },
+};
+
+static int smb_regs_show(struct seq_file *s, void *unused)
+{
+	struct smb_chip *chip = s->private;
+	unsigned int i, val;
+
+	seq_printf(s, "%s: base=0x%x gen=%s monitor_only=%u\n\n",
+		   chip->name, chip->base, chip->gen == SMB2 ? "SMB2" : "SMB5",
+		   chip->monitor_only);
+
+	for (i = 0; i < ARRAY_SIZE(smb_dump_regs); i++) {
+		if (regmap_read(chip->regmap, chip->base + smb_dump_regs[i].reg,
+				&val))
+			seq_printf(s, "0x%04x %-32s leitura falhou\n",
+				   smb_dump_regs[i].reg, smb_dump_regs[i].name);
+		else
+			seq_printf(s, "0x%04x %-32s 0x%02x\n",
+				   smb_dump_regs[i].reg, smb_dump_regs[i].name, val);
+	}
+
+	seq_puts(s, "\n-- derivados --\n");
+	if (!smb_get_current_limit(chip, &val))
+		seq_printf(s, "limite de entrada (ICL) = %u uA\n", val);
+	if (!regmap_read(chip->regmap, chip->base + POWER_PATH_STATUS(chip), &val))
+		seq_printf(s, "POWER_PATH_STATUS       = 0x%02x\n", val);
+	if (!regmap_read(chip->regmap, chip->base + USBIN_CMD_IL, &val))
+		seq_printf(s, "USBIN suspenso          = %u\n",
+			   !!(val & USBIN_SUSPEND_BIT));
+	if (!regmap_read(chip->regmap, chip->base + CHARGING_ENABLE_CMD, &val))
+		seq_printf(s, "charging enable         = %u\n",
+			   !!(val & CHARGING_ENABLE_CMD_BIT));
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(smb_regs);
+#endif /* CONFIG_DEBUG_FS */
+
 static int smb_probe(struct platform_device *pdev)
 {
 	struct power_supply_config supply_config = {};
@@ -1138,6 +1212,10 @@ static int smb_probe(struct platform_device *pdev)
 		return dev_err_probe(chip->dev, PTR_ERR(chip->chg_psy),
 				     "failed to register power supply\n");
 
+#ifdef CONFIG_DEBUG_FS
+	debugfs_create_file(chip->name, 0444, NULL, chip, &smb_regs_fops);
+#endif
+
 	if (match_data->monitor_only) {
 		rc = devm_delayed_work_autocancel(chip->dev, &chip->status_change_work,
 						  smb_monitor_work);
-- 
2.43.0

