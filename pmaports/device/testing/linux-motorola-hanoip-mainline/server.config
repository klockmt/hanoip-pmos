# Options the server needs on top of kernel/mainline/config-7.3-hanoip; scripts/build-mainline-kernel merges this file
# and fails if any line is missing from the final .config.
# The hardware watchdog (APSS, 17c10000): an unfed /dev/watchdog resets the phone back to the bootloader
# (docs/MAINLINE.md, section 7).
CONFIG_QCOM_WDT=y
CONFIG_WATCHDOG_SYSFS=y
