# Linux 7.3 for the Moto G60 (hanoip): kernel.org's linux-7.3 plus this project's patches (kernel/mainline/patches),
# configured with kernel/mainline/config-7.3-hanoip plus kernel/mainline/server.config, and the out-of-tree
# hanoip_mmi_unit_info module (SMEM item 134: without it the modem crashes and there is no Wi-Fi). It builds the same
# source trees as scripts/build-mainline-kernel, each checked by its git hash, from copies identical to kernel/mainline
# (scripts/test-mainline-kernel-package). GCC, like the build that booted on the phone. It installs what Duranium's
# image build takes: the EFI kernel (EFI_ZBOOT) as /boot/vmlinuz, the DTB under /boot/dtbs and the modules in /usr.
pkgname=linux-motorola-hanoip-mainline
pkgver=7.3
pkgrel=1
pkgdesc="Motorola Moto G (60) mainline kernel (Linux 7.3 and this project's patches)"
arch="aarch64"
_carch="arm64"
_flavor="motorola-hanoip-mainline"
url="https://www.kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	diffutils
	elfutils-dev
	findutils
	flex
	git
	gmp-dev
	kmod
	linux-headers
	mpc1-dev
	mpfr-dev
	openssl-dev
	perl
	python3
	sed
	xz
	zstd
"

