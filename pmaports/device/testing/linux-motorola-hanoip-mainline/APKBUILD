builddir="$srcdir/linux-$pkgver"

# Every make goes through here: LOCALVERSION= keeps the release 7.3.0-sm7150 (in a git tree it would get a "+", and
# the modules would sit where the kernel does not look), and the banner must not carry this PC's user or host name.
_make() { KBUILD_BUILD_USER=hanoip KBUILD_BUILD_HOST=hanoip-build make ARCH="$_carch" LOCALVERSION= "$@"; }
_git() { git -c user.name=hanoip -c user.email=hanoip@localhost -c core.autocrlf=false "$@"; }

prepare() {
	# Not default_prepare, which would apply the patches with patch -p1: git am them, as scripts/build-mainline-kernel
	# does, and check the tree before and after.
	_git init -q
	_git add -A -f .
	_git commit -q -m "v$pkgver (linux-$pkgver.tar.xz)"
	[ "$(git rev-parse 'HEAD^{tree}')" = "$_base_tree" ] || die "the source is not tag v$pkgver's tree ($_base_tree)"
	_git am -q $(ls "$srcdir"/*.patch | LC_ALL=C sort)
	[ "$(git rev-parse 'HEAD^{tree}')" = "$_tree" ] || die "the patched tree is not the one that booted ($_tree)"

	# The fragment's lines come last and win (kconfig warns "override"). merge_config.sh needs GNU mktemp, readlink and
	# cp, which the chroot may not have; the .config this gives is byte-identical to the script's (checked 2026-11-08).
	cat "$srcdir"/config-7.3-hanoip "$srcdir"/server.config > .config
	_make olddefconfig >/dev/null
	_lost=$(grep '^CONFIG_' "$srcdir"/server.config | grep -vxF -f .config || true)
	[ -z "$_lost" ] || die "did not survive olddefconfig: $_lost"

	mkdir -p "$srcdir"/hanoip-extra
	cp "$srcdir"/Kbuild "$srcdir"/hanoip_mmi_unit_info.c "$srcdir"/hanoip-extra/
}

build() {
	unset LDFLAGS
	_make Image vmlinuz.efi modules qcom/sm7150-motorola-hanoip.dtb
	_make M="$srcdir"/hanoip-extra modules
}

package() {
	_krel=$(cat include/config/kernel.release)
	install -Dm644 arch/arm64/boot/vmlinuz.efi "$pkgdir"/boot/vmlinuz
	install -Dm644 arch/arm64/boot/dts/qcom/sm7150-motorola-hanoip.dtb \
		"$pkgdir"/boot/dtbs/qcom/sm7150-motorola-hanoip.dtb
	_make INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1 DEPMOD=true modules_install
	_make M="$srcdir"/hanoip-extra INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1 INSTALL_MOD_DIR=extra \
		DEPMOD=true modules_install
	rm -f "$pkgdir"/usr/lib/modules/"$_krel"/build
	depmod -b "$pkgdir"/usr "$_krel"
	install -Dm644 include/config/kernel.release "$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

