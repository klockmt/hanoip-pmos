From cbaa0d799bef2f37a785c8bd7f13a6edefa92b20 Mon Sep 17 00:00:00 2001
From: Danila Tikhonov <danila@jiaxyga.com>
Date: Sat, 2 Mar 2024 14:09:01 +0300
Subject: [PATCH 061/194] dts: am7150-xiaomi-common: enable QGauge add
 simple-battery

Signed-off-by: Danila Tikhonov <danila@jiaxyga.com>
---
 arch/arm64/boot/dts/qcom/sm7150-xiaomi-common.dtsi | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7150-xiaomi-common.dtsi b/arch/arm64/boot/dts/qcom/sm7150-xiaomi-common.dtsi
index 72ebfcf7d..41f163a9e 100644
--- a/arch/arm64/boot/dts/qcom/sm7150-xiaomi-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7150-xiaomi-common.dtsi
@@ -32,6 +32,13 @@ aliases {
 		wifi0 = &wifi;
 	};
 
+	battery: battery {
+		compatible = "simple-battery";
+
+		voltage-min-design-microvolt = <3400000>;
+		voltage-max-design-microvolt = <4400000>;
+	};
+
 	chosen {
 		#address-cells = <2>;
 		#size-cells = <2>;
@@ -511,6 +518,11 @@ &mdss_dsi0_phy {
 	status = "okay";
 };
 
+&pm6150_qgauge {
+	monitored-battery = <&battery>;
+	status = "okay";
+};
+
 &pm6150_resin {
 	linux,code = <KEY_VOLUMEDOWN>;
 	status = "okay";
-- 
2.43.0

