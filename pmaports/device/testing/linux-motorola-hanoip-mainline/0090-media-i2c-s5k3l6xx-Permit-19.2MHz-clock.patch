From 437f5e2f314587f896af184fa5e6554abb780c07 Mon Sep 17 00:00:00 2001
From: Jens Reidel <adrian@travitia.xyz>
Date: Tue, 9 Apr 2024 09:08:23 +0200
Subject: [PATCH 090/194] media: i2c: s5k3l6xx: Permit 19.2MHz clock

Signed-off-by: Jens Reidel <adrian@travitia.xyz>
---
 drivers/media/i2c/s5k3l6xx.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/media/i2c/s5k3l6xx.c b/drivers/media/i2c/s5k3l6xx.c
index 8b6e0c3f3..15cd8779a 100644
--- a/drivers/media/i2c/s5k3l6xx.c
+++ b/drivers/media/i2c/s5k3l6xx.c
@@ -1438,7 +1438,7 @@ static int s5k3l6xx_probe(struct i2c_client *c)
 	/* The sensor supports between 6MHz and 32MHz,
 	 * but I can't properly test that.
 	 */
-	if ((mclk_freq < 25000000) || (mclk_freq > 25000000)) {
+	if ((mclk_freq < 19200000) || (mclk_freq > 25000000)) {
 		dev_err(&c->dev,
 			"External clock frequency out of range: %lu.\n",
 			mclk_freq);
-- 
2.43.0

