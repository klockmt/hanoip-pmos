diff --git a/drivers/media/i2c/s5k4h7.c b/drivers/media/i2c/s5k4h7.c
new file mode 100644
index 000000000..667aaabf3
--- /dev/null
+++ b/drivers/media/i2c/s5k4h7.c
@@ -0,0 +1,583 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung S5K4H7 8 MP sensor (hanoip rear wide/macro, slot 3).
+ *
+ * Bring-up driver: fixed 3264x2448 RAW10 mode from the vendor module tables.
+ * Samsung parts use 16-bit register addresses; the vendor dumps in
+ * s5k4h7-regs.h were generated by s5k4h7-tables.py from
+ * com.qti.sensormodule.qtech_mot_hanoip_s5k4h7.bin.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/media-entity.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define S5K4H7_REG_MODE_SELECT		0x0100
+#define S5K4H7_MODE_STREAMING		0x01
+#define S5K4H7_MODE_STANDBY		0x00
+/* SMIA/CCS layout: 0x0200 is fine integration, set only by the tables. */
+#define S5K4H7_REG_COARSE_INTEGRATION	0x0202
+#define S5K4H7_REG_FRAME_LENGTH		0x0340
+#define S5K4H7_REG_ANALOG_GAIN		0x0204
+#define S5K4H7_REG_CHIP_ID		0x0000
+#define S5K4H7_CHIP_ID			0x487b
+
+#define S5K4H7_WIDTH			3264
+#define S5K4H7_HEIGHT			2448
+/*
+ * Vendor PLL: 24 MHz / 6 * 136 = 544 MHz, vt_pix_clk_div 4, two pixel
+ * pipelines -> 272 MHz. With the table's 3580 x 2530 timing that is the
+ * 30.03 fps measured on the bus.
+ */
+#define S5K4H7_PIXEL_RATE		(272 * HZ_PER_MHZ)
+#define S5K4H7_LINK_FREQ		(366 * HZ_PER_MHZ)
+#define S5K4H7_ECLK_FREQ		(24 * HZ_PER_MHZ)
+#define S5K4H7_DATA_LANES		4
+#define S5K4H7_BITS_PER_SAMPLE		10
+#define S5K4H7_LINE_LENGTH		3580
+#define S5K4H7_FRAME_LENGTH		2530
+#define S5K4H7_EXPOSURE_MIN		4
+#define S5K4H7_EXPOSURE_MARGIN		4
+#define S5K4H7_GAIN_MIN			32
+#define S5K4H7_GAIN_MAX			512	/* 16x, code 32 = 1x */
+#define S5K4H7_GAIN_DEFAULT		32
+
+struct s5k4h7_reg {
+	u16 addr;
+	u8 val;
+};
+
+struct s5k4h7_reg16 {
+	u16 addr;
+	u16 val;
+};
+
+#include "s5k4h7-regs.h"
+
+struct s5k4h7 {
+	struct device *dev;
+	struct clk *eclk;
+	struct gpio_desc *rst_gpio;
+	struct regulator_bulk_data supplies[3];
+	struct v4l2_subdev subdev;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct mutex mutex;
+	struct v4l2_mbus_framefmt fmt;
+	struct v4l2_ctrl *exposure;
+	bool streaming;
+};
+
+static inline struct s5k4h7 *to_s5k4h7(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct s5k4h7, subdev);
+}
+
+static int s5k4h7_write(struct s5k4h7 *sensor, u16 addr, u16 val, bool wide)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&sensor->subdev);
+	u8 buf[4] = { addr >> 8, addr & 0xff, 0, 0 };
+	struct i2c_msg msg = { .addr = client->addr, .flags = 0,
+			       .len = wide ? 4 : 3, .buf = buf };
+
+	buf[2] = wide ? val >> 8 : val & 0xff;
+	if (wide)
+		buf[3] = val & 0xff;
+	return i2c_transfer(client->adapter, &msg, 1) == 1 ? 0 : -EIO;
+}
+
+static int s5k4h7_read(struct s5k4h7 *sensor, u16 addr, u16 *val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&sensor->subdev);
+	u8 wbuf[2] = { addr >> 8, addr & 0xff };
+	u8 rbuf[2] = { 0, 0 };
+	struct i2c_msg msgs[2] = {
+		{ .addr = client->addr, .flags = 0, .len = 2, .buf = wbuf },
+		{ .addr = client->addr, .flags = I2C_M_RD, .len = 2, .buf = rbuf },
+	};
+
+	if (i2c_transfer(client->adapter, msgs, 2) != 2)
+		return -EIO;
+	*val = (rbuf[0] << 8) | rbuf[1];
+	return 0;
+}
+
+static int s5k4h7_write_array(struct s5k4h7 *sensor,
+			      const struct s5k4h7_reg *regs, unsigned int n)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < n; i++) {
+		ret = s5k4h7_write(sensor, regs[i].addr, regs[i].val, false);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int s5k4h7_power_on(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k4h7 *sensor = to_s5k4h7(sd);
+	int ret;
+
+	gpiod_set_value_cansleep(sensor->rst_gpio, 1);
+	ret = regulator_bulk_enable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(sensor->eclk);
+	if (ret)
+		goto disable_regulators;
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(sensor->rst_gpio, 0);
+	msleep(20);
+	if (sensor->rst_gpio)
+		msleep(5);
+	return 0;
+
+disable_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+	return ret;
+}
+
+static int s5k4h7_power_off(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k4h7 *sensor = to_s5k4h7(sd);
+
+	gpiod_set_value_cansleep(sensor->rst_gpio, 1);
+	clk_disable_unprepare(sensor->eclk);
+	regulator_bulk_disable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+	return 0;
+}
+
+static int s5k4h7_log_id(struct s5k4h7 *sensor)
+{
+	u16 id = 0, mode = 0xffff;
+	int ret;
+
+	ret = s5k4h7_read(sensor, S5K4H7_REG_CHIP_ID, &id);
+	if (ret)
+		return ret;
+	s5k4h7_read(sensor, S5K4H7_REG_MODE_SELECT, &mode);
+	/* Not a hard failure yet: the ID is recorded for bring-up analysis. */
+	dev_info(sensor->dev, "chip id 0x%04x, mode 0x%04x\n", id, mode);
+	return 0;
+}
+
+
+/* The sensor ignores mode tables unless it has reached software standby. */
+static int s5k4h7_enter_standby(struct s5k4h7 *sensor)
+{
+	unsigned int i;
+	u16 status = 0;
+	int ret;
+
+	ret = s5k4h7_write(sensor, S5K4H7_REG_MODE_SELECT,
+			   S5K4H7_MODE_STANDBY, false);
+	if (ret)
+		return ret;
+	for (i = 0; i < 100; i++) {
+		if (!s5k4h7_read(sensor, 0x0005, &status) && (status >> 8) == 0xff)
+			break;
+		usleep_range(1000, 1500);
+	}
+	if ((status >> 8) != 0xff)
+		dev_warn(sensor->dev, "sensor did not report standby (0x%04x)\n",
+			 status);
+	return 0;
+}
+
+static int s5k4h7_start_stream(struct s5k4h7 *sensor)
+{
+	int ret;
+
+	ret = s5k4h7_enter_standby(sensor);
+	if (ret)
+		return ret;
+	/*
+	 * Init table (list 2, same start as the public MTK sensor_init), then
+	 * the 3264x2448 mode table. List 3 is an OTP read sequence
+	 * (0x0a00/0x0a02/0x0a04), not init, and must not be written.
+	 */
+	ret = s5k4h7_write_array(sensor, s5k4h7_list2,
+				 ARRAY_SIZE(s5k4h7_list2));
+	if (ret)
+		return ret;
+	usleep_range(1000, 2000);
+	ret = s5k4h7_write_array(sensor, s5k4h7_list1,
+				 ARRAY_SIZE(s5k4h7_list1));
+	if (ret)
+		return ret;
+	ret = __v4l2_ctrl_handler_setup(sensor->subdev.ctrl_handler);
+	if (ret)
+		return ret;
+	usleep_range(2000, 3000);
+	ret = s5k4h7_write(sensor, S5K4H7_REG_MODE_SELECT,
+			   S5K4H7_MODE_STREAMING, false);
+	if (ret)
+		return ret;
+	usleep_range(30000, 35000);
+	return 0;
+}
+
+static int s5k4h7_stop_stream(struct s5k4h7 *sensor)
+{
+	return s5k4h7_write(sensor, S5K4H7_REG_MODE_SELECT,
+			    S5K4H7_MODE_STANDBY, false);
+}
+
+static int s5k4h7_s_stream(struct v4l2_subdev *sd, int on)
+{
+	struct s5k4h7 *sensor = to_s5k4h7(sd);
+	int ret = 0;
+
+	mutex_lock(&sensor->mutex);
+
+	if (sensor->streaming == on)
+		goto unlock;
+
+	if (on) {
+		ret = pm_runtime_resume_and_get(sensor->dev);
+		if (ret < 0)
+			goto unlock;
+		ret = s5k4h7_start_stream(sensor);
+		if (ret) {
+			s5k4h7_stop_stream(sensor);
+			pm_runtime_put(sensor->dev);
+			goto unlock;
+		}
+	} else {
+		s5k4h7_stop_stream(sensor);
+		pm_runtime_put(sensor->dev);
+	}
+
+	sensor->streaming = on;
+unlock:
+	mutex_unlock(&sensor->mutex);
+	return ret;
+}
+
+static int s5k4h7_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k4h7 *sensor = container_of(ctrl->handler,
+					     struct s5k4h7, ctrl_handler);
+	int ret;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 max_expo = S5K4H7_FRAME_LENGTH - S5K4H7_EXPOSURE_MARGIN;
+
+		__v4l2_ctrl_modify_range(sensor->exposure,
+					 sensor->exposure->minimum, max_expo,
+					 sensor->exposure->step,
+					 sensor->exposure->default_value);
+	}
+
+	if (pm_runtime_get_if_in_use(sensor->dev) <= 0)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = s5k4h7_write(sensor, S5K4H7_REG_COARSE_INTEGRATION,
+				   ctrl->val, true);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = s5k4h7_write(sensor, S5K4H7_REG_ANALOG_GAIN,
+				   ctrl->val, true);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = s5k4h7_write(sensor, S5K4H7_REG_FRAME_LENGTH,
+				   S5K4H7_HEIGHT + ctrl->val, true);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(sensor->dev);
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k4h7_ctrl_ops = {
+	.s_ctrl = s5k4h7_set_ctrl,
+};
+
+static int s5k4h7_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	return 0;
+}
+
+static int s5k4h7_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index)
+		return -EINVAL;
+	fse->min_width = fse->max_width = S5K4H7_WIDTH;
+	fse->min_height = fse->max_height = S5K4H7_HEIGHT;
+	return 0;
+}
+
+static int s5k4h7_get_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct s5k4h7 *sensor = to_s5k4h7(sd);
+
+	mutex_lock(&sensor->mutex);
+	fmt->format = sensor->fmt;
+	mutex_unlock(&sensor->mutex);
+	return 0;
+}
+
+static int s5k4h7_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct s5k4h7 *sensor = to_s5k4h7(sd);
+
+	mutex_lock(&sensor->mutex);
+	if (sensor->streaming && fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE)
+		goto unlock;
+	fmt->format.width = S5K4H7_WIDTH;
+	fmt->format.height = S5K4H7_HEIGHT;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE)
+		sensor->fmt = fmt->format;
+unlock:
+	mutex_unlock(&sensor->mutex);
+	return 0;
+}
+
+static int s5k4h7_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	if (sel->pad)
+		return -EINVAL;
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r = (struct v4l2_rect) {
+			.left = 0, .top = 0,
+			.width = S5K4H7_WIDTH, .height = S5K4H7_HEIGHT,
+		};
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct v4l2_subdev_video_ops s5k4h7_video_ops = {
+	.s_stream = s5k4h7_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops s5k4h7_pad_ops = {
+	.enum_mbus_code = s5k4h7_enum_mbus_code,
+	.enum_frame_size = s5k4h7_enum_frame_size,
+	.get_fmt = s5k4h7_get_fmt,
+	.set_fmt = s5k4h7_set_fmt,
+	.get_selection = s5k4h7_get_selection,
+};
+
+static const struct v4l2_subdev_ops s5k4h7_subdev_ops = {
+	.video = &s5k4h7_video_ops,
+	.pad = &s5k4h7_pad_ops,
+};
+
+static const s64 link_freq_menu_items[] = { S5K4H7_LINK_FREQ };
+
+static int s5k4h7_init_controls(struct s5k4h7 *sensor)
+{
+	struct v4l2_ctrl_handler *h = &sensor->ctrl_handler;
+	s64 pixel_rate = S5K4H7_PIXEL_RATE;
+	struct v4l2_fwnode_device_properties props;
+	s64 hblank = S5K4H7_LINE_LENGTH - S5K4H7_WIDTH;
+	s64 vblank = S5K4H7_FRAME_LENGTH - S5K4H7_HEIGHT;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(sensor->dev, &props);
+	if (ret)
+		return ret;
+
+	ret = v4l2_ctrl_handler_init(h, 8);
+	if (ret)
+		return ret;
+	h->lock = &sensor->mutex;
+
+	v4l2_ctrl_new_int_menu(h, NULL, V4L2_CID_LINK_FREQ, 0, 0,
+			       link_freq_menu_items);
+	v4l2_ctrl_new_std(h, NULL, V4L2_CID_PIXEL_RATE, 0, pixel_rate, 1,
+			  pixel_rate);
+	v4l2_ctrl_new_std(h, NULL, V4L2_CID_HBLANK, hblank, hblank, 1, hblank);
+	v4l2_ctrl_new_std(h, NULL, V4L2_CID_VBLANK, vblank, vblank, 1, vblank);
+	sensor->exposure = v4l2_ctrl_new_std(h, &s5k4h7_ctrl_ops,
+			V4L2_CID_EXPOSURE, S5K4H7_EXPOSURE_MIN,
+			S5K4H7_FRAME_LENGTH - S5K4H7_EXPOSURE_MARGIN, 1,
+			S5K4H7_FRAME_LENGTH - S5K4H7_EXPOSURE_MARGIN);
+	v4l2_ctrl_new_std(h, &s5k4h7_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5K4H7_GAIN_MIN, S5K4H7_GAIN_MAX, 1,
+			  S5K4H7_GAIN_DEFAULT);
+	/* rotation/orientation from DT, read by libcamera. */
+	v4l2_ctrl_new_fwnode_properties(h, &s5k4h7_ctrl_ops, &props);
+	if (h->error) {
+		ret = h->error;
+		v4l2_ctrl_handler_free(h);
+		return ret;
+	}
+	sensor->subdev.ctrl_handler = h;
+	return 0;
+}
+
+static int s5k4h7_parse_endpoint(struct device *dev)
+{
+	struct fwnode_handle *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	int ret;
+
+	ep = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!ep)
+		return -ENXIO;
+	ret = v4l2_fwnode_endpoint_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5K4H7_DATA_LANES)
+		dev_warn(dev, "expected %u data lanes, endpoint has %u\n",
+			 S5K4H7_DATA_LANES, bus_cfg.bus.mipi_csi2.num_data_lanes);
+	return 0;
+}
+
+static int s5k4h7_probe(struct i2c_client *client)
+{
+	static const char *const names[] = { "vana", "vdig", "vio" };
+	struct device *dev = &client->dev;
+	struct s5k4h7 *sensor;
+	unsigned int i;
+	int ret;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+	sensor->dev = dev;
+
+	ret = s5k4h7_parse_endpoint(dev);
+	if (ret)
+		return ret;
+
+	v4l2_i2c_subdev_init(&sensor->subdev, client, &s5k4h7_subdev_ops);
+	sensor->subdev.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->subdev.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	sensor->fmt.width = S5K4H7_WIDTH;
+	sensor->fmt.height = S5K4H7_HEIGHT;
+	sensor->fmt.code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	sensor->fmt.field = V4L2_FIELD_NONE;
+
+	sensor->eclk = devm_clk_get(dev, "eclk");
+	if (IS_ERR(sensor->eclk))
+		return dev_err_probe(dev, PTR_ERR(sensor->eclk), "no eclk\n");
+	if (clk_get_rate(sensor->eclk) != S5K4H7_ECLK_FREQ)
+		dev_warn(dev, "eclk is not %lu Hz, timing assumes it is\n",
+			 S5K4H7_ECLK_FREQ);
+
+	sensor->rst_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->rst_gpio))
+		return dev_err_probe(dev, PTR_ERR(sensor->rst_gpio), "no reset\n");
+
+	for (i = 0; i < ARRAY_SIZE(names); i++)
+		sensor->supplies[i].supply = names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(names), sensor->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	mutex_init(&sensor->mutex);
+	ret = s5k4h7_init_controls(sensor);
+	if (ret)
+		return ret;
+	ret = media_entity_pads_init(&sensor->subdev.entity, 1, &sensor->pad);
+	if (ret)
+		return ret;
+
+	pm_runtime_enable(dev);
+	if (!pm_runtime_enabled(dev)) {
+		ret = s5k4h7_power_on(dev);
+		if (ret)
+			return ret;
+		s5k4h7_log_id(sensor);
+	} else {
+		ret = pm_runtime_resume_and_get(dev);
+		if (ret >= 0) {
+			s5k4h7_log_id(sensor);
+			pm_runtime_put(dev);
+		}
+	}
+
+	ret = v4l2_async_register_subdev_sensor(&sensor->subdev);
+	if (ret) {
+		pm_runtime_disable(dev);
+		media_entity_cleanup(&sensor->subdev.entity);
+		v4l2_ctrl_handler_free(&sensor->ctrl_handler);
+		return ret;
+	}
+	return 0;
+}
+
+static void s5k4h7_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k4h7 *sensor = to_s5k4h7(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sensor->ctrl_handler);
+	pm_runtime_disable(sensor->dev);
+	mutex_destroy(&sensor->mutex);
+}
+
+static const struct dev_pm_ops s5k4h7_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5k4h7_power_off, s5k4h7_power_on, NULL)
+};
+
+static const struct of_device_id s5k4h7_of_match[] = {
+	{ .compatible = "samsung,s5k4h7" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s5k4h7_of_match);
+
+static struct i2c_driver s5k4h7_driver = {
+	.driver = {
+		.name = "s5k4h7",
+		.pm = &s5k4h7_pm_ops,
+		.of_match_table = s5k4h7_of_match,
+	},
+	.probe = s5k4h7_probe,
+	.remove = s5k4h7_remove,
+};
+module_i2c_driver(s5k4h7_driver);
+
+MODULE_DESCRIPTION("Samsung S5K4H7 sensor (hanoip rear wide/macro)");
+MODULE_LICENSE("GPL v2");
