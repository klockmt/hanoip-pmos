#!/bin/sh
# Keeps the battery between 60 % and 80 % to preserve its health: above HI the charger is cut and the
# cable is suspended (input_suspend), so the phone runs from the battery; below LO both come back.
# This also happens after the charger finished (Full), so the phone never sits at 100 % on the cable.
# Between the two it keeps its state.
# A cycle is a cut at HI followed by a resume below LO. After CYCLES cycles, the next charge runs
# to 100 % once, and then the count starts again. The state is kept in STATE, so it survives
# reboots. The HANOIP_* variables override the limits and paths, for tests (scripts/test-charge-limit).
# While the cable charges, the input current is held at ICL (1.1 A at 9 V is about 10 W) with the override
# main/force_main_icl. That override beats every other ICL vote, input_suspend included, so it is released
# before each cut, and the kernel drops it on its own when the cable is unplugged.
# Too warm (the flag hanoip-thermal keeps fresh) is cut like a limit cut, but outside the cycle count.
# Safety first: the percentage once froze at 100 % and the phone drained on battery until it died, so
# a gauge that stops updating (hanoip-qgd) or a battery below FLOOR turns charging back on and blocks cuts.
bat=${HANOIP_BATTERY_DIR:-/sys/class/power_supply/battery}
usb=${HANOIP_USB_DIR:-/sys/class/power_supply/usb}
state=${HANOIP_CHARGE_STATE:-/var/lib/hanoip/charge-limit}
heatf=$state.heat # exists while a heat cut is on, so a restart still lifts it
main=${HANOIP_MAIN_DIR:-/sys/class/power_supply/main}
gauge=${HANOIP_QGD_STATE:-/run/hanoip-qgd.soc}
hotflag=${HANOIP_THERMAL_FLAG:-/run/hanoip-thermal.hot}
icl=${HANOIP_CHARGE_ICL_UA:-1100000}
hi=${HANOIP_CHARGE_HI:-80}
lo=${HANOIP_CHARGE_LO:-60}
cycles=${HANOIP_CHARGE_CYCLES:-10}
floor=${HANOIP_CHARGE_FLOOR_UV:-3750000} # about 20 % on this battery's profile; 60 % is about 3.95 V
stale_s=900 # hanoip-qgd writes about once a minute, with gaps of up to 5 minutes seen after the cable returns
# Stopping or killing the limiter must not leave the charger cut or the cable suspended: the phone would drain without charging.
trap 'echo -1 > "$main/force_main_icl"; echo 1 > "$bat/charging_enabled"; echo 0 > "$bat/input_suspend"' EXIT
trap 'exit 1' INT TERM

mkdir -p "$(dirname "$state")"
done_cycles=0 cut=0 unlock=0
[ -f "$state" ] && read -r done_cycles cut unlock < "$state"
done_cycles=${done_cycles:-0} cut=${cut:-0} unlock=${unlock:-0}

save() { echo "$done_cycles $cut $unlock" > "$state"; }
resume() { echo 0 > $bat/input_suspend; echo 1 > $bat/charging_enabled; }
cutoff() { echo -1 > $main/force_main_icl; echo 0 > $bat/charging_enabled; echo 1 > $bat/input_suspend; }
fresh() { [ $(( $(date +%s) - $(stat -c %Y "$1" 2>/dev/null || echo 0) )) -le "$2" ]; }
gauge_fresh() { fresh "$gauge" "$stale_s"; }
# Holds the input current at ICL, or lower when the source offers less (a PC port, for example): the override
# would otherwise raise the limit above what the source gives.
throttle() {
	hw=$(cat $usb/hw_current_max 2>/dev/null) || return
	if [ "$hw" -gt "$icl" ]; then echo "$icl" > $main/force_main_icl; else echo -1 > $main/force_main_icl; fi
}

while :; do
	cap=$(cat $bat/capacity)
	on=$(cat $bat/charging_enabled)
	volt=$(cat $bat/voltage_now)
	if [ -e "$hotflag" ] && fresh "$hotflag" 300 && [ "$volt" -ge "$floor" ]; then
		# Below FLOOR the charge comes first: a flat battery loses the PMIC data, and hanoip-thermal shuts down at the extreme.
		if [ "$on" = 1 ] || [ "$(cat $bat/input_suspend)" = 0 ]; then cutoff; fi
		: > "$heatf"
	elif [ -e "$heatf" ]; then
		# Cooled down. A limit cut (cut=1) stays; the checks below cut again above HI.
		rm -f "$heatf"
		if [ "$cut" = 0 ]; then resume; fi
	elif ! gauge_fresh || [ "$volt" -lt "$floor" ]; then
		if [ "$on" = 0 ] || [ "$(cat $bat/input_suspend)" = 1 ]; then resume; fi
		# Not a cycle: the battery did not go from 80 to 60 % under our cut.
		if [ "$cut" = 1 ]; then cut=0; save; fi
	elif [ "$unlock" = 1 ]; then
		# The charge after the last cycle runs to full; then the count starts again.
		if [ "$cap" -ge 100 ]; then done_cycles=0 cut=0 unlock=0; save; fi
	elif [ "$cap" -gt "$hi" ] && [ "$(cat $bat/input_suspend)" = 0 ] && [ "$(cat $usb/present)" = 1 ]; then
		# The cable powers the phone even after a finished charge (charging_enabled reads 0 at Full), so
		# the test is the cable, not the charger. Without a cable there is nothing to cut, and the flag
		# would count a cycle that never happened.
		cutoff
		cut=1; save
	elif [ "$cap" -lt "$lo" ] && [ "$on" = 0 ]; then
		resume
		# A charger found off below 60 % without our cut (e.g. after a boot) is not a cycle.
		if [ "$cut" = 1 ]; then done_cycles=$((done_cycles+1)); cut=0; fi
		if [ "$done_cycles" -ge "$cycles" ]; then unlock=1; fi
		save
	fi
	if [ "$(cat $usb/present)" = 1 ] && [ "$(cat $bat/input_suspend)" = 0 ]; then throttle; else echo -1 > $main/force_main_icl; fi
	sleep 30
done
