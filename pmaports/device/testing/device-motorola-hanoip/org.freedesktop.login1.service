# Installed to /usr/local/share/dbus-1/system-services by post-install and post-upgrade. D-Bus reads that directory
# before /usr/share, so this overrides elogind's own file. On the 4.14 kernel, the memory-pressure trigger that
# elogind's sd-event writes to its cgroup's memory.pressure corrupts a list in psi_trigger_create and a CPU then spins
# forever (docs/PITFALLS.md); MEMORY_PRESSURE_WATCH=/dev/null turns that watch off. D-Bus activation clears the
# environment, which is why the variable is set here and not in /etc/conf.d.
[D-BUS Service]
Name=org.freedesktop.login1
Exec=/usr/bin/env MEMORY_PRESSURE_WATCH=/dev/null /usr/libexec/elogind/elogind --daemon
User=root
