#!/usr/bin/env python3
# Read-only status of the phone for the dashboard. `hanoip-dashboard --data` prints the JSON document the page reads;
# with no argument it serves it on the Tailscale address: the page at /, the document at /api/status, nothing else.
# A value that cannot be read is null, never estimated. The request is only matched against those two paths; no
# request data reaches a command. Two parts: the fast part is file reads in Python, sampled at most every FAST_TTL
# (CPU and network rates are deltas between two samples); the slow part is hanoip-status and the commands, refreshed
# at most every SLOW_TTL in a background thread that only a request starts, so a request never waits for it after the
# first one. Where the fast part cannot read a figure, the status text's figure stands in (the rates never do).
# Tests move the paths and commands with HANOIP_* variables (scripts/test-dashboard); the unit sets none of them.
import fnmatch
import glob
import http.server
import ipaddress
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time

GIB = 2 ** 30
PROC = os.environ.get("HANOIP_PROC_DIR", "/proc")
SYS = os.environ.get("HANOIP_SYS_DIR", "/sys")
SHARE = os.environ.get("HANOIP_SHARE_DIR", "/usr/share/device-motorola-hanoip")
PAGE = os.environ.get("HANOIP_DASHBOARD_PAGE", "/usr/share/hanoip-dashboard/index.html")
ML_STATE = os.environ.get("HANOIP_ML_STATE", "/run/hanoip-ml-charge.state")
SLOW_TTL = float(os.environ.get("HANOIP_DASHBOARD_TTL", "10"))
FAST_TTL = 0.9
CLOCK = time.monotonic


def read(path):
    try:
        with open(path, "rb") as f:
            return f.read()
    except OSError:
        return None


def text(path):
    raw = read(path)
    return None if raw is None else raw.decode(errors="replace")


def run(*cmd, rc_any=False):
    """Stdout of a fixed command; None when it is missing, fails or times out (rc_any: the exit code does not count)."""
    if shutil.which(cmd[0]) is None:
        return None
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    return p.stdout if rc_any or p.returncode == 0 else None


def num(s):
    try:
        return int(s)
    except (TypeError, ValueError):
        return None


def safe(fn):
    """A scalar field: None when reading it fails for any reason."""
    def wrapped(*args):
        try:
            return fn(*args)
        except Exception:
            return None
    return wrapped


@safe
def uptime_s():
    return int(float(text(f"{PROC}/uptime").split()[0]))


@safe
def reboots():
    # The boots the journal keeps, minus the current one.
    boots = [line for line in (run("journalctl", "--list-boots", "--no-pager") or "").splitlines() if line.strip()]
    return len(boots) - 1 if boots else None


@safe
def oom_kills():
    for line in text(f"{PROC}/vmstat").splitlines():
        key, _, value = line.partition(" ")
        if key == "oom_kill":
            return num(value)
    return None


def meminfo():
    try:
        return {k: int(v.split()[0]) for k, v in (l.split(":", 1) for l in text(f"{PROC}/meminfo").splitlines())}
    except (AttributeError, ValueError, IndexError):
        return {}


def ram():
    m = meminfo()
    if "MemTotal" not in m or "MemAvailable" not in m:
        return {"used_pct": None, "used_gb": None, "total_gb": None}
    total, used = m["MemTotal"], m["MemTotal"] - m["MemAvailable"]  # kB
    return {"used_pct": round(used * 100 / total), "used_gb": round(used * 1024 / GIB, 2),
            "total_gb": round(total * 1024 / GIB, 2)}


def zram():
    # mm_stat's first field is the uncompressed data the swap holds, what zramctl calls DATA.
    size = num((text(f"{SYS}/block/zram0/disksize") or "").strip())
    data = num(((text(f"{SYS}/block/zram0/mm_stat") or "").split() or [""])[0])
    return {"size_gb": None if size is None else round(size / GIB, 2),
            "used_gb": None if data is None else round(data / GIB, 2)}


@safe
def boot_slot():
    # The slot the ABL started, from the U-Boot's copy of its command line (hanoip-ml-abl-slot does the same);
    # /proc/cmdline is not used: it always names _a. Only the slot suffix is read, never the rest of the line.
    raw = read(os.environ.get("HANOIP_DT_ABL_ARGS", f"{PROC}/device-tree/chosen/u-boot,abl-bootargs"))
    if raw is None:
        return None
    for item in re.split(rb"[\x00 ]", raw):
        if item.startswith(b"androidboot.slot_suffix="):
            return {b"_a": "a", b"_b": "b"}.get(item.split(b"=", 1)[1])
    return None


@safe
def slot_successful():
    # hanoip-health logs its result once per boot; the last one of this boot is the answer.
    out = run("journalctl", "-b", "-t", "hanoip-health", "-o", "cat", "--no-pager")
    if out is None:
        return None
    for line in reversed(out.splitlines()):
        if line == "slot marked successful":
            return True
        if line == "qbootctl -m failed":
            return False
    return None


def nas_dir():
    return os.environ.get("HANOIP_NAS_DIR", "/mnt/hd-b")


def nas():
    mounts = text(f"{PROC}/mounts")
    if mounts is None:
        return None
    d = nas_dir()
    fields = [l.split() for l in mounts.splitlines()]
    if not any(len(f) >= 3 and f[1] == d and f[2] == "btrfs" for f in fields):
        return {"mounted": False, "used_pct": None, "used_gb": None, "total_gb": None}
    try:
        st = os.statvfs(d)
        total = st.f_blocks * st.f_frsize
        used = (st.f_blocks - st.f_bfree) * st.f_frsize
        avail = st.f_bavail * st.f_frsize
    except OSError:
        return {"mounted": True, "used_pct": None, "used_gb": None, "total_gb": None}
    # The same figures df shows: Use% is used / (used + available to users).
    return {"mounted": True, "used_pct": round(used * 100 / (used + avail)), "used_gb": round(used / GIB, 2),
            "total_gb": round(total / GIB, 2)}


@safe
def scrub():
    out = run("btrfs", "scrub", "status", nas_dir())
    if out is None:
        return None
    fields = {}
    for line in out.splitlines():
        key, sep, value = line.partition(":")
        if sep:
            fields[key.strip()] = value.strip()
    state = fields.get("Status")
    if not state:
        return None
    summary = fields.get("Error summary")
    errors = None
    if summary is not None:
        errors = 0 if summary.startswith("no errors") else sum(int(n) for n in re.findall(r"=(\d+)", summary))
    finished = None
    if state == "finished" and "Scrub started" in fields and "Duration" in fields:
        start = time.mktime(time.strptime(" ".join(fields["Scrub started"].split()), "%a %b %d %H:%M:%S %Y"))
        h, m, s = (int(x) for x in fields["Duration"].split(":"))
        finished = int(start + h * 3600 + m * 60 + s)
    return {"state": state, "finished_at": finished, "errors": errors}


def wifi():
    dev = os.environ.get("HANOIP_WIFI_DEV", "wlan0")
    up = ssid = None
    for line in (run("nmcli", "-t", "-f", "DEVICE,STATE", "device", "status") or "").splitlines():
        name, _, state = line.partition(":")
        if name == dev:
            up = state.startswith("connected")
    # --rescan no: read the list the radio already has, do not start a scan.
    for line in (run("nmcli", "-t", "-f", "ACTIVE,SSID", "device", "wifi", "list", "--rescan", "no") or "").splitlines():
        if line.startswith("yes:"):
            ssid = line[4:].replace("\\:", ":") or None
    return {"up": up, "ssid": ssid}


@safe
def tailscale_up():
    out = run("tailscale", "status", "--json")
    return None if out is None else json.loads(out).get("BackendState") == "Running"


@safe
def samba_active():
    state = (run("systemctl", "is-active", "smb", rc_any=True) or "").strip()
    ss = run("ss", "-H", "-ltn")
    if not state or ss is None:
        return None
    ports = {int(line.split()[3].rsplit(":", 1)[1]) for line in ss.splitlines() if len(line.split()) >= 4}
    return state == "active" and bool(ports & {139, 445})


def unit_state(unit):
    state = (run("systemctl", "is-active", unit, rc_any=True) or "").strip()
    return state or None


@safe
def containers():
    if shutil.which("crun") is None:
        return None
    items = json.loads(run("crun", "list", "-f", "json"))
    return {"running": sum(1 for c in items if c.get("status") == "running"), "names": [c["id"] for c in items]}


def watchdog():
    d = os.environ.get("HANOIP_WATCHDOG_DIR", f"{SYS}/class/watchdog/watchdog0")
    timeout = num((text(f"{d}/timeout") or "").strip())
    left = num((text(f"{d}/timeleft") or "").strip())
    ago = None if timeout is None or left is None or timeout - left < 0 else timeout - left
    count = num((text(os.environ.get("HANOIP_WATCHDOG_STATE", "/var/lib/hanoip/watchdog/count")) or "").strip())
    return {"last_feed_s_ago": ago, "resets": count}


def version():
    pkgrel = (text(f"{SHARE}/pkgrel") or "").strip()
    return {"kernel": os.uname().release, "pkgrel": pkgrel or None}


@safe
def status_text():
    out = run(os.environ.get("HANOIP_STATUS_CMD", "/usr/bin/hanoip-status"))
    return (out.rstrip("\n") or None) if out is not None else None


def figure(s, unit):
    """A number with its unit as hanoip-status prints it ("77 %", "31.2 °C"); None for n/a, no reply or anything else."""
    m = re.fullmatch(r"(\d+(?:\.\d+)?) " + re.escape(unit), s)
    if m is None:
        return None
    return float(m.group(1)) if "." in m.group(1) else int(m.group(1))


def row(lines, label, n):
    """The n " | " parts of the line that starts with label; "" for each when it is missing or has another count."""
    line = next((x for x in lines if x.startswith(label)), None)
    parts = None if line is None else line[len(label):].split(" | ")
    return parts if parts is not None and len(parts) == n else [""] * n


def find(lines, pattern):
    """The match of the first line that the whole pattern covers, or None."""
    for line in lines:
        m = re.fullmatch(pattern, line)
        if m:
            return m
    return None


def grp(m, i):
    return m.group(i) if m else ""


def metrics(status):
    """The figures of the status text for the charts, read from the same lines as hanoip-status prints them. Each
    field is null when its own figure does not parse; the rest of its line is kept."""
    lines = (status or "").splitlines()
    cpu, gpu, ram = row(lines, "CPU - ", 3), row(lines, "GPU - ", 4), row(lines, "RAM - ", 3)
    rom, bat = row(lines, "ROM - ", 3), row(lines, "Battery - ", 4)
    srv, body = row(lines, "Server - ", 2), row(lines, "Body - ", 1)
    freq = re.fullmatch(r"(\d+)(?:-(\d+))? MHz", cpu[1])
    gb = re.fullmatch(r"(\d+(?:\.\d+)?)/(\d+(?:\.\d+)?) GB", rom[1])
    host = re.fullmatch(r"(\S+)  - (.+)", srv[1])
    net = find(lines, r"(\S+) rx (\d+) kbit/s, tx (\d+) kbit/s")
    power = find(lines, r"(\S+ W) \| (.+)")
    drain = find(lines, r"Energy drain - (\S+ W) • (\S+)")
    st, _, extra = grp(power, 2).partition(" • ")
    charging = {"charging": True, "not charging": False}.get(st) if power else None
    bypass = {"": False, "bypass": True}.get(extra) if charging is not None else None
    return {
        "cpu": {"used_pct": figure(cpu[0], "%"), "mhz_min": int(freq.group(1)) if freq else None,
                "mhz_max": int(freq.group(2) or freq.group(1)) if freq else None, "temp_c": figure(cpu[2], "°C")},
        "gpu": {"used_pct": figure(gpu[0], "%"), "mhz": figure(gpu[1], "MHz"), "temp_c": figure(gpu[2], "°C"),
                "on": {"on": True, "off": False}.get(gpu[3])},
        "ram_temp_c": figure(ram[2], "°C"),
        "rom": {"used_pct": figure(rom[0], "%"), "used_gb": float(gb.group(1)) if gb else None,
                "total_gb": float(gb.group(2)) if gb else None, "temp_c": figure(rom[2], "°C")},
        "battery": {"pct": figure(bat[0], "%"), "volts": figure(bat[1], "V"), "cycles": figure(bat[2], "cycles"),
                    "temp_c": figure(bat[3], "°C"), "watts": figure(grp(power, 1), "W"), "charging": charging,
                    "bypass": bypass},
        "power": {"watts": figure(grp(drain, 1), "W"),
                  "source": grp(drain, 2) if grp(drain, 2) in ("cable", "battery") else None},
        "body_temp_c": figure(body[0], "°C"),
        "net": {"iface": grp(net, 1) or None, "rx_kbit": int(net.group(2)) if net else None,
                "tx_kbit": int(net.group(3)) if net else None},
        "ping": {"gateway_ms": figure(srv[0], "ms"), "internet_host": host.group(1) if host else None,
                 "internet_ms": figure(host.group(2), "ms") if host else None},
    }


# The fast part. Each figure is read from the file hanoip-status reads it from, with the same rules (the same
# fallbacks for a supply that has no usb or present file, the same rounding); scripts/test-dashboard compares them.
# A supply directory that is not there is not read at all, so the status text's figure stands in for it.
NO_FALLBACK = {("cpu", "used_pct"), ("net", "rx_kbit"), ("net", "tx_kbit")}  # rates need two samples
FAST = {}
FAST_LOCK = threading.Lock()


def val(path):
    return num((text(path) or "").strip())


def zone_temp(*patterns):
    """The hottest thermal zone whose type matches a pattern, in °C with one decimal; None when there is none."""
    temps = []
    for z in glob.glob(f"{SYS}/class/thermal/thermal_zone*"):
        if any(fnmatch.fnmatchcase((text(f"{z}/type") or "").strip(), p) for p in patterns):
            v = val(f"{z}/temp")
            if v is not None:
                temps.append(v)
    return float("%.1f" % (max(temps) / 1000)) if temps else None


def cpu_counters():
    """Total and idle jiffies of the cpu line of /proc/stat, summed as hanoip-status sums them (8 fields)."""
    for line in (text(f"{PROC}/stat") or "").splitlines():
        p = line.split()
        if p[:1] == ["cpu"]:
            v = [num(x) for x in p[1:9]]
            return (sum(v), v[3] + v[4]) if len(v) == 8 and None not in v else None
    return None


def default_iface():
    for line in (text(f"{PROC}/net/route") or "").splitlines()[1:]:
        p = line.split()
        if len(p) >= 2 and p[1] == "00000000" and re.fullmatch(r"[\w.-]+", p[0]):
            return p[0]
    return None


def fast_sample(prev, mono):
    """One sample of the fast figures, the deltas against the previous sample `prev` taken `mono` seconds before."""
    cpu = cpu_counters()
    iface = default_iface()
    rx = tx = None
    if iface:
        rx = val(f"{SYS}/class/net/{iface}/statistics/rx_bytes")
        tx = val(f"{SYS}/class/net/{iface}/statistics/tx_bytes")
    dt = None if prev is None else mono - prev["mono"]
    used = rx_kbit = tx_kbit = None
    if dt and prev["cpu"] and cpu and cpu[0] > prev["cpu"][0]:
        total = cpu[0] - prev["cpu"][0]
        used = ((total - (cpu[1] - prev["cpu"][1])) * 100) // total
    pn = prev["net"] if dt and prev else None
    if pn and None not in (rx, tx, pn[1], pn[2]) and pn[0] == iface and rx >= pn[1] and tx >= pn[2]:
        rx_kbit = int((rx - pn[1]) * 8 / 1000 / dt)
        tx_kbit = int((tx - pn[2]) * 8 / 1000 / dt)

    ps = f"{SYS}/class/power_supply"
    bat = f"{ps}/battery" if os.path.isdir(f"{ps}/battery") else f"{ps}/qcom_qg"
    usb = f"{ps}/usb" if os.path.isdir(f"{ps}/usb") else f"{ps}/hanoip-pm6150-monitor-charger"
    batw = charging = bypass = suspended = present = None
    cur = volt = None
    if os.path.isdir(bat):
        cur, volt = val(f"{bat}/current_now"), val(f"{bat}/voltage_now")
        if cur is not None and volt is not None:
            batw = float("%.2f" % (abs(cur) * volt / 1e12))
        status = text(f"{bat}/status")
        charging = None if status is None else status.strip() == "Charging"
        suspended = val(f"{bat}/input_suspend") or 0
        chg_on = val(f"{bat}/charging_enabled")
        if chg_on is None:  # the charge limit's own state, as hanoip-status reads it
            chg_on = 1 if (text(ML_STATE) or "off").strip() == "on" else 0
    if os.path.isdir(usb):
        present = val(f"{usb}/present")
        if present is None:
            present = val(f"{usb}/online") or 0
    if present is not None and suspended is not None and os.path.isdir(bat):
        bypass = present == 1 and suspended == 0 and chg_on == 0
    watts = source = None
    if present is not None and suspended is not None:
        if present == 1 and suspended == 0:
            ci = val(f"{usb}/input_current_now")
            if ci is None:
                ci = val(f"{usb}/current_now") or 0
            watts, source = float("%.2f" % (ci * (val(f"{usb}/voltage_now") or 0) / 1e12)), "cable"
        elif batw is not None:
            watts, source = batw, "battery"

    kgsl = f"{SYS}/class/kgsl/kgsl-3d0"
    if os.path.isdir(kgsl):
        busy = (text(f"{kgsl}/gpu_busy_percentage") or "").split()[:1]
        gpu_used = int(busy[0]) if busy and busy[0].isdigit() else None
        hz = val(f"{kgsl}/gpuclk")
        rs = text(f"{kgsl}/device/power/runtime_status")
        gpu_on = None if rs is None else rs.strip() == "active"
    else:
        gpu_used = None  # the mainline GPU has no busy figure
        hz = val(f"{SYS}/class/devfreq/5000000.gpu/cur_freq")
        gpu_on = None if hz is None else hz > 0
    freqs = [v for v in (val(f) for f in glob.glob(f"{SYS}/devices/system/cpu/cpufreq/policy*/scaling_cur_freq"))
             if v is not None]
    volts = None if volt is None else float("%.2f" % (volt / 1e6))
    temp = val(f"{bat}/temp") if os.path.isdir(bat) else None
    metrics_fast = {
        "cpu": {"used_pct": used, "mhz_min": min(freqs) // 1000 if freqs else None,
                "mhz_max": max(freqs) // 1000 if freqs else None,
                "temp_c": zone_temp("cpu-*-usr", "cpu[0-9]*-thermal")},
        "gpu": {"used_pct": gpu_used, "mhz": None if hz is None else hz // 1000000,
                "temp_c": zone_temp("gpuss-*-usr", "gpuss[0-9]*-thermal"), "on": gpu_on},
        "ram_temp_c": zone_temp("ddr-usr", "ddr-thermal"),
        "rom": {"temp_c": zone_temp("nvm-therm-adc")},
        "battery": {"pct": val(f"{bat}/capacity") if os.path.isdir(bat) else None, "volts": volts,
                    "cycles": val(f"{bat}/cycle_count") if os.path.isdir(bat) else None,
                    "temp_c": None if temp is None else float("%.1f" % (temp / 10)), "watts": batw,
                    "charging": charging, "bypass": bypass},
        "power": {"watts": watts, "source": source},
        "body_temp_c": zone_temp("quiet_therm", "pm6150-thermal"),
        "net": {"iface": iface, "rx_kbit": rx_kbit, "tx_kbit": tx_kbit},
    }
    doc = {"at": int(time.time()), "metrics": metrics_fast,
           "system": {"uptime_s": uptime_s(), "oom_kills": oom_kills(), "ram": ram(), "zram": zram()},
           "watchdog": watchdog()}
    return {"mono": mono, "cpu": cpu, "net": (iface, rx, tx), "doc": doc}


def fast_part():
    with FAST_LOCK:
        now = CLOCK()
        if not FAST or now - FAST["mono"] >= FAST_TTL:
            FAST.update(fast_sample(FAST or None, now))
        return FAST["doc"]


def pick(fast_v, slow_v, field):
    """The fast figure, or the status text's when the fast part cannot read it; the two rates never fall back."""
    if fast_v is None and field not in NO_FALLBACK:
        return slow_v
    return fast_v


def merged(slow, fast):
    out = {}
    for k, v in slow.items():
        if isinstance(v, dict):
            out[k] = {f: pick(fast.get(k, {}).get(f), sv, (k, f)) for f, sv in v.items()}
        else:
            out[k] = pick(fast.get(k), v, (k,))
    return out


# The slow part: hanoip-status and the commands. Each field is safe on its own, so this does not raise.
def collect_slow():
    nas_doc = nas()
    mounted = bool(nas_doc and nas_doc["mounted"])
    status = status_text()
    return {
        "at": int(time.time()),
        "status_text": status,
        "metrics": metrics(status),
        "reboots": reboots(),
        "boot": {"slot": boot_slot(), "slot_successful": slot_successful()},
        "storage": {"nas": nas_doc, "scrub": scrub() if mounted else None},
        "network": {"wifi": wifi(), "tailscale": {"up": tailscale_up()},
                    "samba_tailnet": {"active": samba_active()}},
        "services": {"sshd": unit_state("sshd"), "samba": unit_state("smb"), "bot": unit_state("hanoip-bot"),
                     "containers": containers()},
        "version": version(),
    }


def build(slow, fast):
    return {
        "at": fast["at"],
        "slow_at": slow["at"],
        "status_text": slow["status_text"],
        "metrics": merged(slow["metrics"], fast["metrics"]),
        "system": {"uptime_s": fast["system"]["uptime_s"], "reboots": slow["reboots"],
                   "oom_kills": fast["system"]["oom_kills"], "ram": fast["system"]["ram"],
                   "zram": fast["system"]["zram"]},
        "boot": slow["boot"],
        "storage": slow["storage"],
        "network": slow["network"],
        "services": slow["services"],
        "watchdog": fast["watchdog"],
        "version": slow["version"],
    }


def collect():
    """Both parts now, for --data: the first fast sample, so no CPU or network rate."""
    return build(collect_slow(), fast_part())


SLOW_LOCK = threading.Lock()
SLOW = {"mono": None, "doc": None, "busy": None}  # busy: the Event of the refresh running now


def refresh_slow(done):
    try:
        doc = collect_slow()
        with SLOW_LOCK:
            SLOW.update(mono=CLOCK(), doc=doc)
    finally:
        with SLOW_LOCK:
            SLOW["busy"] = None
        done.set()


def slow_part():
    """The last slow result. A request starts a refresh when the result is older than SLOW_TTL and none runs; it
    waits only when there is no result yet, and otherwise answers at once with the previous one."""
    with SLOW_LOCK:
        if SLOW["doc"] is not None and CLOCK() - SLOW["mono"] < SLOW_TTL:
            return SLOW["doc"]
        if SLOW["busy"] is None:
            SLOW["busy"] = threading.Event()
            threading.Thread(target=refresh_slow, args=(SLOW["busy"],), daemon=True).start()
        waiting, done = SLOW["doc"] is None, SLOW["busy"]
    if waiting:
        done.wait()
    with SLOW_LOCK:
        return SLOW["doc"]


def document():
    slow = slow_part()
    fast = fast_part()
    return json.dumps(build(slow, fast)).encode()


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "hanoip-dashboard"
    sys_version = ""

    def do_GET(self):
        if self.path == "/api/status":
            self._send(200, "application/json", document())
            return
        page = read(PAGE) if self.path == "/" else None
        if page is not None:
            self._send(200, "text/html; charset=utf-8", page)
        else:
            self._send(404, "text/plain", b"not found\n")

    def _refuse(self):
        self._send(405, "text/plain", b"method not allowed\n")

    do_HEAD = do_POST = do_PUT = do_PATCH = do_DELETE = _refuse

    def _send(self, code, ctype, body):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        pass


def tailscale_ip():
    out = (run("tailscale", "ip", "-4") or "").split()
    try:
        return str(ipaddress.IPv4Address(out[0])) if out else None
    except ValueError:
        return None


def main(argv):
    if argv == ["--data"]:
        sys.stdout.write(json.dumps(collect()) + "\n")
        return 0
    if argv:
        print("usage: hanoip-dashboard [--data]", file=sys.stderr)
        return 2
    bind = os.environ.get("HANOIP_DASHBOARD_BIND") or tailscale_ip()
    if not bind:
        print("hanoip-dashboard: no Tailscale IPv4 address yet, not serving", file=sys.stderr)
        return 1
    port = int(os.environ.get("HANOIP_DASHBOARD_PORT", "8080"))
    server = http.server.ThreadingHTTPServer((bind, port), Handler)
    print(f"hanoip-dashboard: listening on {bind}:{port}", file=sys.stderr, flush=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
