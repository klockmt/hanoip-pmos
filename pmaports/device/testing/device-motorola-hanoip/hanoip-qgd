#!/usr/bin/env python3
# Battery percentage for the downstream QG fuel gauge (qpnp-qg). The kernel driver only measures: it
# hands voltage and current samples to userspace through /dev/qg and expects userspace to compute the
# state of charge and write it back. Android ships a proprietary daemon for that; without one the
# percentage stays at the value the kernel computed at boot. This is a small replacement: coulomb
# counting on the samples, pulled toward the battery profile's OCV curve (looked up through
# /dev/qg_battery) while the current is low, and set to 100 % when the charger reports a full battery.
# shortcut: no ESR or capacity learning; the capacity is the profile's FCC scaled by charge_full.
import fcntl
import os
import struct

QG_MAX = 18
QG_OCV_UV, QG_RBAT_MOHM, QG_GOOD_OCV_UV, QG_ESR = 1, 2, 4, 5
QG_BATT_SOC, QG_CC_SOC, QG_SYS_SOC = 8, 9, 16
MAX_FIFO = 16
# struct qg_kernel_data and struct qg_user_data from include/uapi/linux/qg.h
KDATA = struct.Struct("<3I" + "4I" * MAX_FIFO + "I?3x" * QG_MAX)
UDATA = struct.Struct("<" + "I?3x" * QG_MAX)
# struct battery_params from include/uapi/linux/qg-profile.h: soc ocv_uv fcc_mah slope var batt_temp table_index
BP = struct.Struct("<7i")
BPIOCXSOC = (3 << 30) | (BP.size << 16) | (ord("B") << 8) | 0x01
BPIOCXFCC = (3 << 30) | (BP.size << 16) | (ord("B") << 8) | 0x03
TABLE_SOC_OCV_CHARGE, TABLE_SOC_OCV_DISCHARGE, TABLE_FCC = 0, 1, 2

BAT = os.environ.get("HANOIP_BATTERY_DIR", "/sys/class/power_supply/battery")
BMS = os.environ.get("HANOIP_BMS_DIR", "/sys/class/power_supply/bms")
STATE = os.environ.get("HANOIP_QGD_STATE", "/run/hanoip-qgd.soc")
REST_UA = 500000  # below this current the voltage is close enough to the OCV to correct the count
REST_PULL = 0.02  # fraction of the gap to the OCV curve closed per sample batch (about a minute)
GOOD_OCV_PULL = 0.5  # the PMIC measured a real rest voltage: trust it much more
# The charger keeps reporting Full while the cable is suspended and the battery discharges, so Full
# sets 100 % only while the battery is not really discharging. At Full on the cable the kernel sends
# batches with no samples at all; those count as not discharging.
FULL_MAX_DISCHARGE_UA = 100000
BOOT_TRUST_S = 300  # the kernel's boot value is good only if we start soon after boot
DEFAULT_RBAT_MOHM = 100


def parse_kdata(buf):
    """Returns the samples as (uV, uA, ms) with the QG sign (positive = discharge) and the valid params."""
    f = KDATA.unpack(buf[:KDATA.size])
    fifo = []
    for j in range(min(f[2], MAX_FIFO)):
        v, i, count, interval = f[3 + 4 * j:7 + 4 * j]
        if i >= 1 << 31:
            i -= 1 << 32
        fifo.append((v, i, count * interval))
    p = f[3 + 4 * MAX_FIFO:]
    params = {k: p[2 * k] for k in range(QG_MAX) if p[2 * k + 1]}
    return fifo, params


def coulomb_delta(fifo, fcc_mah):
    """Change of state of charge in percent over the samples: uA x ms / 3.6e9 = mAh."""
    mah = sum(i * ms for _, i, ms in fifo) / 3.6e9
    return -100.0 * mah / fcc_mah


def ocv_estimate(fifo, rbat_mohm):
    """Time-weighted voltage and current, and the OCV they imply (V + I x R, I positive on discharge)."""
    total = sum(ms for _, _, ms in fifo)
    if not total:
        return None, None
    v = sum(v * ms for v, _, ms in fifo) / total
    i = sum(i * ms for _, i, ms in fifo) / total
    return v + i * rbat_mohm / 1000.0, i


def step(soc, fifo, params, full, fcc_mah, rbat_mohm, lookup):
    """One update of the state of charge (percent). lookup(ocv_uv, table) returns 0-10000."""
    soc += coulomb_delta(fifo, fcc_mah)
    ocv, i = ocv_estimate(fifo, rbat_mohm)
    if QG_GOOD_OCV_UV in params:
        ocv = params[QG_GOOD_OCV_UV]
        soc += GOOD_OCV_PULL * (lookup(ocv, TABLE_SOC_OCV_DISCHARGE) / 100.0 - soc)
    elif ocv is not None and abs(i) < REST_UA:
        table = TABLE_SOC_OCV_CHARGE if i < 0 else TABLE_SOC_OCV_DISCHARGE
        soc += REST_PULL * (lookup(ocv, table) / 100.0 - soc)
    if full and (i is None or i < FULL_MAX_DISCHARGE_UA):
        soc = 100.0
    return min(100.0, max(0.0, soc)), ocv


def initial_soc(saved, uptime_s, kernel_raw, voltage_uv, current_ua, rbat_mohm, lookup):
    """Where to start counting from.

    saved: our last value this boot (the daemon restarted); kernel_raw: capacity_raw, 0-10000, which
    at boot comes from the shutdown value or the power-on OCV; voltage/current: battery sysfs now
    (current positive while charging, as the battery node reports it).
    """
    if saved is not None:
        return saved
    if uptime_s < BOOT_TRUST_S:
        return kernel_raw / 100.0
    # Started late: the boot value is stale. Estimate from the voltage, which is rough under load.
    i = -current_ua
    table = TABLE_SOC_OCV_CHARGE if i < 0 else TABLE_SOC_OCV_DISCHARGE
    return lookup(voltage_uv + i * rbat_mohm / 1000.0, table) / 100.0


def pack_udata(soc, ocv_uv, rbat_mohm):
    values = [0] * QG_MAX
    valid = [False] * QG_MAX
    raw = int(round(soc * 100))
    for k in (QG_SYS_SOC, QG_CC_SOC, QG_BATT_SOC):
        values[k], valid[k] = raw, True
    if ocv_uv is not None:
        values[QG_OCV_UV], valid[QG_OCV_UV] = int(ocv_uv), True
    values[QG_RBAT_MOHM], valid[QG_RBAT_MOHM] = int(rbat_mohm), True
    return UDATA.pack(*[x for k in range(QG_MAX) for x in (values[k], valid[k])])


def read(name, default=None, base=BAT):
    try:
        with open(os.path.join(base, name)) as f:
            return f.read().strip()
    except OSError:
        return default


def main():
    qg = os.open("/dev/qg", os.O_RDWR)
    profile = os.open("/dev/qg_battery", os.O_RDWR)

    def lookup(ocv_uv, table):
        buf = bytearray(BP.pack(0, int(ocv_uv), 0, 0, 0, int(read("temp", "250")), table))
        fcntl.ioctl(profile, BPIOCXSOC, buf)
        return BP.unpack(buf)[0]

    def fcc_mah():
        buf = bytearray(BP.pack(0, 0, 0, 0, 0, int(read("temp", "250")), TABLE_FCC))
        fcntl.ioctl(profile, BPIOCXFCC, buf)
        learned, design = int(read("charge_full", "0")), int(read("charge_full_design", "0"))
        scale = learned / design if learned > 0 and design > 0 else 1.0
        return BP.unpack(buf)[2] * scale

    rbat = DEFAULT_RBAT_MOHM
    try:
        with open(STATE) as f:
            saved = float(f.read())
    except (OSError, ValueError):
        saved = None
    with open("/proc/uptime") as f:
        uptime = float(f.read().split()[0])
    soc = initial_soc(saved, uptime, int(read("capacity_raw", "0", BMS)), int(read("voltage_now", "0")),
                      int(read("current_now", "0")), rbat, lookup)
    print(f"hanoip-qgd: start at {soc:.2f} %", flush=True)
    while True:
        fifo, params = parse_kdata(os.read(qg, KDATA.size))  # blocks until the next batch, about a minute
        if QG_ESR in params and 10 <= params[QG_ESR] <= 1000:
            rbat = params[QG_ESR]
        soc, ocv = step(soc, fifo, params, read("status") == "Full", fcc_mah(), rbat, lookup)
        os.write(qg, pack_udata(soc, ocv, rbat))
        with open(STATE, "w") as f:
            f.write(f"{soc:.4f}\n")


if __name__ == "__main__":
    main()
