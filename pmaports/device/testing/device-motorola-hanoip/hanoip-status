#!/bin/sh
# Phone health in one screen: latency and traffic of the default link, battery, power draw, RAM, root disk, CPU and temperatures.
# shortcut: traffic is the rate over 1 s on the default route, not the link capacity.
# shortcut: the chassis temperature is the quiet_therm sensor, which is the closest this board has.
dev=$(ip route show default | awk '{for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}')
gw=$(ip route show default | awk '{for(i=1;i<=NF;i++) if($i=="via") {print $(i+1); exit}}')
net() { cat /sys/class/net/$dev/statistics/$1 2>/dev/null || echo 0; }
cpu() { read -r _ u n s i w q sq st _ < /proc/stat; echo "$((u+n+s+i+w+q+sq+st)) $((i+w))"; }
# Temperature in °C of the thermal zone whose type is $1 (sysfs gives millidegrees).
zone() { for z in /sys/class/thermal/thermal_zone*; do read -r t < $z/type; [ "$t" = "$1" ] && awk '{printf "%.1f", $1/1000}' $z/temp && return; done; }

lat=$(ping -c 3 -W 2 "$gw" 2>/dev/null | awk -F'= ' '/min\/avg/{split($2, a, "/"); print a[2]" ms"}')
rx0=$(net rx_bytes); tx0=$(net tx_bytes); set -- $(cpu); t0=$1; id0=$2
sleep 1
rx1=$(net rx_bytes); tx1=$(net tx_bytes); set -- $(cpu); t1=$1; id1=$2

bat=/sys/class/power_supply/battery
status=$(cat $bat/status)
cur=$(cat $bat/current_now); volt=$(cat $bat/voltage_now)
if [ "$cur" -lt 0 ]; then
	# Same figure btop uses when the battery has no power_now: |current| x voltage. Sysfs gives µA and µV.
	watts=$(awk -v c=$cur -v v=$volt 'BEGIN{printf "%.2f W (bateria)", (c<0?-c:c)*v/1e12}')
else
	# On the charger: what the phone takes from the cable.
	watts=$(awk -v c=$(cat /sys/class/power_supply/usb/input_current_now) -v v=$(cat /sys/class/power_supply/usb/voltage_now) 'BEGIN{printf "%.2f W (da tomada)", c*v/1e12}')
fi
cpumax=$(for z in /sys/class/thermal/thermal_zone*; do read -r t < $z/type; case $t in cpu-*-usr) cat $z/temp;; esac; done | sort -n | tail -1 | awk '{printf "%.1f", $1/1000}')
# Cycles counted before the PMIC lost its saved data (a drained battery clears it), kept per phone outside the repo.
cycles=$(cat $bat/cycle_count)
offset=$(cat /var/lib/hanoip/cycle-offset 2>/dev/null)
if [ "${offset:-0}" -gt 0 ] 2>/dev/null; then cycles="$((offset + cycles)) ($offset + $cycles)"; fi

echo "Latencia:  ${lat:-sem resposta} (gateway ${gw:-?})"
echo "Rede:      $dev rx $(( (rx1-rx0)*8/1000 )) kbit/s, tx $(( (tx1-tx0)*8/1000 )) kbit/s"
echo "Bateria:   $(cat $bat/capacity) % ($status), $cycles ciclos, $(awk '{printf "%.1f", $1/10}' $bat/temp) °C"
echo "Consumo:   $watts"
awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{printf "RAM:       %.0f %% usada (%.1f de %.1f GB)\n", (t-a)*100/t, (t-a)/1048576, t/1048576}' /proc/meminfo
df -P / | awk 'NR==2{printf "ROM:       %s usada (%.1f de %.1f GB)\n", $5, $3/1048576, $2/1048576}'
echo "CPU:       $(( ((t1-t0)-(id1-id0))*100/(t1-t0) )) % (${cpumax} °C no máximo)"
echo "Carcaça:   $(zone quiet_therm) °C"
