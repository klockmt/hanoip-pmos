#!/bin/sh
# Things that do not work on the 4.14 kernel, removed from the runlevels on install:
# - systemd-sysusers and systemd-tmpfiles use openat2 (kernel 5.6+), so they cannot read any
#   sysusers.d/tmpfiles.d directory. The users the system needs already exist.
# - the qbootctl service runs one command and exits; it is run from /etc/local.d instead.
for svc in systemd-sysusers systemd-tmpfiles-setup systemd-tmpfiles-setup-dev \
	systemd-tmpfiles-setup-dev-early systemd-tmpfiles-clean; do
	for lvl in sysinit boot default shutdown; do
		rc-update del "$svc" "$lvl" >/dev/null 2>&1 || true
	done
done
rc-update del qbootctl default >/dev/null 2>&1 || true
rc-update add hanoip-qgd default >/dev/null 2>&1 || true
rc-update add hanoip-charge-limit default >/dev/null 2>&1 || true
rc-update add hanoip-thermal default >/dev/null 2>&1 || true
rc-update add hanoip-bot default >/dev/null 2>&1 || true
# The Tailscale rule used to be a hand-made file that accepted UDP 41641 on every interface; the package ships its own.
grep -q "Tailscale direct connections" /etc/nftables.d/52_tailscale.nft 2>/dev/null && rm -f /etc/nftables.d/52_tailscale.nft
exit 0
