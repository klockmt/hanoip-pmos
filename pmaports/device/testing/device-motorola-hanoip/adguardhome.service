[Unit]
Description=AdGuard Home (DNS on the address its config binds, loopback by default)
Documentation=https://github.com/AdguardTeam/AdGuardHome
After=network.target
# Without the restored config AdGuard would open its setup page on every interface: stay off until scripts/restore-server.
ConditionPathExists=/var/lib/adguardhome/AdGuardHome.yaml

[Service]
User=adguardhome
Group=adguardhome
ExecStart=/usr/bin/adguardhome --no-check-update --work-dir /var/lib/adguardhome --config /var/lib/adguardhome/AdGuardHome.yaml
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
StateDirectory=adguardhome
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
