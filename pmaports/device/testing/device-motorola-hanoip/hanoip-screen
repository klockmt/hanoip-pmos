#!/bin/sh
# Turns the panel and display off or on through the DRM connector's DPMS property (the display
# pipe and the backlight go down together). The kernel log keeps being written to the buffer.
# Usage: hanoip-screen off|on
case "$1" in
off) state=3 ;;
on) state=0 ;;
*) echo "usage: $0 off|on" >&2; exit 2 ;;
esac
conn=$(modetest -c 2>/dev/null | awk '$3 == "connected" && $4 ~ /DSI/ { print $1; exit }')
[ -n "$conn" ] || { echo "no connected DSI connector" >&2; exit 1; }
modetest -w "$conn:DPMS:$state" >/dev/null 2>&1 || { echo "failed to set DPMS on connector $conn" >&2; exit 1; }
[ "$1" = on ] && [ -w /sys/class/backlight/panel0-backlight/brightness ] && echo 2047 > /sys/class/backlight/panel0-backlight/brightness
echo "screen $1 (connector $conn)"
