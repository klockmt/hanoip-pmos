#!/sbin/openrc-run
# Battery charge limit (60-80 %), input held near 10 W, see /usr/bin/hanoip-charge-limit.
command=/usr/bin/hanoip-charge-limit
# A SIGKILL skips the limiter's EXIT trap, so a crash would leave the cable suspended. supervise-daemon
# starts it again; respawn_max=0 means no limit on restarts (15 in a row on the phone).
supervisor=supervise-daemon
respawn_delay=5
respawn_max=0

depend() {
	# Without hanoip-qgd the percentage stays at its boot value, so the limiter would never resume charging.
	need hanoip-qgd
}

stop_post() {
	# Stopping the limiter must not leave the phone without charging or with the cable suspended.
	echo -1 > /sys/class/power_supply/main/force_main_icl
	echo 1 > /sys/class/power_supply/battery/charging_enabled
	echo 0 > /sys/class/power_supply/battery/input_suspend
}
