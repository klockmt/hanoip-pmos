#!/sbin/openrc-run
# Telegram bot for the phone (/up and /status), see /usr/bin/hanoip-bot.
command=/usr/bin/hanoip-bot
# supervise-daemon restarts it after a crash, with no limit on restarts, like the charge limit.
supervisor=supervise-daemon
respawn_delay=5
respawn_max=0

depend() {
	after networkmanager tailscale
}

start_pre() {
	# A fresh install has no bot secrets; without this check the bot would panic and respawn every 5 s.
	[ -r "${HANOIP_BOT_ENV:-/etc/hanoip/telegram.env}" ] || {
		eerror "no ${HANOIP_BOT_ENV:-/etc/hanoip/telegram.env} (TOKEN= and OWNER_ID=): the bot stays off"
		return 1
	}
}
