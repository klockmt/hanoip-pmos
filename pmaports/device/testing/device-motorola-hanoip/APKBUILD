prepare() {
	# The 4.14 kernel has msm_subsys and no remoteproc: both daemons get a fallback to /lib/firmware.
	patch -d "$srcdir/pd-mapper-$_pdmapper_rev" -p1 < "$srcdir/pd-mapper-subsys-fallback.patch"
	patch -d "$srcdir/tqftpserv-1.3" -p1 < "$srcdir/tqftpserv-subsys-fallback.patch"
}

build() {
	devicepkg_build $startdir $pkgname
	# One file, std only: no cargo, crates or network in the build.
	rustc --edition 2021 -C opt-level=2 -o "$srcdir/hanoip-qgd" "$srcdir/hanoip-qgd.rs"
	rustc --edition 2021 -C opt-level=2 -o "$srcdir/hanoip-bot" "$srcdir/hanoip-bot.rs"
	rustc --edition 2021 -C opt-level=2 -o "$srcdir/hanoip-reboot-bootloader" "$srcdir/hanoip-reboot-bootloader.rs"

	# The modem userspace, static so it does not depend on the libraries of the image. qrtr-ns is the v1.0 daemon
	# (the current qrtr no longer ships one) on its own v1.0 library; the other two use the current libqrtr/libqmi.
	cd "$srcdir"
	_q="qrtr-$_qrtr_rev"
	_libq="$srcdir/$_q/lib/qrtr.c $srcdir/$_q/lib/qmi.c $srcdir/$_q/lib/logging.c"
	cd "$srcdir/qrtr-1.0"
	gcc -static -O2 -s -Ilib -o "$srcdir/hanoip-qrtr-ns" lib/logging.c src/addr.c src/ns.c src/map.c src/hash.c src/waiter.c src/util.c
	cd "$srcdir/pd-mapper-$_pdmapper_rev"
	gcc -static -O2 -s -I"$srcdir/$_q/include" -o "$srcdir/hanoip-pd-mapper" pd-mapper.c assoc.c json.c servreg_loc.c $_libq
	cd "$srcdir/tqftpserv-1.3"
	gcc -static -O2 -s -I"$srcdir/$_q/include" -o "$srcdir/hanoip-tqftpserv" tqftpserv.c translate.c $_libq
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir/hanoip-charge-limit" "$pkgdir/usr/bin/hanoip-charge-limit"
	install -Dm755 "$srcdir/hanoip-bot" "$pkgdir/usr/bin/hanoip-bot"
	install -Dm755 "$srcdir/hanoip-bot.initd" "$pkgdir/etc/init.d/hanoip-bot"
	install -Dm755 "$srcdir/hanoip-charge-limit.initd" "$pkgdir/etc/init.d/hanoip-charge-limit"
	install -Dm755 "$srcdir/hanoip-led" "$pkgdir/usr/bin/hanoip-led"
	install -Dm755 "$srcdir/hanoip-led.initd" "$pkgdir/etc/init.d/hanoip-led"
	install -Dm755 "$srcdir/hanoip-console.start" "$pkgdir/etc/local.d/10-hanoip-console.start"
	install -Dm755 "$srcdir/hanoip-cpufreq.start" "$pkgdir/etc/local.d/30-hanoip-cpufreq.start"
	install -Dm755 "$srcdir/hanoip-qbootctl.start" "$pkgdir/etc/local.d/20-hanoip-qbootctl.start"
	install -Dm755 "$srcdir/hanoip-tailscale-dns.start" "$pkgdir/etc/local.d/40-hanoip-tailscale-dns.start"
	install -Dm755 "$srcdir/hanoip-qgd" "$pkgdir/usr/bin/hanoip-qgd"
	install -Dm755 "$srcdir/hanoip-reboot-bootloader" "$pkgdir/usr/bin/hanoip-reboot-bootloader"
	install -Dm755 "$srcdir/hanoip-qgd.initd" "$pkgdir/etc/init.d/hanoip-qgd"
	install -Dm644 "$srcdir/hanoip-ssh.nft" "$pkgdir/etc/nftables.d/02_hanoip-ssh.nft"
	install -Dm644 "$srcdir/hanoip-samba.nft" "$pkgdir/etc/nftables.d/03_hanoip-samba.nft"
	install -Dm644 "$srcdir/hanoip-sshd.conf" "$pkgdir/etc/ssh/sshd_config.d/60-hanoip-keys-only.conf"
	install -Dm755 "$srcdir/hanoip-status" "$pkgdir/usr/bin/hanoip-status"
	install -Dm644 "$srcdir/hanoip-tailscale.nft" "$pkgdir/etc/nftables.d/52_hanoip-tailscale.nft"
	install -Dm755 "$srcdir/hanoip-thermal" "$pkgdir/usr/bin/hanoip-thermal"
	install -Dm755 "$srcdir/hanoip-thermal.initd" "$pkgdir/etc/init.d/hanoip-thermal"
	install -Dm755 "$srcdir/hanoip-watchdog" "$pkgdir/usr/bin/hanoip-watchdog"
	install -Dm755 "$srcdir/hanoip-watchdog.initd" "$pkgdir/etc/init.d/hanoip-watchdog"
	install -Dm755 "$srcdir/hanoip-dashboard" "$pkgdir/usr/bin/hanoip-dashboard"
	install -Dm644 "$startdir/dashboard/index.html" "$pkgdir/usr/share/hanoip-dashboard/index.html"
	install -Dm644 "$srcdir/hanoip-dashboard.service" "$pkgdir/etc/systemd/system/hanoip-dashboard.service"
	# The dashboard reads its package revision from here: nothing else on the image records it.
	install -d "$pkgdir/usr/share/device-motorola-hanoip"
	printf '%s\n' "$pkgrel" > "$pkgdir/usr/share/device-motorola-hanoip/pkgrel"
	install -Dm644 "$srcdir/org.freedesktop.login1.service" "$pkgdir/usr/share/device-motorola-hanoip/org.freedesktop.login1.service"

	# Mainline systemd units and scripts (installed here, moved to mainline subpackage by amove)
	install -Dm644 "$srcdir/hanoip-efs.service" "$pkgdir/etc/systemd/system/hanoip-efs.service"
	install -Dm755 "$srcdir/hanoip-efs" "$pkgdir/usr/bin/hanoip-efs"
	install -Dm644 "$srcdir/rmtfs.service" "$pkgdir/etc/systemd/system/rmtfs.service"
	install -Dm644 "$srcdir/hanoip-qrtr-ns.service" "$pkgdir/etc/systemd/system/hanoip-qrtr-ns.service"
	install -Dm644 "$srcdir/hanoip-pd-mapper.service" "$pkgdir/etc/systemd/system/hanoip-pd-mapper.service"
	install -Dm644 "$srcdir/tqftpserv.service" "$pkgdir/etc/systemd/system/tqftpserv.service"
	install -Dm644 "$srcdir/hanoip-modem.service" "$pkgdir/etc/systemd/system/hanoip-modem.service"
	install -Dm755 "$srcdir/hanoip-modem-load-modules" "$pkgdir/usr/bin/hanoip-modem-load-modules"
	install -Dm755 "$srcdir/hanoip-modem-start" "$pkgdir/usr/bin/hanoip-modem-start"
	install -Dm644 "$srcdir/hanoip-charge.service" "$pkgdir/etc/systemd/system/hanoip-charge.service"
	install -Dm755 "$srcdir/hanoip-charge-pre" "$pkgdir/usr/bin/hanoip-charge-pre"
	install -Dm644 "$srcdir/hanoip-usb-net.service" "$pkgdir/etc/systemd/system/hanoip-usb-net.service"
	install -Dm755 "$srcdir/hanoip-usb-net" "$pkgdir/usr/bin/hanoip-usb-net"
	install -Dm644 "$srcdir/hanoip-slot-mark.service" "$pkgdir/etc/systemd/system/hanoip-slot-mark.service"
	install -Dm755 "$srcdir/hanoip-ml-slot" "$pkgdir/usr/bin/hanoip-ml-slot"
	install -Dm644 "$srcdir/hanoip-bot.service" "$pkgdir/etc/systemd/system/hanoip-bot.service"
	install -Dm644 "$srcdir/hanoip-guard.service" "$pkgdir/etc/systemd/system/hanoip-guard.service"
	install -Dm755 "$srcdir/hanoip-guard" "$pkgdir/usr/bin/hanoip-guard"
	install -Dm644 "$srcdir/hanoip-deadman.service" "$pkgdir/etc/systemd/system/hanoip-deadman.service"
	install -Dm755 "$srcdir/hanoip-deadman" "$pkgdir/usr/bin/hanoip-deadman"
	install -Dm644 "$srcdir/hanoip-battery.service" "$pkgdir/etc/systemd/system/hanoip-battery.service"
	install -Dm755 "$srcdir/hanoip-battery" "$pkgdir/usr/bin/hanoip-battery"
	install -Dm644 "$srcdir/hanoip-ml-up.service" "$pkgdir/etc/systemd/system/hanoip-ml-up.service"
	install -Dm644 "$srcdir/hanoip-ml-networkmanager.conf" "$pkgdir/etc/NetworkManager/conf.d/hanoip-ml.conf"
	install -Dm755 "$srcdir/hanoip-ml-chrony" "$pkgdir/etc/NetworkManager/dispatcher.d/50-hanoip-ml-chrony"
	install -Dm644 "$srcdir/90-hanoip-watchdog.conf" "$pkgdir/etc/systemd/system.conf.d/90-hanoip-watchdog.conf"
	install -Dm755 "$srcdir/hanoip-ml-abl-slot" "$pkgdir/usr/bin/hanoip-ml-abl-slot"
	install -Dm755 "$srcdir/hanoip-ml-charge" "$pkgdir/usr/bin/hanoip-ml-charge"
	install -Dm644 "$srcdir/hanoip-ml.conf" "$pkgdir/etc/modprobe.d/hanoip-ml.conf"

	# Duranium: the USB gadget, the boot-health check and the charge limit, enabled by a preset (mkosi's preset-all removes enable
	# links in /etc); qbootctl.service (pmOS marks the slot good at multi-user.target, before anything is checked) is masked: hanoip-health marks it.
	install -Dm755 "$srcdir/hanoip-usb-gadget" "$pkgdir/usr/bin/hanoip-usb-gadget"
	install -Dm644 "$srcdir/hanoip-usb-gadget.service" "$pkgdir/etc/systemd/system/hanoip-usb-gadget.service"
	install -Dm755 "$srcdir/hanoip-usb-role" "$pkgdir/usr/bin/hanoip-usb-role"
	install -Dm644 "$srcdir/hanoip-usb-role.service" "$pkgdir/etc/systemd/system/hanoip-usb-role.service"
	install -Dm644 "$srcdir/hanoip-usb-role-watch.service" "$pkgdir/etc/systemd/system/hanoip-usb-role-watch.service"
	install -Dm755 "$srcdir/hanoip-health" "$pkgdir/usr/bin/hanoip-health"
	install -Dm644 "$srcdir/hanoip-health.service" "$pkgdir/etc/systemd/system/hanoip-health.service"
	# Wi-Fi off while eth0 carries the server (a poll loop: the NM dispatcher misses boot without eth0 and lost addresses).
	install -Dm755 "$srcdir/hanoip-ethernet-wifi" "$pkgdir/usr/bin/hanoip-ethernet-wifi"
	install -Dm644 "$srcdir/hanoip-ethernet-wifi.service" "$pkgdir/etc/systemd/system/hanoip-ethernet-wifi.service"
	install -Dm644 "$srcdir/hanoip-local.service" "$pkgdir/etc/systemd/system/hanoip-local.service"
	install -Dm644 "$srcdir/hanoip.preset" "$pkgdir/usr/lib/systemd/system-preset/10-hanoip.preset"
	ln -s /dev/null "$pkgdir/etc/systemd/system/qbootctl.service"
	# Bluetooth is unused; its MAC unit, started by udev, timed out now and then and left the system degraded. An empty
	# rules file of the same name hides pmOS's rule (a mask link in /etc is removed by mkosi's preset-all).
	install -Dm644 /dev/null "$pkgdir/etc/udev/rules.d/90-bootmac-bluetooth.rules"

	# The services of the 4.14 server on systemd (Alpine ships only OpenRC scripts): their users keep the old IDs, the NAS disk mounts on its own
	install -Dm644 "$srcdir/adguardhome.service" "$pkgdir/etc/systemd/system/adguardhome.service"
	install -Dm644 "$srcdir/smb.service" "$pkgdir/etc/systemd/system/smb.service"
	install -Dm644 "$srcdir/syncthing.service" "$pkgdir/etc/systemd/system/syncthing.service"
	install -Dm644 "$srcdir/hanoip-mnt-hd-a.mount" "$pkgdir/etc/systemd/system/mnt-hd\x2da.mount"
	install -Dm644 "$srcdir/hanoip-mnt-hd-b.mount" "$pkgdir/etc/systemd/system/mnt-hd\x2db.mount"
	install -Dm644 "$srcdir/hanoip-sysusers.conf" "$pkgdir/usr/lib/sysusers.d/20-hanoip-services.conf"

	# Heat protection and the power LED, as units (the scripts are shared with the 4.14 package)
	install -Dm644 "$srcdir/hanoip-thermal.service" "$pkgdir/etc/systemd/system/hanoip-thermal.service"
	install -Dm644 "$srcdir/hanoip-led.service" "$pkgdir/etc/systemd/system/hanoip-led.service"

	# What a headless server does not need, or needs bounded: no multicast name queries, no core files, a journal with a size limit, the backlight off
	install -Dm644 "$srcdir/hanoip-journald.conf" "$pkgdir/etc/systemd/journald.conf.d/90-hanoip.conf"
	install -Dm644 "$srcdir/hanoip-rtc.conf" "$pkgdir/etc/tmpfiles.d/hanoip-rtc.conf"
	install -Dm644 "$srcdir/hanoip-resolved.conf" "$pkgdir/etc/systemd/resolved.conf.d/10-hanoip.conf"
	install -Dm644 "$srcdir/hanoip-coredump.conf" "$pkgdir/etc/systemd/coredump.conf.d/10-hanoip.conf"
	install -Dm644 "$srcdir/hanoip-screen-off.service" "$pkgdir/etc/systemd/system/hanoip-screen-off.service"

	# sudo-rs asks PAM for the service sudo; without this file the image falls back to other, which refuses everyone
	install -Dm644 "$srcdir/hanoip-pam-sudo" "$pkgdir/etc/pam.d/sudo"

	# Modem and Wi-Fi userspace; modem() below moves it into its own subpackage.
	install -Dm755 "$srcdir/hanoip-qrtr-ns" "$pkgdir/usr/bin/hanoip-qrtr-ns"
	install -Dm755 "$srcdir/hanoip-pd-mapper" "$pkgdir/usr/bin/hanoip-pd-mapper"
	install -Dm755 "$srcdir/hanoip-tqftpserv" "$pkgdir/usr/bin/hanoip-tqftpserv"
	install -Dm755 "$srcdir/hanoip-qrtr-ns.initd" "$pkgdir/etc/init.d/hanoip-qrtr-ns"
	install -Dm755 "$srcdir/hanoip-pd-mapper.initd" "$pkgdir/etc/init.d/hanoip-pd-mapper"
	install -Dm755 "$srcdir/hanoip-tqftpserv.initd" "$pkgdir/etc/init.d/hanoip-tqftpserv"
	install -Dm755 "$srcdir/hanoip-rmtfs.initd" "$pkgdir/etc/init.d/hanoip-rmtfs"
	install -Dm755 "$srcdir/hanoip-modem.initd" "$pkgdir/etc/init.d/hanoip-modem"
	install -Dm644 "$srcdir/hanoip-modem.rules" "$pkgdir/usr/lib/udev/rules.d/90-hanoip-modem.rules"
}

modem() {
	pkgdesc="Modem and Wi-Fi userspace for the Moto G (60): QRTR name server, pd-mapper, tqftpserv, rmtfs, hanoip-modem"
	# The firmware in /lib/firmware and the modem's /var/lib/tqftpserv come from the phone itself and are not packaged.
	depends="$pkgname rmtfs"
	amove usr/bin/hanoip-qrtr-ns usr/bin/hanoip-pd-mapper usr/bin/hanoip-tqftpserv \
		etc/init.d/hanoip-qrtr-ns etc/init.d/hanoip-pd-mapper etc/init.d/hanoip-tqftpserv \
		etc/init.d/hanoip-rmtfs etc/init.d/hanoip-modem usr/lib/udev/rules.d/90-hanoip-modem.rules
}

kernel_downstream() {
	pkgdesc="Downstream kernel (cool585 Cybertron, works)"
	depends="linux-motorola-hanoip"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

kernel_mainline() {
	pkgdesc="Mainline kernel for Motorola Moto G (60)"
	depends="linux-motorola-hanoip-mainline systemd-boot $pkgname-mainline"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

mainline() {
	pkgdesc="Mainline root services for Motorola Moto G (60): modem, charge limit, guard, slot marking, watchdog, network"
	# The modem subpackage carries the binaries the modem units run (and rmtfs): without it pmOS's tqftpserv.service, which these
	# units replace, would fail at every boot.
	depends="
		$pkgname
		$pkgname-modem
		adguardhome
		samba-server
		samba-common-tools
		syncthing
		btop
		btrfs-progs
		btrfs-progs-extra
		debootstrap
		doas
		fastfetch
		gcompat
		hwloc-tools
		iperf3
		iw
		libdrm-tests
		libstdc++
		memtester
		musl-utils
		openssl
		smartmontools
		stress-ng
		sudo-rs
		tar
		tzdata
		wget
	"
	amove etc/systemd/system/hanoip-efs.service etc/systemd/system/rmtfs.service \
		etc/systemd/system/hanoip-qrtr-ns.service etc/systemd/system/hanoip-pd-mapper.service \
		etc/systemd/system/tqftpserv.service etc/systemd/system/hanoip-modem.service \
		etc/systemd/system/hanoip-charge.service etc/systemd/system/hanoip-usb-net.service \
		etc/systemd/system/hanoip-slot-mark.service etc/systemd/system/hanoip-bot.service \
		etc/systemd/system/hanoip-guard.service etc/systemd/system/hanoip-deadman.service \
		etc/systemd/system/hanoip-battery.service etc/systemd/system/hanoip-ml-up.service \
		etc/systemd/system.conf.d/90-hanoip-watchdog.conf \
		usr/bin/hanoip-efs usr/bin/hanoip-modem-load-modules usr/bin/hanoip-modem-start \
		usr/bin/hanoip-charge-pre usr/bin/hanoip-usb-net usr/bin/hanoip-ml-slot \
		usr/bin/hanoip-guard usr/bin/hanoip-deadman usr/bin/hanoip-battery \
		usr/bin/hanoip-ml-abl-slot usr/bin/hanoip-ml-charge \
		etc/modprobe.d/hanoip-ml.conf \
		etc/NetworkManager/conf.d/hanoip-ml.conf \
		etc/NetworkManager/dispatcher.d/50-hanoip-ml-chrony \
		usr/bin/hanoip-usb-gadget etc/systemd/system/hanoip-usb-gadget.service \
		usr/bin/hanoip-usb-role etc/systemd/system/hanoip-usb-role.service etc/systemd/system/hanoip-usb-role-watch.service \
		usr/bin/hanoip-health etc/systemd/system/hanoip-health.service \
		usr/bin/hanoip-ethernet-wifi etc/systemd/system/hanoip-ethernet-wifi.service \
		etc/systemd/system/hanoip-local.service \
		usr/lib/systemd/system-preset etc/systemd/system/qbootctl.service etc/udev/rules.d/90-bootmac-bluetooth.rules \
		etc/systemd/system/adguardhome.service etc/systemd/system/smb.service etc/systemd/system/syncthing.service etc/systemd/system/mnt-hd\\x2da.mount etc/systemd/system/mnt-hd\\x2db.mount usr/lib/sysusers.d/20-hanoip-services.conf \
		etc/systemd/system/hanoip-thermal.service etc/systemd/system/hanoip-led.service \
		etc/systemd/journald.conf.d/90-hanoip.conf etc/tmpfiles.d/hanoip-rtc.conf etc/systemd/resolved.conf.d/10-hanoip.conf etc/systemd/coredump.conf.d/10-hanoip.conf etc/systemd/system/hanoip-screen-off.service \
		etc/pam.d/sudo
}

