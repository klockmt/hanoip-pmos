# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: /proc/config.gz of the Cybertron v18 kernel running
# on LineageOS 22.1, plus DEVTMPFS, DEVTMPFS_MOUNT, USB_CONFIGFS_ECM,
# USB_CONFIGFS_RNDIS, SYSVIPC and FHANDLE for postmarketOS, nftables with its
# set backends, the qcacld WLAN driver, DEBUG_FS (needs patch 0002), and
# MMI_INFO + MMI_ANNOTATE: the modem needs the SMEM item they create for Wi-Fi.
# Patch 0003 is the icnss experiment for the Wi-Fi firmware crash.
# Patches 0004 and 0005 (+ FRAMEBUFFER_CONSOLE and fonts) put the console on the screen.
# Patch 0006 keeps the serial out of the log once MMI_INFO is on.
# Patch 0007 makes bms/cycle_counts writable, to restore the buckets a drained battery clears.
# Zram swap: CRYPTO_ZSTD (zram offers only what the crypto API has; postmarketos-zram-swap asks for zstd),
# patch 0008 (vm.swappiness up to 200, the script sets 180) and /lib/modules in the package (its modprobe zram
# fails without it, with zram built in).
# btrfs for the NAS disk (issue #19) needs patch 0009: this tree has timespec64 inode times, fs/btrfs did not.
# User/PID namespaces and the cgroups Docker needs (issue #4), and a software watchdog (/dev/watchdog).
pkgname=linux-motorola-hanoip
pkgver=4.14.357
pkgrel=11
pkgdesc="Motorola Moto G (60) downstream kernel (cool585 Cybertron v18)"
arch="aarch64"
_carch="arm64"
_flavor="motorola-hanoip"
url="https://github.com/cool585/android_kernel_motorola_sm6150"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="bash bc bison clang devicepkg-dev dtc flex kmod linux-headers lld llvm openssl-dev perl"

# Source
_repository="android_kernel_motorola_sm6150"
_commit="b92cb6cd8376a426543d48b80383c417a719a619"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/cool585/$_repository/archive/$_commit.tar.gz
	$_config
	0001-loop-rescan-partitions-after-block-size-change.patch
	0002-clk-drop-duplicate-all_lists-for-debugfs.patch
	0003-icnss-send-host-cap-regdb-and-bdf-like-cnss-daemon.patch
	0004-printk-map-console-null-to-tty0.patch
	0005-fbdev-add-hanoip-splash-framebuffer-console.patch
	0006-mmi-info-keep-the-serial-out-of-the-log.patch
	0007-qpnp-qg-let-cycle_counts-be-written.patch
	0008-sysctl-allow-vm.swappiness-up-to-200.patch
	0009-btrfs-use-timespec64-for-the-inode-times.patch
"
builddir="$srcdir/$_repository-$_commit"

prepare() {
	default_prepare
	. downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	# clang >= 16 turns these warnings into errors; the 4.14 tree still triggers them.
	_w="-Wno-error=incompatible-pointer-types -Wno-error=incompatible-function-pointer-types"
	_w="$_w -Wno-error=int-conversion -Wno-error=implicit-function-declaration -Wno-error=implicit-int"
	make ARCH="$_carch" LLVM=1 LLVM_IAS=1 CC=clang HOSTCC="clang $_w" \
		KCFLAGS="-Wno-error $_w" \
		DTC=dtc KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS" Image.gz dtbs modules
}

package() {
	# The DTB goes into vendor_boot (header v3), so ship the plain Image.gz.
	KERNEL_IMAGE_NAME=Image.gz downstreamkernel_package "$builddir" "$pkgdir" "$_carch" "$_flavor" "$_outdir"
	# Base DTB for vendor_boot; the stock dtbo applies the board overlay on top.
	install -Dm644 "$builddir/arch/$_carch/boot/dts/qcom/sdmmagpie-hanoi-base.dtb" \
		"$pkgdir/boot/dtbs/qcom/sdmmagpie-hanoi-base.dtb"
	# The module tree: modprobe fails without /lib/modules/<release> even for options built in (zramstart needs it).
	# kbuild's modules_install wants to write in the source tree, which pmbootstrap --envkernel hands to the build
	# user read-only, so do what it does: copy the modules modules.order lists (it names the installed path, under
	# kernel/), add modules.order and modules.builtin, and run depmod.
	_kver=$(cat "$builddir/$_outdir/include/config/kernel.release")
	_moddir="$pkgdir/lib/modules/$_kver"
	while read -r _m; do
		install -Dm644 "$builddir/$_outdir/${_m#kernel/}" "$_moddir/$_m"
	done < "$builddir/$_outdir/modules.order"
	install -m644 "$builddir/$_outdir/modules.order" "$builddir/$_outdir/modules.builtin" "$_moddir/"
	depmod -a -b "$pkgdir" "$_kver"
}

