# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: /proc/config.gz of the Cybertron v18 kernel running
# on LineageOS 22.1, plus DEVTMPFS, DEVTMPFS_MOUNT, USB_CONFIGFS_ECM,
# USB_CONFIGFS_RNDIS, SYSVIPC and FHANDLE for postmarketOS, nftables with its
# set backends, the qcacld WLAN driver and DEBUG_FS (needs patch 0002).
# Patch 0003 is the icnss experiment for the Wi-Fi firmware crash.
pkgname=linux-motorola-hanoip
pkgver=4.14.357
pkgrel=3
pkgdesc="Motorola Moto G (60) downstream kernel (cool585 Cybertron v18)"
arch="aarch64"
_carch="arm64"
_flavor="motorola-hanoip"
url="https://github.com/cool585/android_kernel_motorola_sm6150"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="bash bc bison clang devicepkg-dev dtc flex linux-headers lld llvm openssl-dev perl"

# Source
_repository="android_kernel_motorola_sm6150"
_commit="b92cb6cd8376a426543d48b80383c417a719a619"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/cool585/$_repository/archive/$_commit.tar.gz
	$_config
	0001-loop-rescan-partitions-after-block-size-change.patch
	0002-clk-drop-duplicate-all_lists-for-debugfs.patch
	0003-icnss-send-host-cap-regdb-and-bdf-like-cnss-daemon.patch
"
builddir="$srcdir/$_repository-$_commit"

prepare() {
	default_prepare
	. downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	# clang >= 16 turns these warnings into errors; the 4.14 tree still triggers them.
	_w="-Wno-error=incompatible-pointer-types -Wno-error=incompatible-function-pointer-types"
	_w="$_w -Wno-error=int-conversion -Wno-error=implicit-function-declaration -Wno-error=implicit-int"
	make ARCH="$_carch" LLVM=1 LLVM_IAS=1 CC=clang HOSTCC="clang $_w" \
		KCFLAGS="-Wno-error $_w" \
		DTC=dtc KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS" Image.gz dtbs
}

package() {
	# The DTB goes into vendor_boot (header v3), so ship the plain Image.gz.
	KERNEL_IMAGE_NAME=Image.gz downstreamkernel_package "$builddir" "$pkgdir" "$_carch" "$_flavor" "$_outdir"
	# Base DTB for vendor_boot; the stock dtbo applies the board overlay on top.
	install -Dm644 "$builddir/arch/$_carch/boot/dts/qcom/sdmmagpie-hanoi-base.dtb" \
		"$pkgdir/boot/dtbs/qcom/sdmmagpie-hanoi-base.dtb"
}

