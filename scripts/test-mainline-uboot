#!/bin/sh
# Checks the persistent-boot U-Boot and the boot_a image (no phone needed): the environment reads the kernel image from
# where scripts/mainline-boot-a-image puts it, boots it with the embedded DTB, resets when that fails, and the U-Boot
# cannot flash; then packs fake inputs and checks the layout.
set -eu
cd "$(dirname "$0")/.."
fail() { echo "FAIL: $*" >&2; exit 1; }
env=kernel/mainline/uboot/hanoip-server.env
cfg=kernel/mainline/uboot/server.config
img=scripts/mainline-boot-a-image
grep -qx 'boot_with_embedded_fdt=1' "$env" || fail "the kernel would get the boot image's DTB, not U-Boot's"
grep -q '^ml_load_boot=.*setexpr ml_blk $ml_start + 0x1000 && scsi dev $ml_dev && scsi read $fastboot_addr_r $ml_blk 0x2000 && abootimg addr $fastboot_addr_r && bootm $fastboot_addr_r$' "$env" ||
	fail "ml_load_boot does not read 32 MiB at 16 MiB into boot_a and bootm it"
# scsi read reads the current device, not the one part found boot_a on: boot_a is on LUN 4, the default is 0 (2026-11-08).
grep '^ml_load_boot=' "$env" | grep -qF 'scsi dev $ml_dev && scsi read ' || fail "scsi read would read LUN 0, not boot_a's LUN"
grep -q '^ml_legacy=.*part number scsi $d boot${ml_slot} ml_part' "$env" || fail "boot_a / boot_b is not found by name from the slot"
# Duranium (docs/DURANIUM.md steps 5 and 6): from either slot, U-Boot presents userdata through blkmap and boots the EFI loader of
# a first partition of the ESP's type, so the 4.14's filesystems are never read; the Alpine root in super (ml_legacy) is the last
# resort, taken only when that fails, and the Volume Down menu can start it by hand.
grep -qx 'ml_boot=scsi scan; run ml_efi; run ml_legacy' "$env" ||
	fail "ml_boot does not try Duranium first from both slots, then the Alpine root in super"
grep -qx 'bootmenu_2=Boot the Alpine rescue root (super)=scsi scan; run ml_legacy; echo hanoip: no rescue image in boot${ml_slot}; pause' "$env" ||
	fail "the Volume Down menu has no way to start the Alpine rescue by hand"
! grep -v '^#' "$env" | grep -q 'ml_slot}" = _a' || fail "the EFI try is still limited to slot a"
grep '^ml_efi_load=' "$env" | grep -qF 'test "${ml_esp}" = c12a7328-f81f-11d2-ba4b-00a0c93ec93b' || fail "the first partition is not checked for the ESP type"
grep '^ml_efi_load=' "$env" | grep -qF 'blkmap map ml_root 0 $ml_ud_size linear scsi $ml_ud_dev 0x$ml_ud_start' || fail "userdata is not mapped through blkmap (part start prints hex without 0x)"
grep '^ml_efi_load=' "$env" | grep -qF 'load blkmap ${ml_bm}:1 $kernel_addr_r EFI/BOOT/BOOTAA64.EFI && bootefi $kernel_addr_r' || fail "the EFI loader is not booted from the ESP"
if grep -v '^#' "$env" | grep -q -E '(scsi|mmc|fat|ext4|blkmap) *(write|erase)|fatwrite|ext4write'; then fail "the environment writes a disk"; fi
# The patches the build applies after 0001: the quiesce hook runs for the EFI handoff too (UFS and USB powered down before
# the kernel), and the ABL's slot reaches the environment as $ml_slot (only that argument of its command line is read).
qp=kernel/mainline/uboot/0002-run-the-quiesce-hook-for-the-efi-handoff.patch
sp=kernel/mainline/uboot/0003-export-the-abl-slot-to-the-environment.patch
grep -q '^+void board_quiesce_devices(void)' "$qp" || fail "$qp does not define board_quiesce_devices()"
grep -q 'env_set("ml_slot"' "$sp" && grep -q 'androidboot.slot_suffix=' "$sp" || fail "$sp does not export the slot as ml_slot"
grep -qx 'bootcmd=run ml_boot; echo hanoip: mainline boot failed, resetting; sleep 5; reset' "$env" ||
	fail "a failed boot does not reset (the ABL would never fall back to slot b)"
# A key already pending at autoboot (seen on the phone, 2026-11-08: "stop autoboot: 0 ^H^H^H 0") stops bootdelay=0 and
# left U-Boot at its prompt for good; -2 boots without checking for a key. Volume Down still opens the menu.
grep -qx 'bootdelay=-2' "$env" || fail "a pending key at autoboot would stop the boot at the U-Boot prompt"
# The offsets of the environment and of the image script agree.
grep -qF 'OFF=$((16 * 1048576))' "$img" && grep -qF 'MAX=$((32 * 1048576))' "$img" || fail "$img does not use 16 MiB / 32 MiB"
grep -qx '# CONFIG_FASTBOOT_FLASH is not set' "$cfg" || fail "this U-Boot could flash"
grep -qx 'CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/hanoip-server.env"' "$cfg" ||
	fail "the default environment is not hanoip-server.env (base.config points at the diagnostic one)"
grep -qx 'CONFIG_QCOM_UFS=y' "$cfg" || fail "no UFS: the kernel in boot_a cannot be read"
# The watchdog starts with U-Boot, nothing feeds it until the kernel and the handoff does not stop it (2026-11-08):
# a U-Boot that fed it sat at its prompt for good, and his handoff left the kernel without one until stage 1.
grep -qx '# CONFIG_WATCHDOG is not set' "$cfg" && grep -qx 'CONFIG_WATCHDOG_AUTOSTART=y' "$cfg" ||
	fail "U-Boot would feed the watchdog, or not start it"
wp=kernel/mainline/uboot/0001-leave-the-watchdog-running-for-the-kernel.patch
[ "$(grep -c '^-.*wdt_stop_all();' "$wp")" = 2 ] || fail "$wp does not drop both wdt_stop_all() calls"
grep -qF 'for p in "$ml"/*.patch; do git -C "$u/git" apply' scripts/build-mainline-uboot ||
	fail "scripts/build-mainline-uboot does not apply kernel/mainline/uboot/*.patch"
grep -qx 'button_cmd_0=wdt dev watchdog@17c10000; wdt stop; run menucmd' "$env" ||
	fail "the watchdog would reset the phone while the Volume Down menu waits for a person"

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
{ printf 'ANDROID!'; head -c 4088 /dev/zero; } > "$dir/u.img"
{ printf 'ANDROID!'; head -c 100000 /dev/urandom; } > "$dir/k.img"
UBOOT_IMG=$dir/u.img KERNEL_IMG=$dir/k.img sh "$img" "$dir/a.img" >/dev/null || fail "packing fake inputs failed"
cmp -s -n 4096 "$dir/u.img" "$dir/a.img" || fail "U-Boot is not at the start"
[ "$(tail -c +$((16 * 1048576 + 1)) "$dir/a.img" | cmp -s - "$dir/k.img" && echo same)" = same ] || fail "the kernel image is not at 16 MiB"
{ printf 'ANDROID!'; head -c $((32 * 1048576)) /dev/zero; } > "$dir/big.img"
if UBOOT_IMG=$dir/u.img KERNEL_IMG=$dir/big.img sh "$img" "$dir/b.img" >/dev/null 2>&1; then fail "a kernel image over 32 MiB was packed"; fi
echo "ok    test-mainline-uboot"
