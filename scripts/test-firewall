#!/bin/sh
# Checks the SSH firewall rule without the phone: it parses, it lets in only USB and the tailnet, and it is
# loaded before pmOS's own 50_sshd.nft, which accepts port 22 from every interface (nftables.d files load in
# name order, and the first rule that matches wins).
set -eu
cd "$(dirname "$0")/.."
pkg=pmaports/device/testing/device-motorola-hanoip
rule=$pkg/hanoip-ssh.nft
bad=0
fail() { echo "FAIL: $*" >&2; bad=1; }
[ -f "$rule" ] || { echo "FAIL: $rule is missing" >&2; exit 1; }

dest=$(sed -n 's|.*"\$pkgdir\(/etc/nftables.d/[^"]*\)".*|\1|p' $pkg/APKBUILD | grep -F hanoip-ssh || true)
[ -n "$dest" ] || fail "the APKBUILD does not install hanoip-ssh.nft into /etc/nftables.d"
[ "$(printf '%s\n%s\n' "$(basename "${dest:-x}")" 50_sshd.nft | sort | head -1)" = "$(basename "${dest:-x}")" ] ||
	fail "$dest loads after 50_sshd.nft, whose accept would win"

grep -q 'iifname "usb\*" tcp dport 22 accept' "$rule" || fail "USB is not allowed to reach port 22"
grep -q 'iifname "tailscale0" tcp dport 22 accept' "$rule" || fail "the tailnet is not allowed to reach port 22"
last=$(grep -v '^[[:space:]]*#' "$rule" | grep 'tcp dport 22' | tail -1)
case $last in *drop*) ;; *) fail "the last port 22 rule must drop everything else" ;; esac
# Anything that accepts port 22 from every interface must come after the drop, never before it.
if grep -v '^[[:space:]]*#' "$rule" | grep 'tcp dport 22' | grep -v iifname | grep -q accept; then fail "an accept without iifname opens port 22 to all"; fi

# Tailscale's own file: UDP 41641 (direct connections) only on the local interfaces, never everywhere.
ts=$pkg/hanoip-tailscale.nft
if [ ! -f "$ts" ]; then fail "$ts is missing"; else
	grep -q 'iifname "tailscale0" accept' "$ts" || fail "the tailnet interface is not accepted"
	grep -v '^[[:space:]]*#' "$ts" | grep 'udp dport 41641' | grep -q 'iifname' || fail "UDP 41641 is accepted on every interface"
	for i in 'eth\*' 'wlan\*'; do grep -v '^[[:space:]]*#' "$ts" | grep "iifname \"$i\" udp dport 41641 accept" >/dev/null || fail "UDP 41641 is not accepted on $i"; done
	[ "$(grep -v '^[[:space:]]*#' "$ts" | grep -c 'udp dport 41641')" = 2 ] || fail "UDP 41641 must be accepted on exactly eth* and wlan*"
	grep -q '"\$pkgdir/etc/nftables.d/52_hanoip-tailscale.nft"' $pkg/APKBUILD || fail "the APKBUILD does not install hanoip-tailscale.nft"
	sed -n '/^depends="/,/"/p' $pkg/APKBUILD | grep -qx '[[:space:]]*tailscale' || fail "the package does not depend on tailscale"
	# apk runs post-install only on a fresh install; a phone that already has the hand-made file upgrades.
	for h in post-install post-upgrade; do
		f=$pkg/device-motorola-hanoip.$h
		grep -q 'rm -f /etc/nftables.d/52_tailscale.nft' "$f" 2>/dev/null || fail "$h does not remove the hand-made 52_tailscale.nft (UDP 41641 everywhere)"
		# the real hand-made file must match the pattern the script looks for, and the new file must not
		old_file='iifname "tailscale0" accept comment "Allow traffic over the tailnet"
	udp dport 41641 accept comment "Tailscale direct connections"'
		pat=$(sed -n 's/^grep -q "\(.*\)" \/etc.*/\1/p' "$f" | sed 's/\\"/"/g')
		printf '%s\n' "$old_file" | grep -q "$pat" || fail "$h looks for a line the hand-made file does not have: $pat"
		grep -q "$pat" "$ts" && fail "$h would also delete the packaged file's rule"
	done
	grep -q 'post-upgrade' $pkg/APKBUILD || fail "the APKBUILD does not list the post-upgrade script in install="
	if unshare -rn true 2>/dev/null; then unshare -rn nft -c -f "$ts" || fail "nft rejects $ts"; fi
fi

# Samba: 51_usb_inet.nft accepts all of USB, so the share needs its own drop, loaded before it, and only the tailnet in.
smb=$pkg/hanoip-samba.nft
if [ ! -f "$smb" ]; then fail "$smb is missing"; else
	sdest=$(sed -n 's|.*"\$pkgdir\(/etc/nftables.d/[^"]*\)".*|\1|p' $pkg/APKBUILD | grep -F hanoip-samba || true)
	[ -n "$sdest" ] || fail "the APKBUILD does not install hanoip-samba.nft into /etc/nftables.d"
	[ "$(printf '%s\n%s\n' "$(basename "${sdest:-x}")" 51_usb_inet.nft | sort | head -1)" = "$(basename "${sdest:-x}")" ] ||
		fail "$sdest loads after 51_usb_inet.nft, whose accept would win"
	grep -v '^[[:space:]]*#' "$smb" | grep 'dport' | grep -q 'iifname "tailscale0" tcp dport { 139, 445 } accept' || fail "the tailnet is not allowed to reach Samba"
	last=$(grep -v '^[[:space:]]*#' "$smb" | grep 'dport' | tail -1)
	case $last in *drop*) ;; *) fail "the last Samba rule must drop everything else" ;; esac
	if grep -v '^[[:space:]]*#' "$smb" | grep 'dport' | grep -v iifname | grep -q accept; then fail "an accept without iifname opens Samba to all"; fi
	if unshare -rn true 2>/dev/null; then unshare -rn nft -c -f "$smb" || fail "nft rejects $smb"; fi
fi

# The syntax, checked by nft in a throwaway network namespace (skipped when the host cannot do that).
if unshare -rn true 2>/dev/null; then
	unshare -rn nft -c -f "$rule" || fail "nft rejects $rule"
else
	echo "skip: no user namespaces here, syntax not checked" >&2
fi
[ $bad -eq 0 ] && echo "firewall: ok"
exit $bad
