#!/bin/sh
# Copies the modem/Wi-Fi/IPA/DSP firmware from the collection to /lib/firmware on the device.
# Limited to 1 MB/s: large continuous transfers bring the device's USB (NCM) network down.
set -eu
. "$(dirname "$0")/env.sh"
img=$HANOIP_COLLECTION_DIR/firmware/vendor/firmware_mnt/image
cd "$img"
files=$(ls | grep -E '^(modem\.(mdt|b[0-9]+)|wlanmdsp\.mbn|.*\.jsn|mcfg_(hw|sw)\.mbn|mbn_(hw|sw)\.(dig|txt)|qdsp6m\.qdb|regdb\.bin|bdwlan.*|ipa_fws\..*|adsp\..*|cdsp\..*)$')
tar -cf - $files | pv -L 1m | "$(dirname "$0")/hanoip-ssh" 'sudo tar -xf - -C /lib/firmware'
"$(dirname "$0")/hanoip-ssh" 'sudo mkdir -p /lib/firmware/wlan/qca_cld && sudo tee /lib/firmware/wlan/qca_cld/WCNSS_qcom_cfg.ini >/dev/null' \
	< "$HANOIP_COLLECTION_DIR/firmware/vendor/etc/wifi/WCNSS_qcom_cfg.ini"
