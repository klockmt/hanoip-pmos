#!/bin/sh
# Restores the 8 battery cycle buckets a fully drained battery cleared from the PMIC (needs the kernel with
# patch 0007, where bms/cycle_counts can be written). The saved buckets (HANOIP_CYCLE_BUCKETS in .env) are added
# to what the phone has counted since the loss, so no cycle is lost; the sum is written once, read back and
# compared, and a marker on the phone stops a second run from adding them again (FORCE=1 overrides).
# DRY_RUN=1 only prints the write. HANOIP_CYCLE_CURRENT replaces the read from the phone (for tests).
set -eu
if [ -z "${HANOIP_CYCLE_BUCKETS:-}" ]; then . "$(dirname "$0")/env.sh"; fi
[ -n "${HANOIP_CYCLE_BUCKETS:-}" ] || { echo "HANOIP_CYCLE_BUCKETS is not set in .env (8 counts)." >&2; exit 1; }
dir=$(dirname "$0")
psy=/sys/class/power_supply/bms/cycle_counts
marker=/var/lib/hanoip/cycle-restored

phone() { "$dir/hanoip-ssh" "$@"; }
root() { "$dir/hanoip-sudo" "$1"; }
valid() { echo "$1" | awk '{ if (NF != 8) exit 1; for (i = 1; i <= NF; i++) if ($i !~ /^[0-9]+$/ || $i > 65535) exit 1 }'; }

valid "$HANOIP_CYCLE_BUCKETS" || { echo "HANOIP_CYCLE_BUCKETS must be 8 counts of 0-65535." >&2; exit 1; }
if [ -n "${HANOIP_CYCLE_CURRENT:-}" ]; then
	current=$HANOIP_CYCLE_CURRENT
else
	[ -n "${FORCE:-}" ] || ! phone "test -e $marker" || { echo "Already restored (marker $marker on the phone). FORCE=1 to add again." >&2; exit 1; }
	phone "test -w $psy" || { echo "$psy is not writable: the phone runs a kernel without patch 0007." >&2; exit 1; }
	current=$(phone "cat $psy")
fi
valid "$current" || { echo "Unexpected cycle_counts from the phone: '$current'" >&2; exit 1; }
total=$(echo "$HANOIP_CYCLE_BUCKETS $current" | awk '{ for (i = 1; i <= 8; i++) { s = $i + $(i + 8); if (s > 65535) exit 1; printf "%d%s", s, i < 8 ? " " : "\n" } }') ||
	{ echo "A bucket would pass 65535." >&2; exit 1; }
echo "saved:   $HANOIP_CYCLE_BUCKETS"
echo "counted: $current"
echo "writing: $total"
if [ -n "${DRY_RUN:-}" ]; then echo "+ echo '$total' > $psy"; exit 0; fi
root "echo '$total' > $psy"
back=$(phone "cat $psy")
[ "$(echo $back)" = "$total" ] || { echo "Read back '$back', expected '$total'." >&2; exit 1; }
root "mkdir -p /var/lib/hanoip && date +%F > $marker"
echo "restored. Next: remove /var/lib/hanoip/cycle-offset and the offset code in hanoip-status."
