#!/bin/sh
# Checks hanoip-qgd's arithmetic and struct layout without the phone: the coulomb count, the OCV
# corrections, the full-battery reset, where it starts counting from, and the data it writes back.
# The checks live in the #[cfg(test)] module at the bottom of hanoip-qgd.rs.
set -eu
cd "$(dirname "$0")/.."
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
rustc --edition 2021 --test -o "$tmp/qgd-test" pmaports/device/testing/device-motorola-hanoip/hanoip-qgd.rs
"$tmp/qgd-test" -q
echo "qgd: all checks pass"
