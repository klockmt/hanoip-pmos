#!/bin/sh
# Checks the downstream kernel config for options that bugs on this phone showed to be required
# (no hardware needed). Each line: the option, the value it must have, and the bug behind it.
set -eu
cd "$(dirname "$0")/.."
config=pmaports/device/downstream/linux-motorola-hanoip/config-motorola-hanoip.aarch64
bad=0
want() {
	if [ "$2" = n ]; then
		grep -qx "CONFIG_$1=[ym]" "$config" || return 0
	else
		grep -qx "CONFIG_$1=$2" "$config" && return 0
	fi
	echo "FAIL: CONFIG_$1 must be $2 ($3)" >&2
	bad=1
}
# Without SMEM item 134 (mmi_unit_info) the modem crashes as Wi-Fi starts (EX:kernel:0x0:tmr_slave1).
want MMI_INFO y "creates SMEM item 134 for the modem"
want MMI_ANNOTATE y "MMI_INFO links against it"
# nftables rules with sets fail with "Not supported" without the set backends; no modules are installed.
want NFT_SET_HASH y "nftables sets"
want NFT_SET_RBTREE y "nftables sets"
want NFT_SET_BITMAP y "nftables sets"
# Each missing firmware file waited 60 s, so every boot took ~3 min.
want FW_LOADER_USER_HELPER_FALLBACK n "boot waits 60 s per missing firmware"
# The NAS disk is btrfs (issue #19); without it the kernel cannot mount the disk at all.
want BTRFS_FS y "the NAS disk is btrfs"
want BTRFS_FS_POSIX_ACL y "btrfs ACLs"
# This tree has timespec64 inode times and fs/btrfs does not, so BTRFS_FS=y alone does not build.
grep -q '^\s*0009-.*btrfs.*\.patch' pmaports/device/downstream/linux-motorola-hanoip/APKBUILD ||
	{ echo "FAIL: the APKBUILD does not apply the btrfs timespec64 patch (fs/btrfs does not build without it)" >&2; bad=1; }
# Containers (issue #4): the options Docker and Podman call necessary and this kernel lacked.
want USER_NS y "user namespaces (rootless containers)"
want PID_NS y "PID namespaces"
want CGROUP_PIDS y "pids cgroup (--pids-limit)"
want CGROUP_DEVICE y "devices cgroup"
want POSIX_MQUEUE y "POSIX message queues"
want NETFILTER_XT_MATCH_ADDRTYPE y "docker's NAT rules match on address type"
# load_module() forced the IGNORE_* flags: module_sig_check() (checks only when flags == 0) never verified, so with
# MODULE_SIG_FORCE every module failed with ENOKEY, and check_modinfo() then refused the vermagic with ENOEXEC
# (issue #24). Patch 0010 stops forcing them.
grep -q '^\s*0010-.*module.*\.patch' pmaports/device/downstream/linux-motorola-hanoip/APKBUILD ||
	{ echo "FAIL: the APKBUILD does not apply the module signature patch (every signed module is refused)" >&2; bad=1; }
# br_netfilter is built in, not a module: Docker needs it loaded before the engine starts, and built in nothing has to
# order that. (Modules do load now, see patch 0010.)
want BRIDGE_NETFILTER y "docker needs br_netfilter loaded before the engine starts"
want IP6_NF_TARGET_MASQUERADE y "docker's IPv6 NAT"
want BLK_DEV_THROTTLING y "container disk limits"
want MACVLAN y "containers with their own address on the LAN"
# A watchdog device for a headless server (issues #4 and #17). The Qualcomm one (QCOM_WATCHDOG_V2) has no
# /dev/watchdog, so this is the software one: it restarts the phone when userspace stops feeding it.
want WATCHDOG y "watchdog core"
want SOFT_WATCHDOG y "/dev/watchdog for a headless server"
# postmarketos-zram-swap asks for zstd unless deviceinfo says otherwise, and zram only offers an algorithm the
# crypto API has: without this the swap never starts.
want CRYPTO_ZSTD y "zram swap defaults to zstd"
# zramstart runs `modprobe zram` under set -e; with no /lib/modules in the package it fails even though zram is
# built in. The kernel package has to install the module tree.
apk=pmaports/device/downstream/linux-motorola-hanoip/APKBUILD
# (Code lines only: a comment that mentions the module tree must not satisfy this.)
grep -v '^[[:space:]]*#' "$apk" | grep -q 'depmod' && grep -v '^[[:space:]]*#' "$apk" | grep -q 'lib/modules' ||
	{ echo "FAIL: $apk does not install /lib/modules (modprobe zram fails without it)" >&2; bad=1; }
# zramstart sets vm.swappiness=180; this kernel stops at 100 unless patch 0008 raises the limit.
grep -q '^\s*0008-.*swappiness.*\.patch' "$apk" || { echo "FAIL: $apk does not apply the swappiness patch (sysctl rejects 180)" >&2; bad=1; }
[ $bad -eq 0 ] && echo "kernel config: ok"
exit $bad
