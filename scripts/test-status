#!/bin/sh
# Checks hanoip-status against a fake /sys and fake ip/ping (no hardware needed): one line per item in the
# order -h describes, the labelled lines (CPU, GPU on/off, RAM and ROM temperatures) and the power lines on
# the battery, charging and in bypass.
set -eu
cd "$(dirname "$0")/.."
script=$PWD/pmaports/device/testing/device-motorola-hanoip/hanoip-status
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
sys=$dir/sys
mkdir -p "$dir/bin" "$sys/class/net/eth0/statistics" "$sys/class/kgsl/kgsl-3d0/device/power" \
	"$sys/class/power_supply/battery" "$sys/class/power_supply/usb" \
	"$sys/devices/system/cpu/cpufreq/policy0" "$sys/devices/system/cpu/cpufreq/policy6"
printf '#!/bin/sh\necho "default via 10.0.0.1 dev eth0"\n' > "$dir/bin/ip"
# The gateway answers in 0.887 ms and the internet host in 4.5 ms; an unreachable host (HANOIP_PING_HOST=down) says nothing.
printf '#!/bin/sh\ncase "$*" in *down*) ;; *10.0.0.1*) echo "rtt min/avg/max/mdev = 0.800/0.887/1.000/0.050 ms" ;; *) echo "rtt min/avg/max/mdev = 4.000/4.500/5.000/0.050 ms" ;; esac\n' > "$dir/bin/ping"
chmod +x "$dir/bin/ip" "$dir/bin/ping"
echo 0 > "$sys/class/net/eth0/statistics/rx_bytes"
echo 0 > "$sys/class/net/eth0/statistics/tx_bytes"
echo 300000 > "$sys/devices/system/cpu/cpufreq/policy0/scaling_cur_freq"
echo 2304000 > "$sys/devices/system/cpu/cpufreq/policy6/scaling_cur_freq"
echo "12 %" > "$sys/class/kgsl/kgsl-3d0/gpu_busy_percentage"
echo 140000000 > "$sys/class/kgsl/kgsl-3d0/gpuclk"
echo suspended > "$sys/class/kgsl/kgsl-3d0/device/power/runtime_status"
n=0
for z in cpu-0-0-usr:37800 cpu-1-0-usr:41200 gpuss-0-usr:35000 gpuss-1-usr:36500 ddr-usr:38200 nvm-therm-adc:34675 quiet_therm:34400 battery:31600; do
	mkdir "$sys/class/thermal/thermal_zone$n" 2>/dev/null || mkdir -p "$sys/class/thermal/thermal_zone$n"
	echo "${z%%:*}" > "$sys/class/thermal/thermal_zone$n/type"
	echo "${z##*:}" > "$sys/class/thermal/thermal_zone$n/temp"
	n=$((n + 1))
done
b=$sys/class/power_supply/battery u=$sys/class/power_supply/usb
echo 81 > "$b/capacity"; echo 4330000 > "$b/voltage_now"; echo 1 > "$b/cycle_count"; echo 316 > "$b/temp"
echo 100000 > "$u/input_current_now"; echo 9000000 > "$u/voltage_now"
export HANOIP_SYS_DIR=$sys PATH="$dir/bin:$PATH"

# state <status> <current_now> <charging_enabled> <input_suspend> <usb present>
state() { echo "$1" > "$b/status"; echo "$2" > "$b/current_now"; echo "$3" > "$b/charging_enabled"
	echo "$4" > "$b/input_suspend"; echo "$5" > "$u/present"; }
line() { sh "$script" | sed -n "${1}p"; }
expect() {
	[ "$2" = "$3" ] && return 0
	echo "FAIL: $1: got '$2', expected '$3'" >&2
	exit 1
}

state "Not charging" 0 0 0 1
out=$(sh "$script")
expect "one line per item described by -h" "$(echo "$out" | wc -l)" "$(sh "$script" -h | grep -c '^[0-9][0-9]*\.')"
expect "latency of the gateway and of 1.1.1.1" "$(echo "$out" | sed -n 1p)" "Server - 0.9 ms | 1.1.1.1  - 4.5 ms"
expect "an unreachable host says so" "$(HANOIP_PING_HOST=down sh "$script" | sed -n 1p)" "Server - 0.9 ms | down  - no reply"
expect "network" "$(echo "$out" | sed -n 2p)" "eth0 rx 0 kbit/s, tx 0 kbit/s"
expect "cpu clocks and hottest core" "$(echo "$out" | sed -n 3p | cut -d'|' -f2-)" " 300-2304 MHz | 41.2 °C"
expect "cpu label" "$(echo "$out" | sed -n 3p | cut -c1-6)" "CPU - "
expect "gpu off" "$(echo "$out" | sed -n 4p)" "GPU - 12 % | 140 MHz | 36.5 °C | off"
echo active > "$sys/class/kgsl/kgsl-3d0/device/power/runtime_status"
expect "gpu on" "$(line 4)" "GPU - 12 % | 140 MHz | 36.5 °C | on"
expect "ram label" "$(echo "$out" | sed -n 5p | cut -c1-6)" "RAM - "
expect "ram temperature" "$(echo "$out" | sed -n 5p | awk -F' [|] ' '{print $NF}')" "38.2 °C"
expect "rom temperature" "$(echo "$out" | sed -n 6p | awk -F' [|] ' '{print $NF}')" "34.7 °C"
expect "battery" "$(echo "$out" | sed -n 7p)" "Battery - 81 % | 4.33 V | 1 cycles | 31.6 °C"
expect "bypass on the cable" "$(echo "$out" | sed -n 8p)" "0.00 W | not charging • bypass"
expect "energy drain" "$(echo "$out" | sed -n 9p)" "Energy drain - 0.90 W • cable"
expect "body" "$(echo "$out" | sed -n 10p)" "Body - 34.4 °C"
state Charging 1000000 1 0 1
expect "charging" "$(line 8)" "4.33 W | charging"
expect "charging drain" "$(line 9)" "Energy drain - 0.90 W • cable"
state Discharging -500000 1 0 0
expect "on the battery" "$(line 8)" "2.17 W | not charging"
expect "battery drain" "$(line 9)" "Energy drain - 2.17 W • battery"
state "Not charging" -500000 0 1 1
expect "cable suspended runs from the battery" "$(line 9)" "Energy drain - 2.17 W • battery"
# The kernel's cycle count is the whole count since the buckets were restored (patch 0007); the status must not
# add a leftover offset on top of it (it showed 229 for a real 115).
if grep -q 'cycle-offset' "$script"; then echo "FAIL: hanoip-status still adds a cycle offset" >&2; exit 1; fi
echo 120 > "$b/cycle_count"
state "Not charging" 0 0 0 1
expect "cycles are the kernel's count as it is" "$(line 7)" "Battery - 81 % | 4.33 V | 120 cycles | 31.6 °C"

# The mainline kernel (7.3): the gauge is qcom_qg and the cable shows on the PM6150 charger supply, the GPU is a devfreq
# device, the thermal zones are named *-thermal, there is no kgsl, no cycle count, no quiet_therm and no ROM sensor; the
# charge limit's state is the file hanoip-ml-charge keeps. Every line must still come out, with n/a where there is no figure.
m=$dir/ml
mkdir -p "$m/class/net/eth0/statistics" "$m/class/power_supply/qcom_qg" "$m/class/power_supply/hanoip-pm6150-monitor-charger" \
	"$m/class/devfreq/5000000.gpu" "$m/devices/system/cpu/cpufreq/policy0" "$m/devices/system/cpu/cpufreq/policy6"
echo 0 > "$m/class/net/eth0/statistics/rx_bytes"; echo 0 > "$m/class/net/eth0/statistics/tx_bytes"
echo 300000 > "$m/devices/system/cpu/cpufreq/policy0/scaling_cur_freq"; echo 2304000 > "$m/devices/system/cpu/cpufreq/policy6/scaling_cur_freq"
echo 0 > "$m/class/devfreq/5000000.gpu/cur_freq"
n=0
for z in cpu0-thermal:38800 cpu7-thermal:42400 gpuss0-thermal:36200 ddr-thermal:36200 pm6150-thermal:34375; do
	mkdir -p "$m/class/thermal/thermal_zone$n"; echo "${z%%:*}" > "$m/class/thermal/thermal_zone$n/type"; echo "${z##*:}" > "$m/class/thermal/thermal_zone$n/temp"; n=$((n + 1))
done
q=$m/class/power_supply/qcom_qg c=$m/class/power_supply/hanoip-pm6150-monitor-charger
echo 69 > "$q/capacity"; echo 4114236 > "$q/voltage_now"; echo 283 > "$q/temp"; echo -40283 > "$q/current_now"; echo "Not charging" > "$q/status"
echo 1 > "$c/online"; echo 4998256 > "$c/voltage_now"; echo 492755 > "$c/current_now"
echo off > "$dir/ml.state"
mlstatus() { HANOIP_SYS_DIR=$m HANOIP_ML_STATE=$dir/ml.state sh "$script" | sed -n "${1}p"; }
expect "mainline: ten lines" "$(HANOIP_SYS_DIR=$m HANOIP_ML_STATE=$dir/ml.state sh "$script" | wc -l)" "10"
expect "mainline: cpu sensors" "$(mlstatus 3 | cut -d'|' -f2-)" " 300-2304 MHz | 42.4 °C"
expect "mainline: gpu has no busy figure, clock 0 is off" "$(mlstatus 4)" "GPU - n/a | 0 MHz | 36.2 °C | off"
expect "mainline: ram temperature" "$(mlstatus 5 | awk -F' [|] ' '{print $NF}')" "36.2 °C"
expect "mainline: no rom sensor" "$(mlstatus 6 | awk -F' [|] ' '{print $NF}')" "n/a °C"
expect "mainline: battery from qcom_qg" "$(mlstatus 7)" "Battery - 69 % | 4.11 V | n/a cycles | 28.3 °C"
expect "mainline: bypass when the limit stopped charging on the cable" "$(mlstatus 8)" "0.17 W | not charging • bypass"
expect "mainline: cable power" "$(mlstatus 9)" "Energy drain - 2.46 W • cable"
expect "mainline: body from pm6150" "$(mlstatus 10)" "Body - 34.4 °C"
echo on > "$dir/ml.state"; echo Charging > "$q/status"
expect "mainline: charging while the limit lets it" "$(mlstatus 8)" "0.17 W | charging"
echo "status: all checks pass"

# A resolv.conf that points at Tailscale's MagicDNS is the start of the DNS loop (docs/HOMELAB.md): warn in an 11th line.
# A normal one adds nothing, so the ten lines -h describes stay ten.
printf 'nameserver 192.168.10.1\n' > "$dir/resolv.conf"
expect "no warning with the router's DNS" "$(HANOIP_RESOLV_CONF=$dir/resolv.conf sh "$script" | wc -l)" "10"
printf 'nameserver 100.100.100.100\n' > "$dir/resolv.conf"
w=$(HANOIP_RESOLV_CONF=$dir/resolv.conf sh "$script")
expect "warning with MagicDNS" "$(echo "$w" | wc -l)" "11"
expect "warning text" "$(echo "$w" | sed -n 11p)" "Warning - resolv.conf uses Tailscale's DNS (100.100.100.100): tailscale set --accept-dns=false, then resolvconf -u"
expect "warning is explained by -h" "$(sh "$script" -h | grep -c '^Warning')" "1"
