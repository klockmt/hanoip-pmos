#!/bin/sh
# Reboots the running device straight into the bootloader (fastboot) without using the buttons.
# busybox/openrc reboot takes no argument; hanoip-reboot-bootloader (in the device package) calls reboot(RESTART2, "bootloader").
# Root through hanoip-sudo. DRY_RUN=1 only prints.
set -eu
dir=$(dirname "$0")
cmd=hanoip-reboot-bootloader
if [ -n "${DRY_RUN:-}" ]; then
	echo "+ hanoip-sudo '$cmd'"
	echo "+ wait up to 120 s for fastboot to list the device"
	exit 0
fi
"$dir/hanoip-sudo" "$cmd" || true
i=0
until fastboot devices | grep -q .; do
	i=$((i + 1))
	[ $i -le 60 ] || { echo "fastboot did not show up within 120 s" >&2; exit 1; }
	sleep 2
done
echo "Device in fastboot."
