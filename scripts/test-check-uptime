#!/bin/sh
# Checks scripts/check-uptime without the phone: a stand-in for the SSH helper answers the uptime and the count of hub and
# disk events (issue #28) in the kernel log, and the gate must pass only after 24 h with no such event.
set -eu
cd "$(dirname "$0")/.."
fail() { echo "FAIL: $*" >&2; exit 1; }
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cat > "$tmp/ssh" <<'EOF'
#!/bin/sh
case "$1" in
*/proc/uptime*) echo "${FAKE_UP:-0}" ;;
*journalctl*) echo "${FAKE_EVENTS:-0}" ;;
esac
EOF
chmod +x "$tmp/ssh"
gate() { HANOIP_SSH=$tmp/ssh sh scripts/check-uptime >/dev/null 2>&1; }
FAKE_UP=90000 FAKE_EVENTS=0 gate || fail "25 h up with no hub or disk event did not pass"
! FAKE_UP=3600 FAKE_EVENTS=0 gate || fail "1 h up passed the 24 h gate"
! FAKE_UP=90000 FAKE_EVENTS=2 gate || fail "25 h up with two hub or disk events passed (issue #28)"
! FAKE_UP= FAKE_EVENTS=0 gate || fail "no answer from the phone passed the gate"
echo "ok    test-check-uptime"
