#!/bin/sh
# Checks the kernel command line in the device package's deviceinfo, which boot-deploy copies into vendor_boot. The one
# that boots has console=ttyMSM0,115200n8 in vendor_boot; a regenerated vendor_boot with console=tty0 there left the
# phone hung with no USB (issue #21), so the command line must start with the working console.
set -eu
cd "$(dirname "$0")/.."
f=pmaports/device/testing/device-motorola-hanoip/deviceinfo
fail() { echo "FAIL: $*" >&2; exit 1; }
cmd=$(sed -n 's/^deviceinfo_kernel_cmdline="\(.*\)"$/\1/p' "$f")
[ -n "$cmd" ] || fail "no deviceinfo_kernel_cmdline in $f"
case $cmd in console=ttyMSM0,115200n8\ *) ;; *) fail "the command line must start with console=ttyMSM0,115200n8, got: ${cmd%% *}" ;; esac
case " $cmd " in *" console=tty0 "*) fail "console=tty0 is in the command line (never booted from vendor_boot)" ;; esac
for a in hanoip_splashfb.screen_off=1 ignore_loglevel lpm_levels.sleep_disabled=1 loop.max_part=7; do
	case " $cmd " in *" $a "*) ;; *) fail "$a is missing from the command line" ;; esac
done
# Issue #21 is explained (console=tty0) and the images boot-deploy makes from this file boot on the phone, so a package
# update flashes them again. The check above is what keeps that safe: a command line that does not start with the
# working console must never reach a flash.
grep -qx 'deviceinfo_flash_kernel_on_update="true"' "$f" || fail "deviceinfo_flash_kernel_on_update must be \"true\""

# Mainline overrides (EFI path, Duranium): no boot.img, no flash on update, DTB from mainline package, cmdline with panic=5
for v in dtb kernel_cmdline generate_bootimg flash_kernel_on_update; do
	grep -q "^deviceinfo_${v}_mainline=" "$f" || fail "deviceinfo_${v}_mainline is missing"
done
case $(sed -n 's/^deviceinfo_dtb_mainline="\(.*\)"$/\1/p' "$f") in qcom/sm7150-motorola-hanoip) ;; *) fail "deviceinfo_dtb_mainline is not qcom/sm7150-motorola-hanoip" ;; esac
case $(sed -n 's/^deviceinfo_kernel_cmdline_mainline="\(.*\)"$/\1/p' "$f") in console=ttyMSM0,115200n8\ *panic=5*) ;; *) fail "deviceinfo_kernel_cmdline_mainline must start with console=ttyMSM0,115200n8 and contain panic=5" ;; esac
[ "$(sed -n 's/^deviceinfo_generate_bootimg_mainline="\(.*\)"$/\1/p' "$f")" = "false" ] || fail "deviceinfo_generate_bootimg_mainline must be false"
[ "$(sed -n 's/^deviceinfo_flash_kernel_on_update_mainline="\(.*\)"$/\1/p' "$f")" = "false" ] || fail "deviceinfo_flash_kernel_on_update_mainline must be false"

echo "deviceinfo: ok"
