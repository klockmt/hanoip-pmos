#!/bin/sh
# Builds Linux 7.3 for the hanoip: kernel.org's linux-7.3 plus the 195 patches in kernel/mainline/patches, with
# kernel/mainline/config-7.3-hanoip plus kernel/mainline/server.config, and the out-of-tree hanoip_mmi_unit_info
# module (kernel/mainline/extra). Nothing touches the phone.
# Usage: scripts/build-mainline-kernel   (tree in $HANOIP_MAINLINE_DIR, default $HANOIP_SRC_DIR/hanoip-mainline-7.3)
# Out: $HANOIP_MAINLINE_DIR/out/ Image.gz, kernel.dtb, modules-<release>.tar.gz, config, SHA256SUMS.
# The source tree is checked twice: tag v7.3's git tree before the patches, the validated tree after them.
set -eu
. "$(dirname "$0")/env.sh"
k=${HANOIP_MAINLINE_DIR:-$HANOIP_SRC_DIR/hanoip-mainline-7.3}
BASE_TREE=30fd2ef82912c26cf3a58ad0ba6afc375fa851ac # git tree of tag v7.3
TREE=398868f4629ed0d0e211f575957adaf24450eded      # v7.3 + kernel/mainline/patches (0127 with dr_mode otg): not booted yet, the tree that booted was 0cf5808c
KORG=https://cdn.kernel.org/pub/linux/kernel/v7.x
GIT="git -c user.name=hanoip -c user.email=hanoip@localhost -c core.autocrlf=false"
ml=$HANOIP_ROOT/kernel/mainline
frag=$ml/server.config
# The banner must not carry this PC's user or host name.
export KBUILD_BUILD_USER=hanoip KBUILD_BUILD_HOST=hanoip-build
MAKE="make -C $k/linux O=$k/obj ARCH=arm64 CROSS_COMPILE=${CROSS_COMPILE:-aarch64-linux-gnu-} LOCALVERSION="

mkdir -p "$k/dl"
cd "$k/dl"
[ -s linux-7.3.tar.xz ] || curl -fL --retry 3 -o linux-7.3.tar.xz "$KORG/linux-7.3.tar.xz"
[ -s sha256sums.asc ] || curl -fL --retry 3 -o sha256sums.asc "$KORG/sha256sums.asc"
grep ' linux-7\.3\.tar\.xz$' sha256sums.asc | sha256sum -c -

[ "$(ls "$ml"/patches/*.patch | wc -l)" -eq 195 ] || { echo "expected 195 patches in $ml/patches" >&2; exit 1; }

cd "$k"
if [ ! -d linux/.git ]; then
	rm -rf linux linux-7.3
	tar -xf dl/linux-7.3.tar.xz && mv linux-7.3 linux
	(cd linux && $GIT init -q && $GIT add -A -f . && $GIT commit -q -m "v7.3 (linux-7.3.tar.xz)" && $GIT tag base)
fi
cd linux
got=$(git rev-parse base^{tree})
[ "$got" = $BASE_TREE ] || { echo "base tree $got is not tag v7.3 ($BASE_TREE)" >&2; exit 1; }
$GIT reset -q --hard base
ls "$ml"/patches/*.patch | LC_ALL=C sort | xargs $GIT am -q
got=$(git rev-parse HEAD^{tree})
[ "$got" = $TREE ] || { echo "patched tree $got is not the one that booted ($TREE)" >&2; exit 1; }
echo "source tree OK ($TREE)"

mkdir -p "$k/obj" "$k/out"
ARCH=arm64 scripts/kconfig/merge_config.sh -m -O "$k/obj" "$ml/config-7.3-hanoip" "$frag" >/dev/null
$MAKE olddefconfig >/dev/null
grep '^CONFIG_' "$frag" | while read -r opt; do
	grep -qx "$opt" "$k/obj/.config" || { echo "$opt did not survive olddefconfig" >&2; exit 1; }
done
nice -n 10 $MAKE -j"$(nproc)" Image modules qcom/sm7150-motorola-hanoip.dtb
rm -rf "$k/extra" && cp -a "$ml/extra" "$k/extra"
$MAKE M="$k/extra" modules
krel=$(cat "$k/obj/include/config/kernel.release")
rm -rf "$k/mod"
$MAKE INSTALL_MOD_PATH="$k/mod" INSTALL_MOD_STRIP=1 DEPMOD=true modules_install >/dev/null
m=$k/mod/lib/modules/$krel
rm -f "$m/build" "$m/source"
mkdir -p "$m/extra"
"${CROSS_COMPILE:-aarch64-linux-gnu-}strip" --strip-debug -o "$m/extra/hanoip_mmi_unit_info.ko" "$k/extra/hanoip_mmi_unit_info.ko"
depmod -b "$k/mod" "$krel"
gzip -9n -c "$k/obj/arch/arm64/boot/Image" > "$k/out/Image.gz"
cp "$k/obj/arch/arm64/boot/dts/qcom/sm7150-motorola-hanoip.dtb" "$k/out/kernel.dtb"
cp "$k/obj/.config" "$k/out/config"
tar -C "$k/mod/lib/modules" --owner=0 --group=0 --sort=name --mtime=@0 -czf "$k/out/modules-$krel.tar.gz" "$krel"
(cd "$k/out" && sha256sum Image.gz kernel.dtb "modules-$krel.tar.gz" > SHA256SUMS)
strings "$k/obj/arch/arm64/boot/Image" | grep -m1 "Linux version"
echo "built $krel in $k/out"
