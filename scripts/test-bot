#!/bin/sh
# Checks hanoip-bot without Telegram or the phone. The unit tests inside hanoip-bot.rs (rustc --test) cover the
# commands, who is answered, the watch schedule, the status runner, the JSON reader and the curl config. This script
# then builds the real binary and runs it against a fake Telegram on localhost, with the real curl: the text arrives
# byte for byte (quotes, newlines, accents), the token never shows in curl's arguments, a stranger is ignored, the
# owner's /up and /notes are answered, and a network error does not print the token.
set -eu
cd "$(dirname "$0")/.."
src=pmaports/device/testing/device-motorola-hanoip/hanoip-bot.rs
tmp=$(mktemp -d)
srv= bot=
trap '[ -z "$srv" ] || kill "$srv" 2>/dev/null; [ -z "$bot" ] || kill "$bot" 2>/dev/null; rm -rf "$tmp"' EXIT
fail() { echo "FAIL: $*" >&2; exit 1; }

rustc --edition 2021 --test -o "$tmp/unit" "$src"
"$tmp/unit" -q
rustc --edition 2021 -o "$tmp/bot" "$src"

cat > "$tmp/server.py" <<'PY'
import json, sys, time, urllib.parse
from http.server import BaseHTTPRequestHandler, HTTPServer
tmp = sys.argv[1]
state = {"polls": 0}
class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def do_POST(self):
        body = self.rfile.read(int(self.headers.get("Content-Length", 0))).decode()
        form = {k: v[0] for k, v in urllib.parse.parse_qs(body, keep_blank_values=True).items()}
        method = self.path.rsplit("/", 1)[-1]
        with open(tmp + "/requests.log", "a") as f:
            f.write(json.dumps({"path": self.path, "method": method, "form": form}, ensure_ascii=False) + "\n")
        result = {}
        if method == "getUpdates":
            state["polls"] += 1
            if state["polls"] == 1:
                msg = lambda uid, who, text: {"update_id": uid, "message": {"from": {"id": who}, "chat": {"id": who}, "text": text}}
                result = [msg(10, 99, "/up"), msg(11, 1234, "/up"), {"update_id": 12, "edited_message": {}}, msg(13, 1234, "/notes")]
            else:
                time.sleep(0.2)
                result = []
        out = json.dumps({"ok": True, "result": result}).encode()
        self.send_response(200); self.send_header("Content-Length", str(len(out))); self.end_headers(); self.wfile.write(out)
srv = HTTPServer(("127.0.0.1", 0), H)
open(tmp + "/port", "w").write(str(srv.server_port))
srv.serve_forever()
PY
python3 -I "$tmp/server.py" "$tmp" &
srv=$!
i=0; while [ ! -s "$tmp/port" ]; do i=$((i + 1)); [ $i -lt 50 ] || fail "the fake Telegram did not start"; sleep 0.1; done
port=$(cat "$tmp/port")
printf 'TOKEN=123:SECRETTOKEN\nOWNER_ID=1234\n' > "$tmp/telegram.env"
# curl through a wrapper that records the arguments it gets
printf '#!/bin/sh\necho "$*" >> "%s/curl-args.log"\nexec curl "$@"\n' "$tmp" > "$tmp/curlwrap"
chmod +x "$tmp/curlwrap"
export HANOIP_BOT_ENV=$tmp/telegram.env HANOIP_API=http://127.0.0.1:$port HANOIP_CURL=$tmp/curlwrap

# 1. --alert: the text arrives intact
text=$(printf 'linha "1" com \\ barra\nlinha 2 ação ✓')
"$tmp/bot" --alert "$text"
python3 -I - "$tmp" "$text" <<'PY' || fail "the alert did not arrive intact"
import json, sys
tmp, text = sys.argv[1], sys.argv[2]
reqs = [json.loads(l) for l in open(tmp + "/requests.log")]
sent = [r for r in reqs if r["method"] == "sendMessage"]
assert len(sent) == 1, reqs
assert sent[0]["path"] == "/bot123:SECRETTOKEN/sendMessage", sent[0]["path"]
assert sent[0]["form"] == {"chat_id": "1234", "text": text}, sent[0]["form"]
PY
[ "$(cat "$tmp/curl-args.log")" = "-K -" ] || fail "curl got arguments other than -K -: $(cat "$tmp/curl-args.log")"
! grep -q SECRET "$tmp/curl-args.log" || fail "the token showed in curl's arguments"

# 2. the polling loop: a stranger's /up is ignored, the owner's is answered, an update without message is skipped
: > "$tmp/requests.log"
"$tmp/bot" 2> "$tmp/bot.err" &
bot=$!
i=0; while [ "$(grep -c '"sendMessage"' "$tmp/requests.log")" -lt 2 ]; do i=$((i + 1)); [ $i -lt 100 ] || fail "the bot did not answer /up"; sleep 0.1; done
sleep 0.5
kill "$bot" 2>/dev/null || true; wait "$bot" 2>/dev/null || true; bot=
python3 -I - "$tmp" <<'PY' || fail "the polling loop did something else than expected"
import json, sys
reqs = [json.loads(l) for l in open(sys.argv[1] + "/requests.log")]
sent = [r["form"] for r in reqs if r["method"] == "sendMessage"]
assert len(sent) == 2, sent
assert sent[0] == {"chat_id": "1234", "text": "de pé"}, sent[0]
assert sent[1]["chat_id"] == "1234" and sent[1]["text"].startswith("comandos do hanoip-bot:\n/up - "), sent[1]
for cmd in ("/status -h", "/status -t=MIN -g=MIN", "/stop", "/notes", "está de pé", "só neste chat"):
    assert cmd in sent[1]["text"], (cmd, sent[1]["text"])    # accents and newlines arrive intact through curl
polls = [r["form"] for r in reqs if r["method"] == "getUpdates"]
assert polls[0]["offset"] == "0" and polls[1]["offset"] == "14", polls[:2]   # past update 13; 12 had no message
PY
! grep -q SECRET "$tmp/bot.err" || fail "the token showed in the bot's error output"

# 3. a network error is reported without the token, and the bot keeps going
kill "$srv"; wait "$srv" 2>/dev/null || true; srv=
timeout 3 "$tmp/bot" 2> "$tmp/down.err" || true
grep -q "getUpdates failed" "$tmp/down.err" || fail "no error line when the network is down"
! grep -q SECRET "$tmp/down.err" || fail "the token showed in the error line"

# 4. without telegram.env (a fresh install) the service refuses to start, instead of panicking every 5 s
initd=pmaports/device/testing/device-motorola-hanoip/hanoip-bot.initd
pre() { HANOIP_BOT_ENV=$1 sh -c '. "$1"; eerror() { :; }; start_pre' sh "$initd" 2>/dev/null; }
! pre "$tmp/none" || fail "the service starts without telegram.env"
pre "$tmp/telegram.env" || fail "the service refuses to start with telegram.env"
# The systemd unit (Duranium and the mainline root) needs the same guard: Restart=always would panic every 5 s with no env file.
unit=pmaports/device/testing/device-motorola-hanoip/hanoip-bot.service
grep -qx 'ConditionPathExists=/etc/hanoip/telegram.env' "$unit" || fail "$unit starts without telegram.env"
cmp -s "$unit" kernel/mainline/root-overlay/etc/systemd/system/hanoip-bot.service || fail "the unit differs from the root overlay's copy"
echo "bot: all checks pass"
