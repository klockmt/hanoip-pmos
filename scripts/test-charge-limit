#!/bin/sh
# Checks hanoip-charge-limit against a fake battery directory (no hardware needed). Each step runs
# one pass of the loop (the timeout stops it before the 30 s sleep ends) with the given capacity and
# charger state, and checks the charger state and the saved state afterwards ("cycles cut unlock").
set -eu
cd "$(dirname "$0")/.."
script=pmaports/device/testing/device-motorola-hanoip/hanoip-charge-limit
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
bat=$dir/bat
mkdir "$bat"
usb=$dir/usb
mkdir "$usb"
echo 1 > "$usb/present"
echo 0 > "$bat/input_suspend"
main=$dir/main
mkdir "$main"
echo 2210000 > "$usb/hw_current_max"
echo 4000000 > "$bat/voltage_now"
gauge=$dir/qgd.soc
export HANOIP_BATTERY_DIR=$bat HANOIP_USB_DIR=$usb HANOIP_CHARGE_STATE=$dir/state HANOIP_CHARGE_CYCLES=3
export HANOIP_QGD_STATE=$gauge HANOIP_MAIN_DIR=$main HANOIP_THERMAL_FLAG=$dir/hot

# step <capacity> <charging_enabled now> <charging_enabled expected> <state expected>
# The gauge counts as just updated, unless stale=1 (then its file is missing).
step() {
	echo "$1" > "$bat/capacity"
	echo "$2" > "$bat/charging_enabled"
	if [ "${stale:-0}" = 1 ]; then rm -f "$gauge"; else touch "$gauge"; fi
	timeout -s KILL 1 sh "$script" >/dev/null 2>&1 || true
	got=$(cat "$bat/charging_enabled")
	saved=$(cat "$dir/state" 2>/dev/null || echo none)
	if [ "$got" != "$3" ] || [ "$saved" != "$4" ]; then
		echo "FAIL: capacity $1, charging $2: charging $got (expected $3), state '$saved' (expected '$4')" >&2
		exit 1
	fi
	# Turning the charger back on also clears input_suspend. (A cut sets it only when it drains: see hold().)
	if [ "$got" != "$2" ] && [ "$got" = 1 ] && [ "$(cat "$bat/input_suspend")" != 0 ]; then
		echo "FAIL: capacity $1: input_suspend not cleared with charging $got" >&2
		exit 1
	fi
}

step 80 1 1 none # 80 exactly: keep charging
step 60 0 0 none # 60 exactly: stay off
echo 0 > "$usb/present"
step 85 1 1 none # no charger connected: nothing to cut
echo 1 > "$usb/present"
step 85 1 0 "0 1 0" # boot with the charger on above 80: cut, not a cycle yet
step 59 0 1 "1 0 0" # resume below 60 completes the first cycle
step 85 1 0 "1 1 0"
step 59 0 1 "2 0 0"
step 85 1 0 "2 1 0"
step 59 0 1 "3 0 1" # third cycle: the next charge is unlocked
step 90 1 1 "3 0 1" # unlocked: no cut above 80
step 100 0 0 "0 0 0" # full: the count starts again
step 85 1 0 "0 1 0" # normal limit back after the unlocked charge

# The count survives a restart (what a reboot does): the script resumes from the saved state.
echo "2 1 0" > "$dir/state"
step 59 0 1 "3 0 1"

# Safety: a gauge that stopped updating resumes charging under a cut, clears the cut without counting
# a cycle, and blocks new cuts (regression of 2026-10-26: the percentage froze and the battery drained).
echo "0 1 0" > "$dir/state"; echo 1 > "$bat/input_suspend"
stale=1
step 70 0 1 "0 0 0"
step 85 1 1 "0 0 0"
stale=0
# A low battery voltage under a cut resumes charging whatever the percentage says.
echo "0 1 0" > "$dir/state"; echo 1 > "$bat/input_suspend"; echo 3700000 > "$bat/voltage_now"
step 70 0 1 "0 0 0"
echo 4000000 > "$bat/voltage_now"
# A fresh gauge and a normal voltage keep the cut between the limits.
echo "0 1 0" > "$dir/state"; echo 1 > "$bat/input_suspend"
step 70 0 0 "0 1 0"

# Full on the cable: the charger reads 0 after a finished charge, but the cable still has to go, or
# the phone sits at 100 % on it instead of cycling between 60 and 80 %.
echo "0 0 0" > "$dir/state"; echo 0 > "$bat/input_suspend"
step 100 0 0 "0 1 0"
[ "$(cat "$bat/input_suspend")" = 1 ] || { echo "FAIL: Full on the cable did not suspend the cable" >&2; exit 1; }
# Already suspended above 80 %: no second cut.
step 90 0 0 "0 1 0"

# The input current is held at 1.1 A while the cable charges, and released before every cut: the override
# beats the input_suspend vote, so a cut with the override still on would not stop the cable.
icl_is() { [ "$(cat "$main/force_main_icl")" = "$1" ] || { echo "FAIL: $2: force_main_icl is $(cat "$main/force_main_icl"), expected $1" >&2; exit 1; }; }
echo 0 > "$bat/input_suspend"; echo "0 0 0" > "$dir/state"
step 70 1 1 "0 0 0"; icl_is 1100000 "charging on the cable"
step 85 1 0 "0 1 0"; icl_is -1 "cut above 80 %"
echo 0 > "$bat/input_suspend"; echo 500000 > "$usb/hw_current_max"
step 70 1 1 "0 1 0"; icl_is -1 "a 0.5 A source is not raised to 1.1 A"
echo 2210000 > "$usb/hw_current_max"

# Too warm: the charger and the cable are cut, the cycle state is untouched, and the cut is lifted once the
# flag is gone. A limit cut stays in place when it cools down. A stale flag (hanoip-thermal died) and a
# battery under the floor do not hold the charge back.
echo 0 > "$bat/input_suspend"; echo "0 0 0" > "$dir/state"; rm -f "$dir/state.heat"
touch "$dir/hot"
step 70 1 0 "0 0 0"; icl_is -1 "hot"
[ "$(cat "$bat/input_suspend")" = 1 ] || { echo "FAIL: hot did not suspend the cable" >&2; exit 1; }
rm "$dir/hot"
step 70 0 1 "0 0 0"; icl_is 1100000 "cooled down"
echo "0 1 0" > "$dir/state"; touch "$dir/hot"; step 70 0 0 "0 1 0"; rm "$dir/hot"
step 70 0 0 "0 1 0" # cooled down under a limit cut: still cut
echo 0 > "$bat/input_suspend"; echo "0 0 0" > "$dir/state"; rm -f "$dir/state.heat"
touch -d '10 minutes ago' "$dir/hot"; step 70 1 1 "0 0 0"; rm "$dir/hot"
touch "$dir/hot"; echo 3700000 > "$bat/voltage_now"; step 70 1 1 "0 0 0"; rm "$dir/hot"
echo 4000000 > "$bat/voltage_now"

# Bypass: at the limit the charger is stopped but the cable stays on, so it feeds the phone and the battery
# keeps its level (measured 2026-10-29: 0 uA with charging_enabled=0 and input_suspend=0). Within SLACK
# (2 %) above HI it holds right away. Further above (a finished charge, for example) the cable is suspended
# to drain the battery down to that band first, and then the hold starts.
hold() { [ "$(cat "$bat/input_suspend")" = "$1" ] || { echo "FAIL: $2: input_suspend is $(cat "$bat/input_suspend"), expected $1" >&2; exit 1; }; }
echo 0 > "$bat/input_suspend"; echo "0 0 0" > "$dir/state"
step 81 1 0 "0 1 0"; hold 0 "81 % holds on the cable"; icl_is -1 "hold releases the input limit"
step 82 0 0 "0 1 0"; hold 0 "already holding"
step 70 0 0 "0 1 0"; hold 0 "holding between the limits"
echo 0 > "$bat/input_suspend"; echo "0 0 0" > "$dir/state"
step 83 1 0 "0 1 0"; hold 1 "83 % drains first"
step 84 0 0 "0 1 0"; hold 1 "still draining above the band"
echo 82 > "$bat/capacity"; step 82 0 0 "0 1 0"; hold 0 "drained down to the band: hold"
step 59 0 1 "1 0 0"; hold 0 "below LO the charge comes back"
echo 0 > "$bat/input_suspend"; echo "0 0 0" > "$dir/state"
step 100 0 0 "0 1 0"; hold 1 "Full above the band drains"

# While holding on the cable the battery does not move and the kernel sends the gauge no samples (the file
# stood still for 7 minutes on the phone), so a quiet gauge must not restart the charge there. It still does
# with the cable suspended (a drain) and without a cable.
echo 0 > "$bat/input_suspend"; echo "0 1 0" > "$dir/state"; stale=1
step 81 0 0 "0 1 0"; hold 0 "quiet gauge while holding"
echo 0 > "$usb/present"; step 81 0 1 "0 0 0"; echo 1 > "$usb/present"
echo "0 1 0" > "$dir/state"; echo 1 > "$bat/input_suspend"; step 81 0 1 "0 0 0"
stale=0

# Stopping the service (TERM) turns the charger back on, even while it is cut.
echo 85 > "$bat/capacity"; echo 1 > "$bat/charging_enabled"; touch "$gauge"
timeout -s TERM 1 sh "$script" >/dev/null 2>&1 || true
[ "$(cat "$bat/charging_enabled")" = 1 ] && [ "$(cat "$bat/input_suspend")" = 0 ] && [ "$(cat "$main/force_main_icl")" = -1 ] || { echo "FAIL: charger still cut or cable suspended after TERM" >&2; exit 1; }
echo "charge limit: all steps pass"
