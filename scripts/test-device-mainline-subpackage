#!/bin/sh
# Checks the device-motorola-hanoip mainline subpackage:
# - every local source= entry is tracked by git (URLs and name::url are ignored)
# - each hanoip-ml-* / hanoip-*.start file matches kernel/mainline/root-overlay byte-for-byte
# - the 13 mainline files are installed by package() and moved by mainline() amove (not in modem/ kernel subpackages)
set -eu
cd "$(dirname "$0")/.."

apk="pmaports/device/testing/device-motorola-hanoip/APKBUILD"
d=$(dirname "$apk")
root_overlay="kernel/mainline/root-overlay"
fail=0

# --- 1. Collect local sources from source= (skip URLs and name::url) ---
local_sources=$(set +u; srcdir=; . "./$apk"; for s in $source; do
    case $s in
        *://*) ;;                          # skip URLs
        *::*) ;;                           # skip name::url
        *) echo "${s##*/}" ;;
    esac
done)

# Verify each local source is tracked by git
for f in $local_sources; do
    [ -z "$f" ] && continue
    if ! git ls-files --error-unmatch "$d/$f" >/dev/null 2>&1; then
        echo "FAIL: $d/$f is in source= but not tracked by git" >&2
        fail=1
    fi
done
[ $fail -eq 0 ] || exit 1
echo "git-tracked sources: ok"

# --- 2. List of 13 mainline files expected in root-overlay ---
# Map: root-overlay path -> device package filename
mainline_files="
etc/init.d/hanoip-ml-modem:hanoip-ml-modem.initd
etc/init.d/hanoip-ml-charge:hanoip-ml-charge.initd
etc/local.d/05-hanoip-ml-guard.start:hanoip-ml-guard.start
etc/local.d/10-hanoip-usb.start:hanoip-usb.start
etc/local.d/20-hanoip-deadman.start:hanoip-deadman.start
etc/local.d/30-hanoip-battery.start:hanoip-battery.start
etc/local.d/98-hanoip-ml-slot.start:hanoip-ml-slot.start
etc/local.d/99-hanoip-ml-up.start:hanoip-ml-up.start
etc/modprobe.d/hanoip-ml.conf:hanoip-ml.conf
etc/NetworkManager/conf.d/hanoip-ml.conf:hanoip-ml-networkmanager.conf
etc/NetworkManager/dispatcher.d/50-hanoip-ml-chrony:hanoip-ml-chrony
usr/bin/hanoip-ml-abl-slot:hanoip-ml-abl-slot
usr/bin/hanoip-ml-charge:hanoip-ml-charge
"

# Verify each exists in root-overlay and matches the copy in device package
for line in $mainline_files; do
    [ -z "$line" ] && continue
    rel="${line%%:*}"
    pkgfile="${line##*:}"
    overlay="$root_overlay/$rel"
    pkgcopy="$d/$pkgfile"
    if [ ! -f "$overlay" ]; then
        echo "FAIL: $overlay missing from root-overlay" >&2
        fail=1
        continue
    fi
    if [ ! -f "$pkgcopy" ]; then
        echo "FAIL: $pkgcopy missing from device package" >&2
        fail=1
        continue
    fi
    if ! cmp -s "$overlay" "$pkgcopy"; then
        echo "FAIL: $pkgcopy differs from $overlay" >&2
        fail=1
    fi
done
[ $fail -eq 0 ] || exit 1
echo "byte-for-byte copies from root-overlay: ok"

# --- 3. Check package() installs all 13, and mainline() amove moves exactly those ---
# Extract the install -D lines from package() that correspond to mainline files
installed_in_package=$(sed -n '/^package()/,/^}/p' "$apk" \
    | grep -E 'install -D.*hanoip-ml|install -D.*hanoip-deadman|install -D.*hanoip-battery|install -D.*hanoip-usb' \
    | sed -E 's/.*\$pkgdir\/(.*)"/\1/' \
    | tr '\n' ' ')

# Extract amove arguments from mainline() - handle multi-line with backslashes
amove_args=$(awk '/^mainline\(\)/,/^}/' "$apk" \
    | grep -A 100 'amove' \
    | sed -E 's/.*amove\s+//' \
    | sed -E 's/\\$//' \
    | sed -E 's/[[:space:]]*}$//' \
    | tr '\n' ' ')

# Convert amove args to set of destination paths
amove_dests=""
for dest in $amove_args; do
    amove_dests="$amove_dests $dest"
done

# Check each mainline file path is installed in package()
for line in $mainline_files; do
    [ -z "$line" ] && continue
    rel="${line%%:*}"
    case " $installed_in_package " in
        *" $rel "*) ;;
        *) echo "FAIL: $rel not found in package() installs" >&2; fail=1 ;;
    esac
done

# Check each mainline file path appears in mainline() amove
for line in $mainline_files; do
    [ -z "$line" ] && continue
    rel="${line%%:*}"
    case " $amove_dests " in
        *" $rel "*) ;;
        *) echo "FAIL: $rel not found in mainline() amove" >&2; fail=1 ;;
    esac
done

# Ensure they are NOT in modem() amove
modem_amove=$(sed -n '/^modem()/,/^}/p' "$apk" | grep -E '^\s+amove' | head -1 | sed -E 's/.*amove\s+//')
for line in $mainline_files; do
    [ -z "$line" ] && continue
    rel="${line%%:*}"
    case " $modem_amove " in
        *" $rel "*) echo "FAIL: $rel incorrectly appears in modem() amove" >&2; fail=1 ;;
    esac
done

# Ensure they are NOT in kernel_mainline() or kernel_downstream() (those use devicepkg_subpackage_kernel)
# No explicit amove there, but ensure no stray install lines in package() are missing from mainline amove
# (The check above already verifies all 13 are in mainline amove)

[ $fail -eq 0 ] || exit 1
echo "package() installs + mainline() amove: ok"

echo "test-device-mainline-subpackage: all checks passed"